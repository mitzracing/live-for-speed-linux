#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly PROGRAM_NAME='lfs-linux'
(( EUID != 0 )) || { printf '%s: error: do not run per-user LFS commands as root\n' "$PROGRAM_NAME" >&2; exit 1; }
readonly DATA_DIR="${LFS_LINUX_DATA_DIR:-/usr/share/lfs-linux}"
readonly RELEASE_FILE="$DATA_DIR/release.env"
[[ -r "$RELEASE_FILE" ]] || { printf '%s: release manifest not found: %s\n' "$PROGRAM_NAME" "$RELEASE_FILE" >&2; exit 1; }
# shellcheck source=/dev/null
source "$RELEASE_FILE"

readonly STATE_ROOT="${LFS_LINUX_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/lfs-linux}"
readonly PREFIX="$STATE_ROOT/prefix"
readonly GAME_DIR="$PREFIX/drive_c/LFS"
readonly GAME_EXE="$GAME_DIR/LFS.exe"
readonly LFS_STOCK_MANIFEST="$DATA_DIR/$LFS_STOCK_MANIFEST_NAME"
readonly LFS_STOCK_SEED_MANIFEST="$DATA_DIR/$LFS_STOCK_SEED_MANIFEST_NAME"
readonly LFS_NESTED_MANIFEST="$DATA_DIR/$LFS_NESTED_MANIFEST_NAME"
readonly LFS_UPGRADE_MANIFEST="$DATA_DIR/$LFS_UPGRADE_MANIFEST_NAME"
readonly LFS_UPGRADE_SEED_MANIFEST="$DATA_DIR/$LFS_UPGRADE_SEED_MANIFEST_NAME"
readonly RUNTIME_DIR="$STATE_ROOT/runtime"
readonly PRIVATE_WINE_ROOT="$RUNTIME_DIR/wine-$WINE_RUNTIME_VERSION"
readonly PRIVATE_WINE_BIN="$PRIVATE_WINE_ROOT/usr/bin/wine"
readonly WINE_RUNTIME_MANIFEST="$DATA_DIR/$WINE_RUNTIME_MANIFEST_NAME"
readonly DXVK_DIR="$RUNTIME_DIR/dxvk-$DXVK_VERSION"
readonly DXVK_D3D11="$DXVK_DIR/x32/d3d11.dll"
readonly DXVK_DXGI="$DXVK_DIR/x32/dxgi.dll"
readonly CACHE_DIR="${LFS_LINUX_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/lfs-linux}"
readonly LOG_DIR="${LFS_LINUX_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lfs-linux}"
readonly LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/lfs-linux-${UID}"
readonly INSTALLER="$CACHE_DIR/$LFS_INSTALLER_NAME"
readonly WINE_PACKAGE="$CACHE_DIR/$WINE_PACKAGE_NAME"
readonly WINE_PACKAGE_SIGNATURE="$CACHE_DIR/$WINE_PACKAGE_SIGNATURE_NAME"
readonly WINE_SIGNING_KEY="$DATA_DIR/$WINE_SIGNING_KEY_NAME"
readonly DXVK_ARCHIVE="$CACHE_DIR/$DXVK_ARCHIVE_NAME"
readonly INSTALL_MARKER="$STATE_ROOT/install.env"
readonly LEGACY_LOCAL_GAME_MANIFEST="$STATE_ROOT/game-update.manifest"
readonly LAUNCH_SESSION="$STATE_ROOT/launch-session.env"
readonly STATE_SENTINEL="$STATE_ROOT/.managed-by-lfs-linux"
readonly GAME_BACKUP="$STATE_ROOT/.lfs-game-backup"
readonly GAME_PREDECESSOR_QUARANTINE="$STATE_ROOT/.lfs-predecessor-quarantine"
readonly GAME_RECOVERY_CONFLICT="$STATE_ROOT/migration-conflicts/interrupted-current-game-tree"
readonly DXVK_OVERRIDE='native,builtin'
readonly WINE_DLL_OVERRIDES="mscoree,mshtml=;d3d11=$DXVK_OVERRIDE;dxgi=$DXVK_OVERRIDE"
readonly -a PLAYER_OWNED_GAME_FILES=(
  cfg.txt interface_cfg.txt card_cfg.txt deb.log deb_old.log guest.txt
)
readonly -a PLAYER_OWNED_GAME_DIRS=(
  cache mods data/colours data/grids data/layout data/knw data/misc data/move
  data/mpr data/raf data/script data/setups data/settings data/shots data/skins
  data/skins_x data/skins_y data/spr data/training data/views
)
readonly -a LOCAL_UPGRADE_PLAYER_DIRS=(
  "${PLAYER_OWNED_GAME_DIRS[@]}"
)
readonly -a LOCAL_UPGRADE_MERGED_PLAYER_DIRS=(data/skins_dds)

WINE_BIN=''
WINE_SERVER=''
WINE_VERSION=''
WINE_ROOT=''
WINE_LIB_DIR=''
ACTIVE_UNPACK=''
ACTIVE_RECOVERY_SNAPSHOT=''
ACTIVE_PREDECESSOR_QUARANTINE=''
QUARANTINE_PREDECESSOR_MANIFEST=''
QUARANTINE_SOURCE_VERSION=''
ACTIVE_BASELINE_KIND='package'
ACTIVE_LFS_VERSION="$LFS_VERSION"
ACTIVE_LFS_EXE_SIZE="$LFS_EXE_SIZE"
ACTIVE_LFS_EXE_SHA256="$LFS_EXE_SHA256"
ACTIVE_LFS_STOCK_MANIFEST="$LFS_STOCK_MANIFEST"
ACTIVE_LFS_STOCK_MANIFEST_SIZE="$LFS_STOCK_MANIFEST_SIZE"
ACTIVE_LFS_STOCK_MANIFEST_SHA256="$LFS_STOCK_MANIFEST_SHA256"
ACTIVE_LFS_STOCK_MANIFEST_ENTRIES="$LFS_STOCK_MANIFEST_ENTRIES"

cleanup_active_unpack() {
  [[ -z "$ACTIVE_UNPACK" ]] || rm -rf --one-file-system "$ACTIVE_UNPACK"
}

cleanup_install_transaction() {
  cleanup_active_unpack
  if [[ "$ACTIVE_PREDECESSOR_QUARANTINE" == 'prepared' ]]; then
    rollback_predecessor_quarantine ||
      warn "could not fully restore predecessor quarantine; retained at $GAME_PREDECESSOR_QUARANTINE"
  fi
}

cleanup_active_recovery_snapshot() {
  [[ -z "$ACTIVE_RECOVERY_SNAPSHOT" ]] || rm -f -- "$ACTIVE_RECOVERY_SNAPSHOT"
}

usage() {
  cat <<'EOF'
Usage: lfs-linux <command>

Commands:
  setup         Explain downloads, ask once, install or repair, then return
  install       Install or repair directly after an explicit CLI command
  launch        Validate the installation and start Live for Speed
  recover-update  Explicitly recover an interrupted trusted in-game update
  stop          Request a clean exit, then stop only this private Wine prefix
  doctor        Check host, manifest, prefix, DXVK, game, and graphics prerequisites
  status        Show paths, versions, and process state
  update-check  Report official LFS download-page changes without modifying state
  verify-sources  Download and verify pinned LFS and DXVK release inputs
  ready         Check whether desktop first-run setup is complete
  remove        Remove runtime/prefix state after explicit confirmation
  purge-cache   Remove downloaded installer and DXVK archives
  help          Show this help

Environment:
  LFS_LINUX_STATE_DIR   Override per-user installation directory
  LFS_LINUX_CACHE_DIR   Override download cache
  LFS_LINUX_LOG_DIR     Override runtime log directory
  LFS_LINUX_WINE        Select the exact audited Wine executable
  LFS_LINUX_CONFIRM_UPDATE_RECOVERY=1  Confirm trusted update recovery
  LFS_LINUX_CONFIRM_REMOVE=1  Confirm non-interactive removal
EOF
}

note() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

launch_log_event() {
  local log="$1"
  shift
  [[ -n "$log" ]] || return 0
  printf '%s lfs-linux %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}

owner_private_regular_file() {
  local path="$1" mode
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c %u "$path")" == "$UID" ]] || return 1
  mode="$(stat -c %a "$path")"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  (( (8#$mode & 077) == 0 ))
}

open_launch_lock() {
  local lock_file="$LOCK_DIR/launch.lock" mode
  if [[ -e "$LOCK_DIR" || -L "$LOCK_DIR" ]]; then
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || die "unsafe launch lock directory: $LOCK_DIR"
  elif ! mkdir -m 0700 -- "$LOCK_DIR" 2>/dev/null; then
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || die "could not create safe launch lock directory: $LOCK_DIR"
  fi
  [[ "$(stat -c %u "$LOCK_DIR")" == "$UID" ]] || die "launch lock directory is not owned by the current user: $LOCK_DIR"
  mode="$(stat -c %a "$LOCK_DIR")"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "launch lock directory mode is invalid: $LOCK_DIR"
  (( (8#$mode & 077) == 0 )) || die "launch lock directory is accessible by other users: $LOCK_DIR"
  chmod 0700 -- "$LOCK_DIR"

  if [[ -e "$lock_file" || -L "$lock_file" ]]; then
    owner_private_regular_file "$lock_file" || die "unsafe launch lock file: $lock_file"
  elif ! (set -o noclobber; : >"$lock_file") 2>/dev/null; then
    owner_private_regular_file "$lock_file" || die "could not create safe launch lock file: $lock_file"
  fi
  chmod 0600 -- "$lock_file"
  exec 9<>"$lock_file" || die "could not open launch lock file: $lock_file"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_host_arch() {
  [[ "$(uname -m)" == 'x86_64' ]] || die "unsupported host architecture: $(uname -m); x86_64 is required"
}

require_unprivileged() {
  (( EUID != 0 )) || die 'do not run per-user LFS commands as root'
}

validate_paths() {
  local path
  for path in "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"; do
    [[ "$path" == /* ]] || die "XDG and override paths must be absolute: $path"
    [[ "$path" != '/' && "$path" != "$HOME" ]] || die "unsafe managed path: $path"
  done
}

sha256_of() {
  local output
  output="$(timeout --foreground --kill-after=10s 1800 sha256sum -- "$1")" || return 1
  awk '{print $1}' <<<"$output"
}

verify_file() {
  local label="$1" path="$2" size="$3" checksum="$4" actual_size actual_checksum
  [[ -f "$path" ]] || die "$label is missing: $path"
  actual_size="$(stat -c %s "$path")"
  [[ "$actual_size" == "$size" ]] || die "$label size drift: expected $size, found $actual_size"
  actual_checksum="$(sha256_of "$path")" || die "$label hashing failed or exceeded 1800 seconds"
  [[ "$actual_checksum" == "$checksum" ]] || die "$label checksum drift: expected $checksum, found $actual_checksum"
}

file_matches() {
  local path="$1" expected_size="$2" expected_hash="$3"
  [[ -f "$path" ]] || return 1
  [[ "$(stat -c %s "$path")" == "$expected_size" ]] || return 1
  [[ "$(sha256_of "$path")" == "$expected_hash" ]]
}

use_packaged_game_baseline() {
  ACTIVE_BASELINE_KIND='package'
  ACTIVE_LFS_VERSION="$LFS_VERSION"
  ACTIVE_LFS_EXE_SIZE="$LFS_EXE_SIZE"
  ACTIVE_LFS_EXE_SHA256="$LFS_EXE_SHA256"
  ACTIVE_LFS_STOCK_MANIFEST="$LFS_STOCK_MANIFEST"
  ACTIVE_LFS_STOCK_MANIFEST_SIZE="$LFS_STOCK_MANIFEST_SIZE"
  ACTIVE_LFS_STOCK_MANIFEST_SHA256="$LFS_STOCK_MANIFEST_SHA256"
  ACTIVE_LFS_STOCK_MANIFEST_ENTRIES="$LFS_STOCK_MANIFEST_ENTRIES"
}

metadata_value() {
  local file="$1" key="$2" prefix line value
  local -a matches=()
  prefix="${key}='"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == "$prefix"* && "$line" == *"'" ]] && matches+=("$line")
  done <"$file"
  (( ${#matches[@]} == 1 )) || return 1
  line="${matches[0]}"
  value="${line#"$prefix"}"
  value="${value%"'"}"
  [[ -n "$value" && "$value" != *"'"* && "$value" != *$'\t'* && "$value" != *$'\n'* ]] || return 1
  printf '%s\n' "$value"
}

marker_value() {
  metadata_value "$INSTALL_MARKER" "$1"
}

load_active_game_baseline() {
  local kind version exe_size exe_hash manifest_name manifest_path manifest_size manifest_hash manifest_entries
  use_packaged_game_baseline
  [[ -f "$INSTALL_MARKER" ]] || return 1
  kind="$(marker_value LFS_BASELINE_KIND 2>/dev/null || true)"
  [[ -n "$kind" ]] || return 0
  case "$kind" in
    package) return 0 ;;
    game-update) ;;
    *) return 1 ;;
  esac
  version="$(marker_value LFS_VERSION)" || return 1
  exe_size="$(marker_value LFS_EXE_SIZE)" || return 1
  exe_hash="$(marker_value LFS_EXE_SHA256)" || return 1
  manifest_size="$(marker_value LFS_STOCK_MANIFEST_SIZE)" || return 1
  manifest_hash="$(marker_value LFS_STOCK_MANIFEST_SHA256)" || return 1
  manifest_entries="$(marker_value LFS_STOCK_MANIFEST_ENTRIES)" || return 1
  [[ "$version" =~ ^[0-9A-Za-z][0-9A-Za-z._-]*$ ]] || return 1
  [[ "$exe_size" =~ ^[0-9]+$ && "$exe_size" -gt 0 ]] || return 1
  [[ "$exe_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$manifest_size" =~ ^[0-9]+$ && "$manifest_size" -gt 0 ]] || return 1
  [[ "$manifest_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$manifest_entries" =~ ^[0-9]+$ && "$manifest_entries" -gt 0 ]] || return 1
  manifest_name="$(marker_value LFS_STOCK_MANIFEST_NAME 2>/dev/null || true)"
  if [[ -n "$manifest_name" ]]; then
    [[ "$manifest_name" == "game-update-$manifest_hash.manifest" ]] || return 1
    manifest_path="$STATE_ROOT/$manifest_name"
  else
    manifest_path="$LEGACY_LOCAL_GAME_MANIFEST"
  fi
  owner_private_regular_file "$manifest_path" || return 1
  manifest_metadata_is_valid "$manifest_path" "$manifest_size" "$manifest_hash" "$manifest_entries" || return 1
  ACTIVE_BASELINE_KIND='game-update'
  ACTIVE_LFS_VERSION="$version"
  ACTIVE_LFS_EXE_SIZE="$exe_size"
  ACTIVE_LFS_EXE_SHA256="$exe_hash"
  ACTIVE_LFS_STOCK_MANIFEST="$manifest_path"
  ACTIVE_LFS_STOCK_MANIFEST_SIZE="$manifest_size"
  ACTIVE_LFS_STOCK_MANIFEST_SHA256="$manifest_hash"
  ACTIVE_LFS_STOCK_MANIFEST_ENTRIES="$manifest_entries"
}

local_game_update_requires_upgrade() {
  [[ "$ACTIVE_BASELINE_KIND" == 'game-update' && \
     "$ACTIVE_LFS_VERSION" == "$LFS_LOCAL_UPDATE_UPGRADE_FROM_VERSION" && \
     "$ACTIVE_LFS_VERSION" != "$LFS_VERSION" ]]
}

active_game_marker_is_valid() {
  local manifest_name
  grep -Fqx "LFS_VERSION='$ACTIVE_LFS_VERSION'" "$INSTALL_MARKER" || return 1
  grep -Fqx "LFS_CHANNEL='$LFS_CHANNEL'" "$INSTALL_MARKER" || return 1
  grep -Fqx "LFS_EXE_SHA256='$ACTIVE_LFS_EXE_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "LFS_STOCK_MANIFEST_SHA256='$ACTIVE_LFS_STOCK_MANIFEST_SHA256'" "$INSTALL_MARKER" || return 1
  if marker_value LFS_BASELINE_KIND >/dev/null 2>&1; then
    grep -Fqx "LFS_BASELINE_KIND='$ACTIVE_BASELINE_KIND'" "$INSTALL_MARKER" || return 1
    grep -Fqx "LFS_EXE_SIZE='$ACTIVE_LFS_EXE_SIZE'" "$INSTALL_MARKER" || return 1
    grep -Fqx "LFS_STOCK_MANIFEST_SIZE='$ACTIVE_LFS_STOCK_MANIFEST_SIZE'" "$INSTALL_MARKER" || return 1
    grep -Fqx "LFS_STOCK_MANIFEST_ENTRIES='$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES'" "$INSTALL_MARKER" || return 1
    manifest_name="$(marker_value LFS_STOCK_MANIFEST_NAME 2>/dev/null || true)"
    [[ -z "$manifest_name" || "$manifest_name" == "$(basename "$ACTIVE_LFS_STOCK_MANIFEST")" ]] || return 1
  else
    [[ "$ACTIVE_BASELINE_KIND" == 'package' ]] || return 1
  fi
}

game_path_is_player_owned() {
  local relative="$1" owned
  for owned in "${PLAYER_OWNED_GAME_FILES[@]}"; do
    [[ "$relative" == "$owned" ]] && return 0
  done
  for owned in "${PLAYER_OWNED_GAME_DIRS[@]}"; do
    [[ "$relative" == "$owned/"* ]] && return 0
  done
  return 1
}

upgrade_game_path_is_player_owned() {
  local relative="$1" owned
  game_path_is_player_owned "$relative" && return 0
  for owned in "${LOCAL_UPGRADE_PLAYER_DIRS[@]}" "${LOCAL_UPGRADE_MERGED_PLAYER_DIRS[@]}"; do
    [[ "$relative" == "$owned" || "$relative" == "$owned/"* ]] && return 0
  done
  return 1
}

write_game_inventory() {
  local root="$1" output="$2" path relative type
  : >"$output"
  while IFS= read -r -d '' path; do
    relative="${path#"$root/"}"
    game_path_is_player_owned "$relative" && continue
    [[ "$relative" != *$'\t'* && "$relative" != *$'\n'* ]] || return 1
    if [[ -L "$path" ]]; then type='l'; elif [[ -f "$path" ]]; then type='f'; else continue; fi
    printf '%s\t%s\n' "$type" "$relative" >>"$output"
  done < <(find "$root" \( -type f -o -type l \) -print0 | sort -z)
}

game_inventory_matches_manifest() {
  local root="$1" manifest="$2" expected actual status=0
  expected="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-expected.XXXXXX")"
  actual="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-actual.XXXXXX")"
  awk -F '\t' '$1 == "f" || $1 == "l" { print $1 "\t" $4 }' "$manifest" >"$expected"
  write_game_inventory "$root" "$actual" || status=1
  (( status != 0 )) || cmp -s "$expected" "$actual" || status=1
  rm -f "$expected" "$actual"
  return "$status"
}

snapshot_game_manifest() {
  local root="$1" output="$2" path relative target checksum size
  {
    printf '%s\n' '# lfs-linux payload manifest v1'
    printf '%s\n' '# type<TAB>sha256-or-link-target<TAB>size-or-dash<TAB>relative-path'
    while IFS= read -r -d '' path; do
      relative="${path#"$root/"}"
      game_path_is_player_owned "$relative" && continue
      [[ "$relative" != *$'\t'* && "$relative" != *$'\n'* ]] || return 1
      if [[ -L "$path" ]]; then
        target="$(readlink -- "$path")" || return 1
        [[ "$target" != *$'\t'* && "$target" != *$'\n'* ]] || return 1
        printf 'l\t%s\t-\t%s\n' "$target" "$relative"
      elif [[ -f "$path" ]]; then
        checksum="$(sha256_of "$path")" || return 1
        size="$(stat -c %s "$path")" || return 1
        printf 'f\t%s\t%s\t%s\n' "$checksum" "$size" "$relative"
      fi
    done < <(find "$root" \( -type f -o -type l \) -print0 | sort -z)
  } >"$output"
}

game_version_marker() {
  local name
  [[ -d "$GAME_DIR/data/versions" ]] || return 0
  while IFS= read -r name; do
    name="${name%.txt}"
    [[ "$name" =~ ^[0-9]+[A-Z][0-9]*$ ]] && printf '%s\n' "$name"
  done < <(find "$GAME_DIR/data/versions" -mindepth 1 -maxdepth 1 -type f -name '*.txt' -printf '%f\n') |
    sort -V | tail -n 1
}

version_marker_advanced() {
  local before="$1" after="$2" latest
  [[ -n "$after" && "$after" != "$before" ]] || return 1
  [[ -z "$before" ]] && return 0
  latest="$(printf '%s\n%s\n' "$before" "$after" | sort -V | tail -n 1)"
  [[ "$latest" == "$after" ]]
}

payload_manifest_check() {
  local root="$1" manifest="$2" manifest_size="$3" manifest_hash="$4" expected_entries="$5" mode="${6:-full}"
  local type expected expected_size relative actual entry_count checks output
  file_matches "$manifest" "$manifest_size" "$manifest_hash" || { printf 'manifest missing or changed: %s\n' "$manifest"; return 1; }
  [[ -d "$root" ]] || { printf 'payload root missing: %s\n' "$root"; return 1; }
  entry_count="$(awk -F '\t' '$1 == "f" || $1 == "l" { count++ } END { print count + 0 }' "$manifest")"
  [[ "$entry_count" == "$expected_entries" ]] || { printf 'manifest entry-count drift: expected %s, found %s\n' "$expected_entries" "$entry_count"; return 1; }
  awk -F '\t' '($1 == "f" || $1 == "l") && ($4 == "" || $4 ~ /^\// || $4 ~ /(^|\/)\.\.(\/|$)/) { exit 1 }' "$manifest" || {
    printf 'unsafe path in payload manifest\n'
    return 1
  }
  while IFS=$'\t' read -r type expected expected_size relative; do
    case "$type" in
      f)
        [[ -f "$root/$relative" && ! -L "$root/$relative" ]] || { printf 'required stock file missing: %s\n' "$relative"; return 1; }
        ;;
      l)
        [[ -L "$root/$relative" ]] || { printf 'required runtime link missing: %s\n' "$relative"; return 1; }
        actual="$(readlink -- "$root/$relative")"
        [[ "$actual" == "$expected" ]] || { printf 'runtime link drift: %s\n' "$relative"; return 1; }
        ;;
    esac
  done <"$manifest"
  [[ "$mode" == 'layout' ]] && return
  checks="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-checks.XXXXXX")"
  awk -F '\t' '$1 == "f" { print $2 "  " $4 }' "$manifest" >"$checks"
  if ! output="$(cd "$root" && timeout --foreground --kill-after=10s 1800 sha256sum --check --quiet "$checks" 2>&1)"; then
    rm -f "$checks"
    printf '%s\n' "${output:-payload checksum drift}"
    return 1
  fi
  rm -f "$checks"
}

verify_payload_manifest() {
  local label="$1" root="$2" manifest="$3" manifest_size="$4" manifest_hash="$5" entries="$6" issue
  if ! issue="$(payload_manifest_check "$root" "$manifest" "$manifest_size" "$manifest_hash" "$entries")"; then
    die "$label drift: $issue"
  fi
}

archive_member_listing_is_safe() {
  local listing="$1" normalized duplicate
  normalized="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-archive-paths.XXXXXX")"
  if ! LC_ALL=C awk '
    function reject(reason, path) {
      printf "%s: %s\n", reason, path > "/dev/stderr"
      bad = 1
    }
    {
      path = $0
      sub(/\r$/, "", path)
      if (path == "." || path == "./") next
      if (path == "" || path ~ /[[:cntrl:]]/) {
        reject("empty or control-character archive member", path)
        next
      }
      gsub(/\\/, "/", path)
      if (path ~ /^\// || path ~ /^[[:alpha:]]:/) {
        reject("absolute archive member", path)
        next
      }
      count = split(path, part, "/")
      output = ""
      unsafe = 0
      for (i = 1; i <= count; i++) {
        if (part[i] == "" || part[i] == ".") continue
        if (part[i] == "..") {
          reject("parent traversal archive member", path)
          unsafe = 1
          break
        }
        output = output (output == "" ? "" : "/") part[i]
      }
      if (!unsafe && output != "") print output
    }
    END { if (bad) exit 1 }
  ' "$listing" >"$normalized"; then
    rm -f "$normalized"
    return 1
  fi
  if [[ ! -s "$normalized" ]]; then
    printf 'archive contains no file paths\n' >&2
    rm -f "$normalized"
    return 1
  fi
  duplicate="$(awk 'seen[$0]++ { print; exit }' "$normalized")"
  rm -f "$normalized"
  if [[ -n "$duplicate" ]]; then
    printf 'duplicate archive member: %s\n' "$duplicate" >&2
    return 1
  fi
}

bsdtar_entry_types_are_safe() {
  local verbose_listing="$1"
  LC_ALL=C awk '
    function contained_link(path, target, base, combined, count, i, depth, part) {
      if (target == "" || target ~ /[[:cntrl:]]/) return 0
      gsub(/\\/, "/", target)
      if (target ~ /^\// || target ~ /^[[:alpha:]]:/) return 0
      base = path
      if (base ~ /\//) sub(/\/[^/]*$/, "", base); else base = ""
      combined = (base == "" ? target : base "/" target)
      count = split(combined, part, "/")
      depth = 0
      for (i = 1; i <= count; i++) {
        if (part[i] == "" || part[i] == ".") continue
        if (part[i] == "..") {
          if (depth == 0) return 0
          depth--
        } else {
          depth++
        }
      }
      return 1
    }
    {
      type = substr($0, 1, 1)
      if (type != "-" && type != "d" && type != "l") {
        printf "unsupported archive entry type: %s\n", $0 > "/dev/stderr"
        bad = 1
        next
      }
      if (type != "l") next
      rest = $0
      malformed = 0
      for (field = 1; field <= 8; field++) {
        if (rest !~ /^[^[:space:]]+[[:space:]]+/) {
          printf "malformed symbolic-link listing: %s\n", $0 > "/dev/stderr"
          bad = 1
          malformed = 1
          break
        }
        sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
      }
      if (malformed) next
      pieces = split(rest, link, / -> /)
      if (pieces != 2 || !contained_link(link[1], link[2])) {
        printf "unsafe symbolic link in archive: %s\n", rest > "/dev/stderr"
        bad = 1
      }
    }
    END { if (bad) exit 1 }
  ' "$verbose_listing"
}

preflight_bsdtar_archive() {
  local archive="$1" label="$2" listing verbose_listing
  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-list.XXXXXX")"
  verbose_listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-verbose.XXXXXX")"
  if ! LC_ALL=C bsdtar -tf "$archive" >"$listing" 2>/dev/null ||
     ! archive_member_listing_is_safe "$listing" ||
     ! LC_ALL=C bsdtar -tvf "$archive" >"$verbose_listing" 2>/dev/null ||
     ! bsdtar_entry_types_are_safe "$verbose_listing"; then
    rm -f "$listing" "$verbose_listing"
    die "$label has unsafe or unreadable archive members"
  fi
  rm -f "$listing" "$verbose_listing"
}

preflight_7z_archive() {
  local archive="$1" label="$2" details listing
  details="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-details.XXXXXX")"
  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-list.XXXXXX")"
  if ! LC_ALL=C 7z l -slt -- "$archive" >"$details" 2>/dev/null; then
    rm -f "$details" "$listing"
    die "$label archive listing failed"
  fi
  # Newer 7-Zip releases expose POSIX links and special files only through
  # the ten-character mode token in Attributes; permit regular files and directories only.
  if grep -Eq '^(Symbolic Link|Hard Link) = |^Attributes = .* [^-d][^[:space:]]{9}$' "$details" ||
     ! awk '
       /^----------$/ { entries = 1; next }
       !entries { next }
       /^$/ { next }
       /^Path = / { print substr($0, 8); paths++; next }
       /^[^=]+ = / { next }
       /^(Warnings|Errors): [0-9]+$/ { next }
       { malformed = 1 }
       END { if (!paths || malformed) exit 1 }
     ' "$details" >"$listing" ||
     ! archive_member_listing_is_safe "$listing"; then
    rm -f "$details" "$listing"
    die "$label has unsafe, duplicate, linked, or unreadable archive members"
  fi
  rm -f "$details" "$listing"
}

extract_7z_archive() {
  local archive="$1" destination="$2" label="$3" overwrite_policy="$4"
  local max_seconds="$5" extract_log="$6" overwrite_option
  case "$overwrite_policy" in
    keep-existing) overwrite_option='-aos' ;;
    replace-existing) overwrite_option='-aoa' ;;
    *) die "$label has an invalid extraction overwrite policy" ;;
  esac
  [[ "$max_seconds" =~ ^[1-9][0-9]*$ ]] || die "$label has an invalid extraction timeout"
  [[ -d "$destination" && ! -L "$destination" ]] || die "$label extraction destination is unsafe or missing"
  preflight_7z_archive "$archive" "$label"
  if ! timeout --foreground --kill-after=10s "$max_seconds" \
      7z x -y "$overwrite_option" "-o$destination" -- "$archive" >>"$extract_log"; then
    die "$label extraction failed; see $extract_log"
  fi
}

extract_bsdtar_archive() {
  local archive="$1" destination="$2" label="$3" existing
  preflight_bsdtar_archive "$archive" "$label"
  [[ -d "$destination" ]] || die "$label extraction destination is missing"
  if ! existing="$(find "$destination" -mindepth 1 -print -quit)"; then
    die "$label extraction destination inspection failed"
  fi
  [[ -z "$existing" ]] || die "$label extraction destination is not empty"
  bsdtar -xkf "$archive" -C "$destination" || die "$label extraction failed"
}

download_verified() {
  local label="$1" url="$2" path="$3" size="$4" checksum="$5"
  mkdir -p "$CACHE_DIR"
  chmod 0700 "$CACHE_DIR"
  if [[ -f "$path" ]]; then
    if [[ "$(stat -c %s "$path")" == "$size" && "$(sha256_of "$path")" == "$checksum" ]]; then
      note "Using verified cached $label"
      return
    fi
    rm -f "$path"
  fi
  if [[ -f "$path.part" ]]; then
    if file_matches "$path.part" "$size" "$checksum"; then
      mv "$path.part" "$path"
      note "Recovered completed verified $label download"
      return
    fi
    if (( $(stat -c %s "$path.part") >= size )); then
      rm -f "$path.part"
    fi
  fi
  note "Downloading $label (safe to resume after interruption)"
  if ! curl --fail --location --retry 5 --retry-all-errors --connect-timeout 20 \
    --max-time 3600 --speed-limit 10240 --speed-time 60 --progress-bar \
    --continue-at - --output "$path.part" "$url"; then
    die "$label download interrupted; verified partial file kept for the next retry"
  fi
  if ! file_matches "$path.part" "$size" "$checksum"; then
    rm -f "$path.part"
    die "$label completed with unexpected size or checksum"
  fi
  mv "$path.part" "$path"
}

clear_wine_detection() {
  WINE_BIN=''
  WINE_SERVER=''
  WINE_VERSION=''
  WINE_ROOT=''
  WINE_LIB_DIR=''
}

detect_wine() {
  local candidate candidate_dir version usr_dir
  clear_wine_detection
  if [[ -n "${LFS_LINUX_WINE:-}" ]]; then
    candidate="$LFS_LINUX_WINE"
  elif [[ -x "$PRIVATE_WINE_BIN" ]]; then
    candidate="$PRIVATE_WINE_BIN"
  else
    candidate="$(command -v wine 2>/dev/null || true)"
  fi
  [[ -n "$candidate" ]] || return 1
  if [[ "$candidate" != */* ]]; then
    candidate="$(command -v -- "$candidate" 2>/dev/null || true)"
  fi
  [[ -n "$candidate" && -x "$candidate" && "${candidate##*/}" == 'wine' ]] || return 1
  candidate_dir="$(cd -- "$(dirname "$candidate")" 2>/dev/null && pwd -P)" || return 1
  usr_dir="$(cd -- "$candidate_dir/.." 2>/dev/null && pwd -P)" || return 1
  candidate="$usr_dir/bin/wine"
  [[ "$candidate_dir" == "$usr_dir/bin" && -x "$candidate" && -d "$usr_dir/lib/wine" && -x "$usr_dir/bin/wineserver" ]] || return 1
  WINE_BIN="$candidate"
  WINE_SERVER="$usr_dir/bin/wineserver"
  WINE_ROOT="$(dirname "$usr_dir")"
  WINE_LIB_DIR="$usr_dir/lib/wine"
  if ! wine_runtime_is_complete; then
    clear_wine_detection
    return 1
  fi
  version="$("$WINE_BIN" --version 2>/dev/null | head -n 1)"
  if [[ "$version" != "$WINE_VERSION_OUTPUT" ]]; then
    clear_wine_detection
    return 1
  fi
  WINE_VERSION="$version"
}

wine_runtime_is_complete() {
  [[ -n "$WINE_ROOT" ]] || return 1
  payload_manifest_check "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES" >/dev/null
}

wine_runtime_layout_is_complete() {
  [[ -n "$WINE_ROOT" ]] || return 1
  payload_manifest_check "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES" layout >/dev/null
}

require_wine() {
  detect_wine || die "exact audited Wine $WINE_RUNTIME_VERSION is required; run lfs-linux install"
  verify_payload_manifest "Wine $WINE_RUNTIME_VERSION runtime" "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
}

verify_wine_package_signature() {
  local status
  verify_file 'Arch Wine signing key' "$WINE_SIGNING_KEY" "$WINE_SIGNING_KEY_SIZE" "$WINE_SIGNING_KEY_SHA256"
  verify_file 'Arch Wine detached signature' "$WINE_PACKAGE_SIGNATURE" \
    "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  if ! status="$(gpgv --status-fd 1 --keyring "$WINE_SIGNING_KEY" \
      "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE" 2>/dev/null)"; then
    die "Arch Wine $WINE_RUNTIME_VERSION package signature is invalid"
  fi
  awk -v fingerprint="$WINE_SIGNING_KEY_FINGERPRINT" '
    $1 == "[GNUPG:]" && $2 == "VALIDSIG" && ($3 == fingerprint || $NF == fingerprint) { valid = 1 }
    END { exit(valid ? 0 : 1) }
  ' <<<"$status" || die "Arch Wine $WINE_RUNTIME_VERSION package signature has an unexpected signer"
}

ensure_wine_runtime() {
  local unpack="$STATE_ROOT/.wine-unpack.$$"
  if detect_wine; then
    return
  fi
  mkdir -p "$STATE_ROOT" "$RUNTIME_DIR" "$CACHE_DIR" "$LOG_DIR"
  download_verified "audited Arch Wine $WINE_RUNTIME_VERSION package" "$WINE_PACKAGE_URL" "$WINE_PACKAGE" \
    "$WINE_PACKAGE_SIZE" "$WINE_PACKAGE_SHA256"
  download_verified "Arch Wine $WINE_RUNTIME_VERSION package signature" "$WINE_PACKAGE_SIGNATURE_URL" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  verify_wine_package_signature
  rm -rf --one-file-system "$unpack"
  mkdir -p "$unpack"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  note "Provisioning private Wine $WINE_RUNTIME_VERSION runtime"
  extract_bsdtar_archive "$WINE_PACKAGE" "$unpack" "Arch Wine $WINE_RUNTIME_VERSION package"
  verify_payload_manifest "extracted Wine $WINE_RUNTIME_VERSION runtime" "$unpack" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  rm -rf --one-file-system "$PRIVATE_WINE_ROOT"
  mv "$unpack" "$PRIVATE_WINE_ROOT"
  ACTIVE_UNPACK=''
  trap - EXIT
  detect_wine || die "provisioned Wine $WINE_RUNTIME_VERSION failed payload validation or version verification"
}

wine_env() {
  env \
    WINEPREFIX="$PREFIX" \
    WINEDEBUG="${WINEDEBUG:--all}" \
    WINEDLLPATH="$WINE_LIB_DIR" \
    WINEDLLOVERRIDES="$WINE_DLL_OVERRIDES" \
    DXVK_LOG_PATH="$LOG_DIR" \
    DXVK_SHADER_CACHE_PATH="$CACHE_DIR/dxvk-shaders" \
    "$@"
}

kill_private_wineserver() {
  [[ -n "$WINE_SERVER" && -x "$WINE_SERVER" ]] || return 0
  wine_env timeout --foreground --kill-after=5s 15 "$WINE_SERVER" -k 2>/dev/null || true
}

wait_private_wineserver() {
  local log="${1:-}" mode="${2:-strict}" active_timeouts=0 wait_status
  while true; do
    if wine_env timeout --foreground --kill-after=5s 60 "$WINE_SERVER" --wait 9>&-; then
      launch_log_event "$log" "event=wine-settled active_timeouts=$active_timeouts"
      return 0
    else
      wait_status=$?
    fi
    if [[ "$wait_status" != '124' && "$wait_status" != '137' ]]; then
      launch_log_event "$log" "event=wine-wait-error phase=primary status=$wait_status"
      [[ "$mode" == 'launch' ]] && return "$wait_status"
      die "private Wine wait failed with status $wait_status"
    fi
    if [[ "$mode" == 'launch' ]] && game_is_running; then
      active_timeouts=$((active_timeouts + 1))
      if (( active_timeouts == 1 )); then
        note 'Updater restarted LFS; waiting for the active game to exit'
      fi
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=yes action=continue"
      continue
    fi
    if [[ "$mode" == 'launch' ]]; then
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=no action=grace"
      if wine_env timeout --foreground --kill-after=2s 5 "$WINE_SERVER" --wait 9>&-; then
        launch_log_event "$log" "event=wine-settled active_timeouts=$active_timeouts grace=yes"
        return 0
      else
        wait_status=$?
      fi
      if [[ "$wait_status" != '124' && "$wait_status" != '137' ]]; then
        launch_log_event "$log" "event=wine-wait-error phase=grace status=$wait_status"
        return "$wait_status"
      fi
      if game_is_running; then
        active_timeouts=$((active_timeouts + 1))
        if (( active_timeouts == 1 )); then
          note 'Updater restarted LFS; waiting for the active game to exit'
        fi
        launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=yes action=continue-after-grace"
        continue
      fi
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=no action=retain-evidence"
      warn 'private Wine services did not settle after LFS exited; they were left running and protected changes were not recorded'
      return 1
    fi
    kill_private_wineserver
    die 'private Wine processes did not settle within 60 seconds'
  done
}

prefix_processes() {
  local pid prefix command_name command_zero executable
  for pid in /proc/[0-9]*; do
    prefix="$(sed -z -n 's/^WINEPREFIX=//p' "$pid/environ" 2>/dev/null | tr -d '\0' || true)"
    [[ "$prefix" == "$PREFIX" ]] || continue
    command_name="$(cat "$pid/comm" 2>/dev/null || true)"
    command_zero="$(tr '\0' '\n' <"$pid/cmdline" 2>/dev/null | head -n 1 || true)"
    executable="$(readlink -f "$pid/exe" 2>/dev/null || true)"
    case "${command_name,,}" in
      wine*|*.exe) printf '%s\n' "${pid##*/}"; continue ;;
    esac
    command_zero="${command_zero##*/}"
    case "${command_zero,,}" in
      wine*|*.exe) printf '%s\n' "${pid##*/}"; continue ;;
    esac
    if [[ -n "$WINE_LIB_DIR" && "$executable" == "$WINE_LIB_DIR/"* ]] ||
       [[ -n "$WINE_BIN" && "$executable" == "$WINE_BIN" ]] ||
       [[ -n "$WINE_SERVER" && "$executable" == "$WINE_SERVER" ]]; then
      printf '%s\n' "${pid##*/}"
    fi
  done
}

game_processes() {
  local pid command_line command_name
  while IFS= read -r pid; do
    command_name="$(cat "/proc/$pid/comm" 2>/dev/null || true)"
    command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    if [[ "${command_name,,}" == 'lfs.exe' || "${command_line,,}" == *'lfs.exe'* ]]; then
      printf '%s\n' "$pid"
    fi
  done < <(prefix_processes)
}

game_is_running() {
  [[ -n "$(game_processes)" ]]
}

prefix_is_running() {
  [[ -n "$(prefix_processes)" ]]
}

wait_for_exit() {
  local seconds="$1" i
  for ((i = 0; i < seconds; i++)); do
    game_is_running || return 0
    sleep 1
  done
  return 1
}

wait_for_prefix_exit() {
  local seconds="$1" i
  for ((i = 0; i < seconds; i++)); do
    prefix_is_running || return 0
    sleep 1
  done
  return 1
}

init_prefix() {
  mkdir -p "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"
  chmod 0700 "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"
  printf '%s\n' 'lfs-linux managed state; unknown files are preserved on removal' >"$STATE_SENTINEL"
  chmod 0600 "$STATE_SENTINEL"
  if [[ ! -f "$PREFIX/system.reg" ]]; then
    note "Creating private Wine prefix with $WINE_VERSION"
    if ! wine_env timeout --foreground --kill-after=10s 180 "$WINE_BIN" wineboot --init; then
      kill_private_wineserver
      rm -rf --one-file-system "$PREFIX"
      die 'Wine prefix initialization failed or timed out'
    fi
    wait_private_wineserver
  elif [[ ! -f "$INSTALL_MARKER" ]] || ! grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER"; then
    note "Updating the private prefix for $WINE_VERSION"
    if ! wine_env timeout --foreground --kill-after=10s 180 "$WINE_BIN" wineboot --update; then
      kill_private_wineserver
      die 'Wine prefix update failed or timed out; existing data was preserved'
    fi
    wait_private_wineserver
  fi
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || die 'prefix architecture drift; expected win64'
}

install_dxvk() {
  local unpack="$CACHE_DIR/.dxvk-unpack.$$"
  download_verified 'DXVK archive' "$DXVK_ARCHIVE_URL" "$DXVK_ARCHIVE" \
    "$DXVK_ARCHIVE_SIZE" "$DXVK_ARCHIVE_SHA256"
  rm -rf "$unpack"
  mkdir -p "$unpack"
  extract_bsdtar_archive "$DXVK_ARCHIVE" "$unpack" 'DXVK archive'
  verify_file 'DXVK d3d11 x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'DXVK dxgi x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  rm -rf "$DXVK_DIR"
  mkdir -p "$DXVK_DIR/x32"
  install -m0644 "$unpack/dxvk-$DXVK_VERSION/x32/d3d11.dll" "$DXVK_D3D11"
  install -m0644 "$unpack/dxvk-$DXVK_VERSION/x32/dxgi.dll" "$DXVK_DXGI"
  rm -rf "$unpack"
  rm -f "$PREFIX/drive_c/windows/syswow64/d3d9.dll"
  install -m0644 "$DXVK_D3D11" "$PREFIX/drive_c/windows/syswow64/d3d11.dll"
  install -m0644 "$DXVK_DXGI" "$PREFIX/drive_c/windows/syswow64/dxgi.dll"
  wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg delete \
    'HKCU\Software\Wine\DllOverrides' /v d3d9 /f >/dev/null 2>&1 || true
  if ! wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg add \
    'HKCU\Software\Wine\DllOverrides' /v d3d11 /d "$DXVK_OVERRIDE" /f >/dev/null || \
    ! wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg add \
    'HKCU\Software\Wine\DllOverrides' /v dxgi /d "$DXVK_OVERRIDE" /f >/dev/null; then
    kill_private_wineserver
    die 'DXVK registry overrides failed or timed out'
  fi
  wait_private_wineserver
}

extract_lfs_payload() {
  local installer="$1" unpack="$2" extract_log="$3" archive
  local -a all_archives dds_archives wld_archives
  : >"$extract_log"
  extract_7z_archive "$installer" "$unpack" 'official LFS installer' keep-existing 900 "$extract_log"
  rm -rf --one-file-system "$unpack/\$PLUGINSDIR"
  rm -f "$unpack/UninstallLFS.exe"
  (( LFS_NESTED_ARCHIVE_COUNT > 0 )) || return 0

  [[ -d "$unpack/inst_tmp" ]] || die 'official LFS nested payload directory is missing'
  mapfile -t all_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name '*.7z' -print | sort)
  mapfile -t dds_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name 'dds_[0-9][0-9].7z' -print | sort)
  mapfile -t wld_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name 'wld_[A-Z][A-Z].7z' -print | sort)
  [[ "${#all_archives[@]}" == "$LFS_NESTED_ARCHIVE_COUNT" ]] || die 'official LFS nested archive-count drift'
  [[ "${#dds_archives[@]}" == "$LFS_NESTED_DDS_ARCHIVE_COUNT" ]] || die 'official LFS DDS archive-count drift'
  [[ "${#wld_archives[@]}" == "$LFS_NESTED_WLD_ARCHIVE_COUNT" ]] || die 'official LFS world archive-count drift'
  [[ -f "$unpack/inst_tmp/knw_1.7z" && -f "$unpack/inst_tmp/training_1.7z" ]] || die 'official LFS nested knowledge or training archive is missing'
  [[ -z "$(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 ! -type f -print -quit)" ]] || die 'unexpected entry in official LFS nested payload directory'
  verify_payload_manifest 'official LFS nested archive payload' "$unpack" "$LFS_NESTED_MANIFEST" \
    "$LFS_NESTED_MANIFEST_SIZE" "$LFS_NESTED_MANIFEST_SHA256" "$LFS_NESTED_MANIFEST_ENTRIES"

  mkdir -p "$unpack/data/dds" "$unpack/data/wld" "$unpack/data/knw" "$unpack/data/training"
  # Exact nested hashes and sorted archive order are audited. Later archives intentionally
  # replace earlier seed entries inside this disposable staging tree.
  for archive in "${dds_archives[@]}"; do
    extract_7z_archive "$archive" "$unpack/data/dds" \
      "official LFS nested DDS archive $(basename "$archive")" replace-existing 300 "$extract_log"
  done
  for archive in "${wld_archives[@]}"; do
    extract_7z_archive "$archive" "$unpack/data/wld" \
      "official LFS nested world archive $(basename "$archive")" replace-existing 300 "$extract_log"
  done
  extract_7z_archive "$unpack/inst_tmp/knw_1.7z" "$unpack/data/knw" \
    'official LFS nested knowledge archive' replace-existing 300 "$extract_log"
  extract_7z_archive "$unpack/inst_tmp/training_1.7z" "$unpack/data/training" \
    'official LFS nested training archive' replace-existing 300 "$extract_log"
  rm -rf --one-file-system "$unpack/inst_tmp"
}

validate_existing_game_source() {
  local actual_size actual_checksum baseline_kind
  if [[ -e "$GAME_BACKUP" || -L "$GAME_BACKUP" ]]; then
    [[ -d "$GAME_BACKUP" && ! -L "$GAME_BACKUP" ]] ||
      die 'interrupted game backup is not a private directory; no files changed'
    trusted_game_backup_is_complete "$GAME_BACKUP" ||
      die 'interrupted game backup is not an exact trusted baseline; no files changed'
  fi
  baseline_kind="$(marker_value LFS_BASELINE_KIND 2>/dev/null || true)"
  if [[ "$baseline_kind" == 'game-update' ]]; then
    load_active_game_baseline || die 'recorded in-game update metadata is missing or changed; no files changed'
    if active_game_tree_is_complete; then
      return
    fi
    if [[ ! -e "$GAME_DIR" && -d "$GAME_BACKUP" ]] && active_game_tree_is_complete "$GAME_BACKUP"; then
      return
    fi
    if local_game_update_requires_upgrade && game_tree_matches_audited_target_overlay; then
      return
    fi
    die 'recorded in-game update baseline drifted outside a trusted LFS session; no files changed—restore that game update or install a reviewed wrapper release'
  fi
  use_packaged_game_baseline
  if [[ ! -f "$GAME_EXE" ]]; then
    [[ ! -e "$GAME_DIR" ]] && return 0
    if [[ -f "$INSTALL_MARKER" ]] && \
       grep -Fqx "LFS_VERSION='$LFS_VERSION'" "$INSTALL_MARKER" && \
       grep -Fqx "LFS_CHANNEL='$LFS_CHANNEL'" "$INSTALL_MARKER" && \
       grep -Fqx "LFS_EXE_SHA256='$LFS_EXE_SHA256'" "$INSTALL_MARKER"; then
      return 0
    fi
    die 'existing LFS tree has no recognized executable or current marker; no files changed—repair it with its matching wrapper or restore a backup'
  fi
  actual_size="$(stat -c %s "$GAME_EXE")"
  actual_checksum="$(sha256_of "$GAME_EXE")" || die 'existing LFS.exe hashing failed or exceeded 1800 seconds'
  if [[ "$actual_size" == "$LFS_EXE_SIZE" && "$actual_checksum" == "$LFS_EXE_SHA256" ]]; then
    return
  fi
  if [[ " $LFS_UPGRADE_FROM_SHA256S " == *" $actual_checksum "* ]]; then
    manifest_metadata_is_valid "$LFS_UPGRADE_MANIFEST" "$LFS_UPGRADE_MANIFEST_SIZE" \
      "$LFS_UPGRADE_MANIFEST_SHA256" "$LFS_UPGRADE_MANIFEST_ENTRIES" || die 'approved upgrade manifest is missing or changed'
    manifest_metadata_is_valid "$LFS_UPGRADE_SEED_MANIFEST" "$LFS_UPGRADE_SEED_MANIFEST_SIZE" \
      "$LFS_UPGRADE_SEED_MANIFEST_SHA256" "$LFS_UPGRADE_SEED_MANIFEST_ENTRIES" || die 'approved upgrade seed manifest is missing or changed'
    payload_manifest_check "$GAME_DIR" "$LFS_UPGRADE_MANIFEST" \
      "$LFS_UPGRADE_MANIFEST_SIZE" "$LFS_UPGRADE_MANIFEST_SHA256" "$LFS_UPGRADE_MANIFEST_ENTRIES" >/dev/null ||
      die 'approved predecessor executable found but its stock payload drifted; no files changed—repair it with the fallback wrapper before upgrading'
    return
  fi
  die "unrecognized LFS update detected ($actual_checksum); no files changed—run lfs-linux update-check and install a reviewed wrapper release"
}

game_tree_is_complete() {
  local root="${1:-$GAME_DIR}" file_count tree_bytes
  payload_manifest_check "$root" "$LFS_STOCK_MANIFEST" \
    "$LFS_STOCK_MANIFEST_SIZE" "$LFS_STOCK_MANIFEST_SHA256" "$LFS_STOCK_MANIFEST_ENTRIES" >/dev/null || return 1
  file_matches "$root/LFS.exe" "$LFS_EXE_SIZE" "$LFS_EXE_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_HELMET_PATH" "$LFS_REQUIRED_HELMET_SIZE" "$LFS_REQUIRED_HELMET_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_TRACK_PATH" "$LFS_REQUIRED_TRACK_SIZE" "$LFS_REQUIRED_TRACK_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_VEHICLE_PATH" "$LFS_REQUIRED_VEHICLE_SIZE" "$LFS_REQUIRED_VEHICLE_SHA256" || return 1
  file_count="$(find "$root" -type f -printf . | wc -c)"
  tree_bytes="$(du -sb "$root" | awk '{print $1}')"
  (( file_count >= LFS_TREE_MIN_FILE_COUNT && tree_bytes >= LFS_TREE_MIN_BYTES ))
}

game_tree_layout_is_complete() {
  local root="$GAME_DIR" file_count tree_bytes
  payload_manifest_check "$root" "$LFS_STOCK_MANIFEST" \
    "$LFS_STOCK_MANIFEST_SIZE" "$LFS_STOCK_MANIFEST_SHA256" "$LFS_STOCK_MANIFEST_ENTRIES" layout >/dev/null || return 1
  file_matches "$root/LFS.exe" "$LFS_EXE_SIZE" "$LFS_EXE_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_HELMET_PATH" "$LFS_REQUIRED_HELMET_SIZE" "$LFS_REQUIRED_HELMET_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_TRACK_PATH" "$LFS_REQUIRED_TRACK_SIZE" "$LFS_REQUIRED_TRACK_SHA256" || return 1
  file_matches "$root/$LFS_REQUIRED_VEHICLE_PATH" "$LFS_REQUIRED_VEHICLE_SIZE" "$LFS_REQUIRED_VEHICLE_SHA256" || return 1
  file_count="$(find "$root" -type f -printf . | wc -c)"
  tree_bytes="$(du -sb "$root" | awk '{print $1}')"
  (( file_count >= LFS_TREE_MIN_FILE_COUNT && tree_bytes >= LFS_TREE_MIN_BYTES ))
}

active_game_tree_is_complete() {
  local root="${1:-$GAME_DIR}"
  if [[ "$ACTIVE_BASELINE_KIND" == 'package' ]]; then
    game_tree_is_complete "$root"
    return
  fi
  payload_manifest_check "$root" "$ACTIVE_LFS_STOCK_MANIFEST" \
    "$ACTIVE_LFS_STOCK_MANIFEST_SIZE" "$ACTIVE_LFS_STOCK_MANIFEST_SHA256" \
    "$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES" >/dev/null || return 1
  file_matches "$root/LFS.exe" "$ACTIVE_LFS_EXE_SIZE" "$ACTIVE_LFS_EXE_SHA256" || return 1
  game_inventory_matches_manifest "$root" "$ACTIVE_LFS_STOCK_MANIFEST"
}

active_game_tree_layout_is_complete() {
  if [[ "$ACTIVE_BASELINE_KIND" == 'package' ]]; then
    game_tree_layout_is_complete
    return
  fi
  payload_manifest_check "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST" \
    "$ACTIVE_LFS_STOCK_MANIFEST_SIZE" "$ACTIVE_LFS_STOCK_MANIFEST_SHA256" \
    "$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES" layout >/dev/null || return 1
  file_matches "$GAME_EXE" "$ACTIVE_LFS_EXE_SIZE" "$ACTIVE_LFS_EXE_SHA256" || return 1
  game_inventory_matches_manifest "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST"
}

verify_active_game_tree() {
  local label="$1"
  if [[ "$ACTIVE_BASELINE_KIND" == 'package' ]]; then
    verify_game_tree "$GAME_DIR" "$label"
    return
  fi
  verify_payload_manifest "$label recorded in-game update payload" "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST" \
    "$ACTIVE_LFS_STOCK_MANIFEST_SIZE" "$ACTIVE_LFS_STOCK_MANIFEST_SHA256" \
    "$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES"
  verify_file "$label LFS.exe" "$GAME_EXE" "$ACTIVE_LFS_EXE_SIZE" "$ACTIVE_LFS_EXE_SHA256"
  game_inventory_matches_manifest "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST" ||
    die "$label recorded in-game update inventory drift"
}

verify_game_tree() {
  local root="$1" label="$2" file_count tree_bytes
  verify_payload_manifest "$label immutable stock payload" "$root" "$LFS_STOCK_MANIFEST" \
    "$LFS_STOCK_MANIFEST_SIZE" "$LFS_STOCK_MANIFEST_SHA256" "$LFS_STOCK_MANIFEST_ENTRIES"
  verify_file "$label LFS.exe" "$root/LFS.exe" "$LFS_EXE_SIZE" "$LFS_EXE_SHA256"
  verify_file "$label default helmet" "$root/$LFS_REQUIRED_HELMET_PATH" \
    "$LFS_REQUIRED_HELMET_SIZE" "$LFS_REQUIRED_HELMET_SHA256"
  verify_file "$label Blackwood track" "$root/$LFS_REQUIRED_TRACK_PATH" \
    "$LFS_REQUIRED_TRACK_SIZE" "$LFS_REQUIRED_TRACK_SHA256"
  verify_file "$label demo vehicle" "$root/$LFS_REQUIRED_VEHICLE_PATH" \
    "$LFS_REQUIRED_VEHICLE_SIZE" "$LFS_REQUIRED_VEHICLE_SHA256"
  file_count="$(find "$root" -type f -printf . | wc -c)"
  tree_bytes="$(du -sb "$root" | awk '{print $1}')"
  (( file_count >= LFS_TREE_MIN_FILE_COUNT )) || die "$label file-count drift: expected at least $LFS_TREE_MIN_FILE_COUNT, found $file_count"
  (( tree_bytes >= LFS_TREE_MIN_BYTES )) || die "$label size drift: expected at least $LFS_TREE_MIN_BYTES bytes, found $tree_bytes"
}

verify_extracted_game_tree() {
  local root="$1" label="$2"
  verify_payload_manifest "$label complete official seed payload" "$root" "$LFS_STOCK_SEED_MANIFEST" \
    "$LFS_STOCK_SEED_MANIFEST_SIZE" "$LFS_STOCK_SEED_MANIFEST_SHA256" "$LFS_STOCK_SEED_MANIFEST_ENTRIES"
  verify_game_tree "$root" "$label"
}

manifest_metadata_is_valid() {
  local manifest="$1" expected_size="$2" expected_hash="$3" expected_entries="$4" entry_count
  file_matches "$manifest" "$expected_size" "$expected_hash" || return 1
  entry_count="$(awk -F '\t' '$1 == "f" || $1 == "l" { count++ } END { print count + 0 }' "$manifest")"
  [[ "$entry_count" == "$expected_entries" ]] || return 1
  awk -F '\t' '($1 == "f" || $1 == "l") && ($4 == "" || $4 ~ /^\// || $4 ~ /(^|\/)\.\.(\/|$)/) { exit 1 }' "$manifest"
}

manifest_is_audited_target_overlay() {
  local previous_manifest="$1" target_manifest="$2" candidate_manifest="$3"
  awk -F '\t' '
    FNR == 1 { file_number++ }
    $1 != "f" && $1 != "l" { next }
    file_number == 1 {
      if (previous_seen[$4]++) bad = 1
      previous[$4] = $0
      next
    }
    file_number == 2 {
      if (target_seen[$4]++) bad = 1
      target[$4] = $0
      next
    }
    file_number == 3 {
      if (candidate_seen[$4]++) bad = 1
      if ($4 in target) {
        if ($0 != target[$4]) bad = 1
        candidate_target[$4] = 1
      } else if ($4 in previous) {
        if ($0 != previous[$4]) bad = 1
      } else {
        bad = 1
      }
    }
    END {
      for (path in target) {
        if (!(path in candidate_target)) bad = 1
      }
      exit bad
    }
  ' "$previous_manifest" "$target_manifest" "$candidate_manifest"
}

game_tree_structure_matches_audited_target_overlay() {
  local manifest type expected expected_size relative path directory
  local -A allowed_directories=()
  for manifest in "$ACTIVE_LFS_STOCK_MANIFEST" "$LFS_STOCK_MANIFEST"; do
    while IFS=$'\t' read -r type expected expected_size relative; do
      [[ "$type" == 'f' || "$type" == 'l' ]] || continue
      directory="$relative"
      while [[ "$directory" == */* ]]; do
        directory="${directory%/*}"
        allowed_directories["$directory"]=1
      done
    done <"$manifest"
  done
  while IFS= read -r -d '' path; do
    relative="${path#"$GAME_DIR/"}"
    if [[ -L "$path" || -f "$path" ]]; then
      continue
    fi
    [[ -d "$path" ]] || return 1
    upgrade_game_path_is_player_owned "$relative" && continue
    [[ -n "${allowed_directories[$relative]+present}" ]] || return 1
  done < <(find -P "$GAME_DIR" -mindepth 1 -print0)
}

game_tree_matches_audited_target_overlay() {
  local candidate status=0
  local_game_update_requires_upgrade || return 1
  manifest_metadata_is_valid "$LFS_STOCK_MANIFEST" "$LFS_STOCK_MANIFEST_SIZE" \
    "$LFS_STOCK_MANIFEST_SHA256" "$LFS_STOCK_MANIFEST_ENTRIES" || return 1
  game_tree_structure_matches_audited_target_overlay || return 1
  candidate="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-target-overlay.XXXXXX")" || return 1
  snapshot_game_manifest "$GAME_DIR" "$candidate" || status=1
  (( status != 0 )) || manifest_is_audited_target_overlay \
    "$ACTIVE_LFS_STOCK_MANIFEST" "$LFS_STOCK_MANIFEST" "$candidate" || status=1
  rm -f -- "$candidate"
  return "$status"
}

path_matches_manifest_entry() {
  local path="$1" type="$2" expected="$3" expected_size="$4"
  case "$type" in
    f)
      [[ -f "$path" && ! -L "$path" ]] || return 1
      [[ "$(stat -c %s "$path")" == "$expected_size" ]] || return 1
      [[ "$(sha256_of "$path")" == "$expected" ]]
      ;;
    l)
      [[ -L "$path" && "$(readlink -- "$path")" == "$expected" ]]
      ;;
    *) return 1 ;;
  esac
}

cleanup_empty_predecessor_quarantine() {
  [[ -d "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]] || return 0
  find "$GAME_PREDECESSOR_QUARANTINE" -depth -type d -empty -delete 2>/dev/null || true
}

predecessor_only_manifest_entry() {
  local relative="$1"
  awk -F '\t' -v wanted="$relative" '
    NR == FNR {
      if ($1 == "f" || $1 == "l") target[$4] = 1
      next
    }
    ($1 == "f" || $1 == "l") && $4 == wanted && !($4 in target) {
      print
      found++
    }
    END { exit found == 1 ? 0 : 1 }
  ' "$LFS_STOCK_MANIFEST" "$QUARANTINE_PREDECESSOR_MANIFEST"
}

rollback_predecessor_quarantine() {
  local path relative entry type expected expected_size source status=0
  if [[ ! -e "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]]; then
    ACTIVE_PREDECESSOR_QUARANTINE=''
    return 0
  fi
  if [[ ! -d "$GAME_PREDECESSOR_QUARANTINE" || -L "$GAME_PREDECESSOR_QUARANTINE" ]]; then
    return 1
  fi
  while IFS= read -r -d '' path; do
    [[ -d "$path" && ! -L "$path" ]] && continue
    relative="${path#"$GAME_PREDECESSOR_QUARANTINE/"}"
    if [[ ! -f "$path" && ! -L "$path" ]]; then
      status=1
      continue
    fi
    entry="$(predecessor_only_manifest_entry "$relative" 2>/dev/null)" || { status=1; continue; }
    IFS=$'\t' read -r type expected expected_size relative <<<"$entry"
    upgrade_game_path_is_player_owned "$relative" && { status=1; continue; }
    source="$GAME_DIR/$relative"
    if [[ -e "$source" || -L "$source" ]]; then
      status=1
      continue
    fi
    mkdir -p "$(dirname "$source")"
    mv -- "$path" "$source" || status=1
  done < <(find -P "$GAME_PREDECESSOR_QUARANTINE" -mindepth 1 -depth -print0)
  cleanup_empty_predecessor_quarantine
  if [[ -e "$GAME_PREDECESSOR_QUARANTINE" || -L "$GAME_PREDECESSOR_QUARANTINE" ]]; then
    status=1
  else
    ACTIVE_PREDECESSOR_QUARANTINE=''
    QUARANTINE_PREDECESSOR_MANIFEST=''
    QUARANTINE_SOURCE_VERSION=''
  fi
  return "$status"
}

finalize_predecessor_quarantine() {
  local path relative entry type expected expected_size fingerprint destination moved=0
  local conflict_dir="$STATE_ROOT/migration-conflicts/from-$QUARANTINE_SOURCE_VERSION-to-$LFS_VERSION"
  if [[ ! -e "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]]; then
    ACTIVE_PREDECESSOR_QUARANTINE=''
    return 0
  fi
  [[ -d "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]] ||
    die "unsafe committed predecessor quarantine retained at $GAME_PREDECESSOR_QUARANTINE"
  while IFS= read -r -d '' path; do
    [[ -d "$path" && ! -L "$path" ]] && continue
    relative="${path#"$GAME_PREDECESSOR_QUARANTINE/"}"
    entry="$(predecessor_only_manifest_entry "$relative" 2>/dev/null)" ||
      die "unrecognized committed predecessor quarantine content retained at $GAME_PREDECESSOR_QUARANTINE"
    IFS=$'\t' read -r type expected expected_size relative <<<"$entry"
    path_matches_manifest_entry "$path" "$type" "$expected" "$expected_size" ||
      die "committed predecessor quarantine changed; retained at $GAME_PREDECESSOR_QUARANTINE"
    if [[ "$type" == 'f' ]]; then
      fingerprint="$expected"
    else
      fingerprint="$(printf 'link:%s' "$expected" | sha256sum | awk '{print $1}')"
    fi
    destination="$conflict_dir/$relative.$fingerprint.pre-upgrade"
    mkdir -p "$(dirname "$destination")"
    if [[ -e "$destination" || -L "$destination" ]]; then
      path_matches_manifest_entry "$destination" "$type" "$expected" "$expected_size" ||
        die "preserved predecessor-only path changed: $destination"
      rm -f -- "$path"
    else
      mv -- "$path" "$destination" ||
        die "could not preserve predecessor-only protected path: $relative"
    fi
    moved=$((moved + 1))
  done < <(find -P "$GAME_PREDECESSOR_QUARANTINE" -mindepth 1 -depth -print0)
  cleanup_empty_predecessor_quarantine
  [[ ! -e "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]] ||
    die "committed predecessor quarantine content retained at $GAME_PREDECESSOR_QUARANTINE"
  ACTIVE_PREDECESSOR_QUARANTINE=''
  QUARANTINE_PREDECESSOR_MANIFEST=''
  QUARANTINE_SOURCE_VERSION=''
  note "Preserved $moved predecessor-only protected path(s) under $conflict_dir"
}

recover_committed_predecessor_quarantine() {
  local destination
  [[ -e "$GAME_PREDECESSOR_QUARANTINE" || -L "$GAME_PREDECESSOR_QUARANTINE" ]] || return 0
  [[ "$(marker_value LFS_BASELINE_KIND 2>/dev/null || true)" == 'package' &&
     "$(marker_value LFS_VERSION 2>/dev/null || true)" == "$LFS_VERSION" &&
     "$(marker_value LFS_EXE_SHA256 2>/dev/null || true)" == "$LFS_EXE_SHA256" ]] || return 0
  [[ -d "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]] ||
    die "unsafe committed predecessor quarantine retained at $GAME_PREDECESSOR_QUARANTINE"
  destination="$STATE_ROOT/migration-conflicts/recovered-predecessor-quarantine"
  [[ ! -e "$destination" && ! -L "$destination" ]] ||
    die "committed predecessor quarantine recovery destination already exists: $destination"
  mkdir -p "$(dirname "$destination")"
  mv -- "$GAME_PREDECESSOR_QUARANTINE" "$destination" ||
    die "could not retain committed predecessor quarantine at $destination"
  note "Retained committed predecessor quarantine after interrupted cleanup at $destination"
}

quarantine_audited_predecessor_only_entries() {
  local type expected expected_size relative source quarantine_path mode path moved=0
  local -A expected_paths=()
  QUARANTINE_PREDECESSOR_MANIFEST="$ACTIVE_LFS_STOCK_MANIFEST"
  QUARANTINE_SOURCE_VERSION="$ACTIVE_LFS_VERSION"
  if [[ -e "$GAME_PREDECESSOR_QUARANTINE" || -L "$GAME_PREDECESSOR_QUARANTINE" ]]; then
    [[ -d "$GAME_PREDECESSOR_QUARANTINE" && ! -L "$GAME_PREDECESSOR_QUARANTINE" ]] ||
      die "unsafe predecessor quarantine: $GAME_PREDECESSOR_QUARANTINE"
    [[ "$(stat -c %u "$GAME_PREDECESSOR_QUARANTINE")" == "$UID" ]] ||
      die "predecessor quarantine is not owned by the current user: $GAME_PREDECESSOR_QUARANTINE"
    mode="$(stat -c %a "$GAME_PREDECESSOR_QUARANTINE")"
    (( (8#$mode & 077) == 0 )) || die "predecessor quarantine is accessible by other users: $GAME_PREDECESSOR_QUARANTINE"
  else
    mkdir -m 0700 -- "$GAME_PREDECESSOR_QUARANTINE"
  fi
  ACTIVE_PREDECESSOR_QUARANTINE='prepared'
  while IFS=$'\t' read -r type expected expected_size relative; do
    upgrade_game_path_is_player_owned "$relative" && continue
    [[ -n "$relative" && "$relative" != /* && "$relative" != *$'\t'* && \
       "$relative" != *$'\n'* && "$relative" != '..' && "$relative" != ../* && \
       "$relative" != */../* && "$relative" != */.. ]] ||
      die 'approved predecessor manifest contains an unsafe removable path'
    expected_paths["$relative"]=1
    source="$GAME_DIR/$relative"
    quarantine_path="$GAME_PREDECESSOR_QUARANTINE/$relative"
    if [[ -e "$source" || -L "$source" ]]; then
      [[ ! -e "$quarantine_path" && ! -L "$quarantine_path" ]] ||
        die "both game and quarantine contain predecessor-only path: $relative"
      [[ -f "$source" || -L "$source" ]] || die "predecessor-only protected path changed type: $relative"
      mkdir -p "$(dirname "$quarantine_path")"
      mv -- "$source" "$quarantine_path" || die "could not quarantine predecessor-only protected path: $relative"
    elif [[ ! -e "$quarantine_path" && ! -L "$quarantine_path" ]]; then
      continue
    fi
    path_matches_manifest_entry "$quarantine_path" "$type" "$expected" "$expected_size" ||
      die "predecessor-only protected path changed before quarantine: $relative"
    moved=$((moved + 1))
    if (( moved == 1 )) && [[ -n "${LFS_LINUX_TEST_OVERLAY_QUARANTINE_AFTER_FIRST_READY_FILE:-}" ]]; then
      : >"$LFS_LINUX_TEST_OVERLAY_QUARANTINE_AFTER_FIRST_READY_FILE"
      [[ "${LFS_LINUX_TEST_OVERLAY_QUARANTINE_AFTER_FIRST_DELAY_SECONDS:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
        die 'invalid after-first-quarantine test delay'
      sleep "$LFS_LINUX_TEST_OVERLAY_QUARANTINE_AFTER_FIRST_DELAY_SECONDS"
    fi
  done < <(
    awk -F '\t' '
      NR == FNR {
        if ($1 == "f" || $1 == "l") target[$4] = 1
        next
      }
      ($1 == "f" || $1 == "l") && !($4 in target) { print }
    ' "$LFS_STOCK_MANIFEST" "$QUARANTINE_PREDECESSOR_MANIFEST"
  )
  while IFS= read -r -d '' path; do
    [[ -d "$path" && ! -L "$path" ]] && continue
    relative="${path#"$GAME_PREDECESSOR_QUARANTINE/"}"
    [[ ( -f "$path" || -L "$path" ) && -n "${expected_paths[$relative]+present}" ]] ||
      die "unrecognized predecessor quarantine content retained at $GAME_PREDECESSOR_QUARANTINE"
  done < <(find -P "$GAME_PREDECESSOR_QUARANTINE" -mindepth 1 -depth -print0)
  if (( moved == 0 )); then
    cleanup_empty_predecessor_quarantine
    ACTIVE_PREDECESSOR_QUARANTINE=''
    QUARANTINE_PREDECESSOR_MANIFEST=''
    QUARANTINE_SOURCE_VERSION=''
  fi
  note "Quarantined $moved predecessor-only protected path(s) pending package marker commit"
}

merge_preserved_game_files() {
  local existing="$1" staging="$2" source_manifest="$3" source_seed_manifest="$4"
  local source relative destination type expected expected_size fingerprint conflict_destination source_hash
  local conflicts=0 preserved=0
  local conflict_dir="$STATE_ROOT/migration-conflicts/from-$LFS_UPGRADE_FROM_VERSION-to-$LFS_VERSION"
  local -A source_stock_paths=() target_stock_paths=() source_seed_types=() source_seed_values=()
  while IFS=$'\t' read -r type expected expected_size relative; do
    [[ "$type" == 'f' || "$type" == 'l' ]] && source_stock_paths["$relative"]=1
  done <"$source_manifest"
  while IFS=$'\t' read -r type expected expected_size relative; do
    if [[ "$type" == 'f' || "$type" == 'l' ]]; then
      source_seed_types["$relative"]="$type"
      source_seed_values["$relative"]="$expected"
    fi
  done <"$source_seed_manifest"
  while IFS=$'\t' read -r type expected expected_size relative; do
    [[ "$type" == 'f' || "$type" == 'l' ]] && target_stock_paths["$relative"]=1
  done <"$LFS_STOCK_MANIFEST"

  while IFS= read -r -d '' source; do
    relative="${source#"$existing/"}"
    [[ -z "${source_stock_paths[$relative]+present}" ]] || continue
    source_hash=''
    if [[ -n "${source_seed_types[$relative]+present}" ]]; then
      if [[ "${source_seed_types[$relative]}" == 'l' && -L "$source" && \
            "$(readlink -- "$source")" == "${source_seed_values[$relative]}" ]]; then
        continue
      fi
      if [[ "${source_seed_types[$relative]}" == 'f' && -f "$source" && ! -L "$source" ]]; then
        source_hash="$(sha256_of "$source")" || die "player-file hashing failed during migration: $relative"
        [[ "$source_hash" == "${source_seed_values[$relative]}" ]] && continue
      fi
    fi
    if [[ -n "${target_stock_paths[$relative]+present}" ]]; then
      if [[ -L "$source" ]]; then
        fingerprint="$(printf 'link:%s' "$(readlink -- "$source")" | sha256sum | awk '{print $1}')"
      elif [[ -n "$source_hash" ]]; then
        fingerprint="$source_hash"
      else
        fingerprint="$(sha256_of "$source")" || die "player-file hashing failed during migration: $relative"
      fi
      conflict_destination="$conflict_dir/$relative.$fingerprint.pre-upgrade"
      mkdir -p "$(dirname "$conflict_destination")"
      if [[ ! -e "$conflict_destination" && ! -L "$conflict_destination" ]]; then
        cp -a -- "$source" "$conflict_destination"
      fi
      conflicts=$((conflicts + 1))
      continue
    fi
    destination="$staging/$relative"
    mkdir -p "$(dirname "$destination")"
    cp -a --remove-destination -- "$source" "$destination"
    preserved=$((preserved + 1))
  done < <(find "$existing" \( -type f -o -type l \) -print0)
  note "Preserved $preserved changed or player-owned game file(s)"
  if (( conflicts > 0 )); then
    note "Preserved $conflicts player file(s) that collide with new stock paths under $conflict_dir"
  fi
}

merge_local_upgrade_player_directories() {
  local existing="$1" staging="$2" relative source_root destination_root source source_relative type expected expected_size
  local source_hash fingerprint conflict_destination unsupported merged=0 conflicts=0
  local conflict_dir="$STATE_ROOT/migration-conflicts/from-$LFS_LOCAL_UPDATE_UPGRADE_FROM_VERSION-to-$LFS_VERSION"
  local -A target_types=() target_values=() target_sizes=()
  while IFS=$'\t' read -r type expected expected_size relative; do
    if [[ "$type" == 'f' || "$type" == 'l' ]]; then
      target_types["$relative"]="$type"
      target_values["$relative"]="$expected"
      target_sizes["$relative"]="$expected_size"
    fi
  done <"$LFS_STOCK_MANIFEST"

  for relative in "${LOCAL_UPGRADE_MERGED_PLAYER_DIRS[@]}"; do
    source_root="$existing/$relative"
    [[ -e "$source_root" || -L "$source_root" ]] || continue
    [[ -d "$source_root" && ! -L "$source_root" ]] ||
      die "player-owned merge root changed type during migration: $relative"
    unsupported="$(find -P "$source_root" ! -type d ! -type f ! -type l -print -quit)"
    [[ -z "$unsupported" ]] || die "unsupported player-owned game entry during migration: ${unsupported#"$existing/"}"
    while IFS= read -r -d '' source; do
      source_relative="${source#"$existing/"}"
      [[ -n "${target_types[$source_relative]+present}" ]] || continue
      source_hash=''
      if [[ "${target_types[$source_relative]}" == 'l' && -L "$source" && \
            "$(readlink -- "$source")" == "${target_values[$source_relative]}" ]]; then
        continue
      fi
      if [[ "${target_types[$source_relative]}" == 'f' && -f "$source" && ! -L "$source" && \
            "$(stat -c %s "$source")" == "${target_sizes[$source_relative]}" ]]; then
        source_hash="$(sha256_of "$source")" || die "player-file hashing failed during migration: $source_relative"
        [[ "$source_hash" == "${target_values[$source_relative]}" ]] && continue
      fi
      if [[ -L "$source" ]]; then
        fingerprint="$(printf 'link:%s' "$(readlink -- "$source")" | sha256sum | awk '{print $1}')"
      elif [[ -n "$source_hash" ]]; then
        fingerprint="$source_hash"
      else
        fingerprint="$(sha256_of "$source")" || die "player-file hashing failed during migration: $source_relative"
      fi
      conflict_destination="$conflict_dir/$source_relative.$fingerprint.pre-upgrade"
      mkdir -p "$(dirname "$conflict_destination")"
      if [[ ! -e "$conflict_destination" && ! -L "$conflict_destination" ]]; then
        cp -a -- "$source" "$conflict_destination"
      fi
      conflicts=$((conflicts + 1))
    done < <(find -P "$source_root" \( -type f -o -type l \) -print0)
    destination_root="$staging/$relative"
    mkdir -p "$destination_root"
    cp -a --no-clobber -- "$source_root/." "$destination_root/" ||
      die "could not merge player-owned game path: $relative"
    merged=$((merged + 1))
  done
  note "Merged player-owned paths that share stock directories ($merged roots)"
  if (( conflicts > 0 )); then
    note "Preserved $conflicts player file(s) that collide with C24 stock under $conflict_dir"
  fi
}

copy_complete_player_owned_game_paths() {
  local existing="$1" staging="$2" relative source destination unsupported preserved=0
  for relative in "${PLAYER_OWNED_GAME_FILES[@]}" "${LOCAL_UPGRADE_PLAYER_DIRS[@]}"; do
    source="$existing/$relative"
    [[ -e "$source" || -L "$source" ]] || continue
    if [[ ! -f "$source" && ! -d "$source" && ! -L "$source" ]]; then
      die "unsupported player-owned game entry during migration: $relative"
    fi
    if [[ -d "$source" && ! -L "$source" ]]; then
      unsupported="$(find -P "$source" ! -type d ! -type f ! -type l -print -quit)"
      [[ -z "$unsupported" ]] || die "unsupported player-owned game entry during migration: ${unsupported#"$existing/"}"
    fi
    destination="$staging/$relative"
    rm -rf --one-file-system -- "$destination"
    mkdir -p "$(dirname "$destination")"
    cp -a -- "$source" "$destination" || die "could not preserve player-owned game path: $relative"
    preserved=$((preserved + 1))
  done
  merge_local_upgrade_player_directories "$existing" "$staging"
  note "Preserved complete player-owned paths from the verified local update ($preserved roots)"
}

approved_predecessor_game_tree_is_complete() {
  local root="$1" actual_checksum
  [[ -f "$root/LFS.exe" && ! -L "$root/LFS.exe" ]] || return 1
  actual_checksum="$(sha256_of "$root/LFS.exe")" || return 1
  [[ " $LFS_UPGRADE_FROM_SHA256S " == *" $actual_checksum "* ]] || return 1
  manifest_metadata_is_valid "$LFS_UPGRADE_MANIFEST" "$LFS_UPGRADE_MANIFEST_SIZE" \
    "$LFS_UPGRADE_MANIFEST_SHA256" "$LFS_UPGRADE_MANIFEST_ENTRIES" || return 1
  payload_manifest_check "$root" "$LFS_UPGRADE_MANIFEST" \
    "$LFS_UPGRADE_MANIFEST_SIZE" "$LFS_UPGRADE_MANIFEST_SHA256" \
    "$LFS_UPGRADE_MANIFEST_ENTRIES" >/dev/null
}

trusted_game_backup_is_complete() {
  local root="$1" baseline_kind
  baseline_kind="$(marker_value LFS_BASELINE_KIND 2>/dev/null || true)"
  if [[ "$baseline_kind" == 'game-update' ]]; then
    load_active_game_baseline || return 1
    active_game_tree_is_complete "$root"
    return
  fi
  use_packaged_game_baseline
  game_tree_is_complete "$root" || approved_predecessor_game_tree_is_complete "$root"
}

recover_interrupted_game_swap() {
  if [[ ! -e "$GAME_BACKUP" && ! -L "$GAME_BACKUP" ]]; then
    return 0
  fi
  [[ -d "$GAME_BACKUP" && ! -L "$GAME_BACKUP" ]] ||
    die 'interrupted game backup is not a private directory; no files changed'
  trusted_game_backup_is_complete "$GAME_BACKUP" ||
    die 'interrupted game backup is not an exact trusted baseline; no files changed'
  if [[ ! -e "$GAME_DIR" && ! -L "$GAME_DIR" ]]; then
    mv -- "$GAME_BACKUP" "$GAME_DIR" || die 'could not restore the trusted interrupted game backup'
    note 'Recovered player data after an interrupted game-tree swap'
    return
  fi
  if game_tree_is_complete; then
    rm -rf --one-file-system "$GAME_BACKUP"
    note 'Removed completed game-tree swap backup'
    return
  fi
  [[ ! -e "$GAME_RECOVERY_CONFLICT" && ! -L "$GAME_RECOVERY_CONFLICT" ]] ||
    die "interrupted current game tree retained; recovery destination already exists: $GAME_RECOVERY_CONFLICT"
  mkdir -p "$(dirname "$GAME_RECOVERY_CONFLICT")"
  mv -- "$GAME_DIR" "$GAME_RECOVERY_CONFLICT" ||
    die 'could not retain the interrupted current game tree; no files changed'
  if ! mv -- "$GAME_BACKUP" "$GAME_DIR"; then
    mv -- "$GAME_RECOVERY_CONFLICT" "$GAME_DIR" || true
    die 'could not restore the trusted game backup; interrupted current tree was retained'
  fi
  note 'Restored previous game tree after an interrupted upgrade'
  note "Retained the interrupted current tree at $GAME_RECOVERY_CONFLICT"
}

replace_game_tree() {
  local staging="$1" source_manifest="$2" source_seed_manifest="$3" preservation_mode="${4:-seed-diff}"
  if [[ "$preservation_mode" == 'complete-player-paths' ]]; then
    copy_complete_player_owned_game_paths "$GAME_DIR" "$staging"
  else
    merge_preserved_game_files "$GAME_DIR" "$staging" "$source_manifest" "$source_seed_manifest"
  fi
  rm -rf --one-file-system "$GAME_BACKUP"
  mv "$GAME_DIR" "$GAME_BACKUP"
  if [[ "${LFS_LINUX_TEST_FAIL_AFTER_GAME_BACKUP:-0}" == '1' ]]; then
    die 'test fault after previous game tree moved to recovery backup'
  fi
  if ! mv "$staging" "$GAME_DIR"; then
    mv "$GAME_BACKUP" "$GAME_DIR"
    die 'could not activate verified LFS staging tree; previous game restored'
  fi
  if ! game_tree_is_complete; then
    rm -rf --one-file-system "$GAME_DIR"
    mv "$GAME_BACKUP" "$GAME_DIR"
    die 'activated LFS tree failed verification; previous game restored'
  fi
  rm -rf --one-file-system "$GAME_BACKUP"
}

remove_local_game_manifests_except() {
  local keep="${1:-}" path name status=0
  for path in "$STATE_ROOT"/game-update-*.manifest; do
    [[ -e "$path" || -L "$path" ]] || continue
    name="$(basename "$path")"
    [[ "$name" =~ ^game-update-[0-9a-f]{64}\.manifest$ ]] || continue
    [[ "$path" == "$keep" ]] || rm -f -- "$path" || status=1
  done
  [[ "$LEGACY_LOCAL_GAME_MANIFEST" == "$keep" ]] || rm -f -- "$LEGACY_LOCAL_GAME_MANIFEST" || status=1
  return "$status"
}

install_game() {
  local unpack="$STATE_ROOT/.lfs-unpack.$$" actual_size actual_checksum source_manifest source_seed_manifest extract_log="$LOG_DIR/lfs-extract.log"
  local preservation_mode='seed-diff'
  if [[ "$(marker_value LFS_BASELINE_KIND 2>/dev/null || true)" == 'game-update' ]]; then
    load_active_game_baseline || die 'recorded in-game update metadata is missing or changed'
    if active_game_tree_is_complete; then
      if local_game_update_requires_upgrade; then
        preservation_mode='complete-player-paths'
        note "Verified locally recorded LFS $ACTIVE_LFS_VERSION as the approved catch-up predecessor"
      else
        note "Verified locally recorded LFS $ACTIVE_LFS_VERSION in-game update; preserving game-owned data"
        return
      fi
    elif local_game_update_requires_upgrade && game_tree_matches_audited_target_overlay; then
      note "Recognized exact audited $LFS_VERSION overlay on the verified $ACTIVE_LFS_VERSION baseline"
      quarantine_audited_predecessor_only_entries
      game_tree_matches_audited_target_overlay || die 'audited target overlay changed during normalization; no player-owned files changed'
      game_tree_is_complete || die 'normalized audited target overlay failed complete target verification; no player-owned files changed'
      use_packaged_game_baseline
      return
    else
      die 'recorded in-game update baseline drifted; no files changed'
    fi
  fi
  use_packaged_game_baseline
  source_manifest="$LFS_STOCK_MANIFEST"
  source_seed_manifest="$LFS_STOCK_SEED_MANIFEST"
  if [[ "$preservation_mode" != 'complete-player-paths' && -f "$GAME_EXE" ]]; then
    actual_size="$(stat -c %s "$GAME_EXE")"
    actual_checksum="$(sha256_of "$GAME_EXE")" || die 'existing LFS.exe hashing failed or exceeded 1800 seconds'
    if [[ "$actual_size" == "$LFS_EXE_SIZE" && "$actual_checksum" == "$LFS_EXE_SHA256" ]]; then
      if game_tree_is_complete; then
        use_packaged_game_baseline
        note 'Verified complete stock LFS installation; preserving game-owned data'
        return
      fi
      note 'Stock LFS tree is incomplete; repairing it from the verified official archive'
    elif [[ " $LFS_UPGRADE_FROM_SHA256S " == *" $actual_checksum "* ]]; then
      manifest_metadata_is_valid "$LFS_UPGRADE_MANIFEST" "$LFS_UPGRADE_MANIFEST_SIZE" \
        "$LFS_UPGRADE_MANIFEST_SHA256" "$LFS_UPGRADE_MANIFEST_ENTRIES" || die 'approved upgrade manifest is missing or changed'
      manifest_metadata_is_valid "$LFS_UPGRADE_SEED_MANIFEST" "$LFS_UPGRADE_SEED_MANIFEST_SIZE" \
        "$LFS_UPGRADE_SEED_MANIFEST_SHA256" "$LFS_UPGRADE_SEED_MANIFEST_ENTRIES" || die 'approved upgrade seed manifest is missing or changed'
      payload_manifest_check "$GAME_DIR" "$LFS_UPGRADE_MANIFEST" \
        "$LFS_UPGRADE_MANIFEST_SIZE" "$LFS_UPGRADE_MANIFEST_SHA256" "$LFS_UPGRADE_MANIFEST_ENTRIES" >/dev/null ||
        die 'approved predecessor executable found but its stock payload drifted; no files changed—repair it with the fallback wrapper before upgrading'
      source_manifest="$LFS_UPGRADE_MANIFEST"
      source_seed_manifest="$LFS_UPGRADE_SEED_MANIFEST"
      note 'Verified the complete immutable payload of the approved older LFS build; preserving player data during upgrade'
    else
      die "unrecognized LFS update detected ($actual_checksum); no files changed—run lfs-linux update-check and install a reviewed wrapper release"
    fi
  fi
  download_verified "official LFS $LFS_VERSION installer" "$LFS_INSTALLER_URL" "$INSTALLER" \
    "$LFS_INSTALLER_SIZE" "$LFS_INSTALLER_SHA256"
  rm -rf --one-file-system "$unpack"
  mkdir -p "$unpack"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  note 'Extracting untouched official LFS files into private staging'
  extract_lfs_payload "$INSTALLER" "$unpack" "$extract_log"
  verify_extracted_game_tree "$unpack" 'extracted LFS'
  if [[ ! -e "$GAME_DIR" ]]; then
    mkdir -p "$(dirname "$GAME_DIR")"
    mv "$unpack" "$GAME_DIR"
  else
    replace_game_tree "$unpack" "$source_manifest" "$source_seed_manifest" "$preservation_mode"
  fi
  ACTIVE_UNPACK=''
  trap - EXIT
  verify_game_tree "$GAME_DIR" 'installed LFS'
  use_packaged_game_baseline
}

write_marker() {
  local tmp="$INSTALL_MARKER.tmp" manifest_name
  manifest_name="$(basename "$ACTIVE_LFS_STOCK_MANIFEST")"
  umask 077
  if ! cat >"$tmp" <<EOF
LFS_BASELINE_KIND='$ACTIVE_BASELINE_KIND'
LFS_VERSION='$ACTIVE_LFS_VERSION'
LFS_CHANNEL='$LFS_CHANNEL'
LFS_EXE_SIZE='$ACTIVE_LFS_EXE_SIZE'
LFS_EXE_SHA256='$ACTIVE_LFS_EXE_SHA256'
LFS_STOCK_MANIFEST_NAME='$manifest_name'
LFS_STOCK_MANIFEST_SIZE='$ACTIVE_LFS_STOCK_MANIFEST_SIZE'
LFS_STOCK_MANIFEST_SHA256='$ACTIVE_LFS_STOCK_MANIFEST_SHA256'
LFS_STOCK_MANIFEST_ENTRIES='$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES'
LFS_PACKAGE_VERSION='$LFS_VERSION'
DXVK_VERSION='$DXVK_VERSION'
DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'
DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'
WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'
WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'
WINE_VERSION='$WINE_VERSION'
PREFIX_ARCH='win64'
EOF
  then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$INSTALL_MARKER"; then
    rm -f "$tmp"
    return 1
  fi
}

write_launch_session() {
  local log="$1" before_marker="$2" started_at="$3" session_id="$4" tmp="$LAUNCH_SESSION.tmp"
  [[ -n "$before_marker" ]] || before_marker='none'
  if ! cat >"$tmp" <<EOF
FORMAT_VERSION='1'
STATE='running'
SESSION_ID='$session_id'
STARTED_AT='$started_at'
BASELINE_KIND='$ACTIVE_BASELINE_KIND'
BASELINE_VERSION='$ACTIVE_LFS_VERSION'
BASELINE_EXE_SHA256='$ACTIVE_LFS_EXE_SHA256'
BASELINE_MANIFEST_SHA256='$ACTIVE_LFS_STOCK_MANIFEST_SHA256'
BEFORE_MARKER='$before_marker'
LOG_BASENAME='$(basename "$log")'
EOF
  then
    rm -f "$tmp"
    return 1
  fi
  chmod 0600 "$tmp"
  mv "$tmp" "$LAUNCH_SESSION"
}

launch_session_schema_is_valid() {
  awk -F= '
    BEGIN {
      split("FORMAT_VERSION STATE SESSION_ID STARTED_AT BASELINE_KIND BASELINE_VERSION BASELINE_EXE_SHA256 BASELINE_MANIFEST_SHA256 BEFORE_MARKER LOG_BASENAME", keys, " ")
      for (i in keys) expected[keys[i]] = 1
    }
    !($1 in expected) || seen[$1]++ { exit 1 }
    END {
      if (NR != 10) exit 1
      for (key in expected) if (seen[key] != 1) exit 1
    }
  ' "$LAUNCH_SESSION"
}

launch_session_is_valid() {
  local format state session_id started_at baseline_kind baseline_version baseline_exe_hash baseline_manifest_hash
  local before_marker log_basename log now start_event
  owner_private_regular_file "$LAUNCH_SESSION" || return 1
  launch_session_schema_is_valid || return 1
  format="$(metadata_value "$LAUNCH_SESSION" FORMAT_VERSION)" || return 1
  state="$(metadata_value "$LAUNCH_SESSION" STATE)" || return 1
  session_id="$(metadata_value "$LAUNCH_SESSION" SESSION_ID)" || return 1
  started_at="$(metadata_value "$LAUNCH_SESSION" STARTED_AT)" || return 1
  baseline_kind="$(metadata_value "$LAUNCH_SESSION" BASELINE_KIND)" || return 1
  baseline_version="$(metadata_value "$LAUNCH_SESSION" BASELINE_VERSION)" || return 1
  baseline_exe_hash="$(metadata_value "$LAUNCH_SESSION" BASELINE_EXE_SHA256)" || return 1
  baseline_manifest_hash="$(metadata_value "$LAUNCH_SESSION" BASELINE_MANIFEST_SHA256)" || return 1
  before_marker="$(metadata_value "$LAUNCH_SESSION" BEFORE_MARKER)" || return 1
  log_basename="$(metadata_value "$LAUNCH_SESSION" LOG_BASENAME)" || return 1
  [[ "$format" == '1' && "$state" == 'running' ]] || return 1
  [[ "$started_at" =~ ^[0-9]+$ ]] || return 1
  [[ "$session_id" =~ ^[0-9]+-[0-9]+$ && "$session_id" == "$started_at-"* ]] || return 1
  [[ "$baseline_kind" == "$ACTIVE_BASELINE_KIND" ]] || return 1
  [[ "$baseline_version" == "$ACTIVE_LFS_VERSION" ]] || return 1
  [[ "$baseline_exe_hash" == "$ACTIVE_LFS_EXE_SHA256" ]] || return 1
  [[ "$baseline_manifest_hash" == "$ACTIVE_LFS_STOCK_MANIFEST_SHA256" ]] || return 1
  [[ "$before_marker" == 'none' || "$before_marker" =~ ^[0-9]+[A-Z][0-9]*$ ]] || return 1
  [[ "$log_basename" =~ ^launch-[0-9]{8}-[0-9]{6}(-[0-9]+)?\.log$ ]] || return 1
  log="$LOG_DIR/$log_basename"
  owner_private_regular_file "$log" || return 1
  now="$(date +%s)"
  (( started_at <= now + 300 )) || return 1
  (( $(stat -c %Y "$log") >= started_at )) || return 1
  start_event="lfs-linux event=start session=$session_id started_at=$started_at baseline=$baseline_version baseline_kind=$baseline_kind before_marker=$before_marker "
  [[ "$(grep -Fc "$start_event" "$log")" == '1' ]]
}

record_game_update() {
  local before_marker="$1" require_stopped="${2:-0}" expected_manifest_hash="${3:-}"
  local after_marker temporary manifest_path manifest_size manifest_hash manifest_entries
  local exe_size exe_hash updated_version
  after_marker="$(game_version_marker)"
  version_marker_advanced "$before_marker" "$after_marker" || return 0
  if [[ "$require_stopped" == '1' ]] && prefix_is_running; then
    warn 'private Wine processes restarted before update inventory; previous baseline retained'
    return 1
  fi

  temporary="$(mktemp "$STATE_ROOT/.game-update.manifest.XXXXXX")"
  if ! snapshot_game_manifest "$GAME_DIR" "$temporary"; then
    rm -f "$temporary"
    warn 'could not inventory the completed in-game update; previous baseline retained'
    return 1
  fi
  manifest_size="$(stat -c %s "$temporary")"
  manifest_hash="$(sha256_of "$temporary")" || { rm -f "$temporary"; return 1; }
  if [[ -n "$expected_manifest_hash" && "$manifest_hash" != "$expected_manifest_hash" ]]; then
    rm -f "$temporary"
    warn 'protected LFS files changed after recovery confirmation; previous baseline retained'
    return 1
  fi
  manifest_entries="$(awk -F '\t' '$1 == "f" || $1 == "l" { count++ } END { print count + 0 }' "$temporary")"
  [[ "$manifest_entries" -gt 0 ]] || { rm -f "$temporary"; warn 'in-game update inventory was empty'; return 1; }
  grep -Fq $'\tLFS.exe' "$temporary" || { rm -f "$temporary"; warn 'in-game update removed LFS.exe'; return 1; }
  grep -Fq $'\t'"data/versions/$after_marker.txt" "$temporary" || {
    rm -f "$temporary"
    warn 'in-game update version marker was not part of the protected inventory'
    return 1
  }
  [[ -f "$GAME_EXE" && ! -L "$GAME_EXE" ]] || { rm -f "$temporary"; warn 'in-game update left no regular LFS.exe'; return 1; }
  exe_size="$(stat -c %s "$GAME_EXE")"
  exe_hash="$(sha256_of "$GAME_EXE")" || { rm -f "$temporary"; return 1; }
  manifest_metadata_is_valid "$temporary" "$manifest_size" "$manifest_hash" "$manifest_entries" || {
    rm -f "$temporary"
    warn 'in-game update inventory failed validation'
    return 1
  }
  if [[ "$require_stopped" == '1' ]] && prefix_is_running; then
    rm -f "$temporary"
    warn 'private Wine processes restarted during update inventory; previous baseline retained'
    return 1
  fi

  manifest_path="$STATE_ROOT/game-update-$manifest_hash.manifest"
  if [[ -e "$manifest_path" || -L "$manifest_path" ]]; then
    if ! owner_private_regular_file "$manifest_path" ||
       ! manifest_metadata_is_valid "$manifest_path" "$manifest_size" "$manifest_hash" "$manifest_entries"; then
      rm -f "$temporary"
      warn 'content-addressed in-game update manifest path is occupied or changed; previous baseline retained'
      return 1
    fi
    rm -f "$temporary"
  else
    if ! mv "$temporary" "$manifest_path"; then
      rm -f "$temporary"
      warn 'could not place content-addressed in-game update manifest; previous baseline retained'
      return 1
    fi
    chmod 0600 "$manifest_path"
  fi
  if [[ "$require_stopped" == '1' ]] && prefix_is_running; then
    warn 'private Wine processes restarted before update commit; previous baseline retained'
    return 1
  fi
  if [[ "${LFS_LINUX_TEST_FAIL_BEFORE_MARKER:-0}" == '1' ]]; then
    warn 'test fault before in-game update marker commit; previous baseline retained'
    return 1
  fi

  updated_version="0.$after_marker"
  ACTIVE_BASELINE_KIND='game-update'
  ACTIVE_LFS_VERSION="$updated_version"
  ACTIVE_LFS_EXE_SIZE="$exe_size"
  ACTIVE_LFS_EXE_SHA256="$exe_hash"
  ACTIVE_LFS_STOCK_MANIFEST="$manifest_path"
  ACTIVE_LFS_STOCK_MANIFEST_SIZE="$manifest_size"
  ACTIVE_LFS_STOCK_MANIFEST_SHA256="$manifest_hash"
  ACTIVE_LFS_STOCK_MANIFEST_ENTRIES="$manifest_entries"
  if [[ "$require_stopped" == '1' ]] && prefix_is_running; then
    warn 'private Wine processes restarted at update commit; previous baseline retained'
    return 1
  fi
  if ! write_marker; then
    warn 'could not commit in-game update marker; previous marker and manifest remain valid'
    return 1
  fi
  remove_local_game_manifests_except "$manifest_path" || warn 'kept an obsolete local game-update manifest after atomic marker commit'
  note "Recorded LFS $updated_version in-game update as the verified local launch baseline"
}

recover_game_update() {
  local before_marker after_marker log_basename log previous_version answer candidate_manifest
  local session_hash_before session_hash_after marker_hash log_hash session_id candidate_size candidate_hash candidate_entries
  require_unprivileged
  require_host_arch
  require_command awk
  require_command find
  require_command flock
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  open_launch_lock
  flock -n 9 || die 'LFS is already launching or running'
  require_wine
  [[ -f "$INSTALL_MARKER" && ! -L "$INSTALL_MARKER" ]] || die 'installation marker is missing or unsafe; run lfs-linux install'
  load_active_game_baseline || die 'installed LFS baseline metadata is missing or changed'
  active_game_marker_is_valid || die 'installation marker LFS baseline drift'
  [[ -f "$LAUNCH_SESSION" && ! -L "$LAUNCH_SESSION" ]] || die 'no interrupted trusted launch session is available for recovery'
  session_hash_before="$(sha256_of "$LAUNCH_SESSION")" || die 'could not hash interrupted launch-session evidence'
  launch_session_is_valid || die 'interrupted launch-session evidence is missing or changed; no files changed'
  before_marker="$(metadata_value "$LAUNCH_SESSION" BEFORE_MARKER)"
  log_basename="$(metadata_value "$LAUNCH_SESSION" LOG_BASENAME)"
  session_id="$(metadata_value "$LAUNCH_SESSION" SESSION_ID)"
  log="$LOG_DIR/$log_basename"
  session_hash_after="$(sha256_of "$LAUNCH_SESSION")" || die 'could not recheck interrupted launch-session evidence'
  [[ "$session_hash_before" == "$session_hash_after" ]] || die 'interrupted launch-session evidence changed during validation; no files changed'
  marker_hash="$(sha256_of "$INSTALL_MARKER")" || die 'could not hash installation marker'
  log_hash="$(sha256_of "$log")" || die 'could not hash interrupted launch log'
  if prefix_is_running; then
    die 'private Wine processes are still running; run lfs-linux stop first'
  fi
  [[ "$before_marker" != 'none' ]] || before_marker=''
  after_marker="$(game_version_marker)"
  version_marker_advanced "$before_marker" "$after_marker" || die 'no newer LFS version marker was produced by the interrupted session; no files changed'

  candidate_manifest="$(mktemp "$STATE_ROOT/.recovery-candidate.manifest.XXXXXX")"
  ACTIVE_RECOVERY_SNAPSHOT="$candidate_manifest"
  trap cleanup_active_recovery_snapshot EXIT
  snapshot_game_manifest "$GAME_DIR" "$candidate_manifest" || die 'could not snapshot protected LFS files before recovery confirmation; no files changed'
  candidate_size="$(stat -c %s "$candidate_manifest")"
  candidate_hash="$(sha256_of "$candidate_manifest")" || die 'could not hash protected LFS recovery snapshot; no files changed'
  candidate_entries="$(awk -F '\t' '$1 == "f" || $1 == "l" { count++ } END { print count + 0 }' "$candidate_manifest")"
  [[ "$candidate_entries" -gt 0 ]] || die 'protected LFS recovery snapshot was empty; no files changed'
  manifest_metadata_is_valid "$candidate_manifest" "$candidate_size" "$candidate_hash" "$candidate_entries" ||
    die 'protected LFS files changed during pre-confirmation snapshot; no files changed'
  grep -Fq $'\tLFS.exe' "$candidate_manifest" || die 'protected LFS recovery snapshot omitted LFS.exe; no files changed'
  grep -Fq $'\t'"data/versions/$after_marker.txt" "$candidate_manifest" ||
    die 'protected LFS recovery snapshot omitted the newer version marker; no files changed'
  if prefix_is_running; then
    die 'private Wine processes restarted during pre-confirmation snapshot; no files changed'
  fi
  [[ "$(game_version_marker)" == "$after_marker" ]] || die 'LFS version marker changed during pre-confirmation snapshot; no files changed'
  [[ "$(sha256_of "$LAUNCH_SESSION")" == "$session_hash_before" ]] || die 'interrupted launch-session evidence changed during pre-confirmation snapshot; no files changed'
  [[ "$(sha256_of "$INSTALL_MARKER")" == "$marker_hash" ]] || die 'installation marker changed during pre-confirmation snapshot; no files changed'
  [[ "$(sha256_of "$log")" == "$log_hash" ]] || die 'interrupted launch log changed during pre-confirmation snapshot; no files changed'
  launch_log_event "$log" "event=recovery-snapshot-ready session=$session_id marker=$after_marker snapshot=$candidate_hash"
  log_hash="$(sha256_of "$log")" || die 'could not bind interrupted launch log to recovery snapshot'

  if [[ "${LFS_LINUX_CONFIRM_UPDATE_RECOVERY:-0}" != '1' ]]; then
    [[ -t 0 ]] || die 'update recovery needs a terminal or LFS_LINUX_CONFIRM_UPDATE_RECOVERY=1'
    printf 'Trust protected LFS snapshot %s as update %s from the interrupted verified session? [y/N] ' "$candidate_hash" "$after_marker"
    read -r answer
    [[ "${answer,,}" == 'y' || "${answer,,}" == 'yes' ]] || { note 'Update recovery cancelled'; return 3; }
  fi
  if [[ -n "${LFS_LINUX_TEST_CONFIRMATION_DELAY_SECONDS:-}" ]]; then
    [[ "$LFS_LINUX_TEST_CONFIRMATION_DELAY_SECONDS" =~ ^[0-9]+([.][0-9]+)?$ ]] || die 'invalid recovery confirmation test delay'
    sleep "$LFS_LINUX_TEST_CONFIRMATION_DELAY_SECONDS"
  fi
  [[ "$(sha256_of "$LAUNCH_SESSION")" == "$session_hash_before" ]] || die 'interrupted launch-session evidence changed during confirmation; no files changed'
  [[ "$(sha256_of "$INSTALL_MARKER")" == "$marker_hash" ]] || die 'installation marker changed during confirmation; no files changed'
  [[ "$(sha256_of "$log")" == "$log_hash" ]] || die 'interrupted launch log changed during confirmation; no files changed'
  load_active_game_baseline || die 'installed LFS baseline changed during confirmation; no files changed'
  active_game_marker_is_valid || die 'installation marker baseline changed during confirmation; no files changed'
  launch_session_is_valid || die 'interrupted launch-session evidence became invalid during confirmation; no files changed'
  if prefix_is_running; then
    die 'private Wine processes restarted during confirmation; no files changed'
  fi
  [[ "$(game_version_marker)" == "$after_marker" ]] || die 'LFS version marker changed during confirmation; no files changed'
  previous_version="$ACTIVE_LFS_VERSION"
  launch_log_event "$log" "event=recovery-confirmed session=$session_id from=$previous_version marker=$after_marker snapshot=$candidate_hash"
  if prefix_is_running; then
    die 'private Wine processes restarted before recovery inventory; launch-session evidence retained'
  fi
  record_game_update "$before_marker" 1 "$candidate_hash" || die 'could not record the confirmed protected LFS snapshot; launch-session evidence retained'
  [[ "$ACTIVE_LFS_VERSION" != "$previous_version" ]] || die 'interrupted update did not produce a new baseline; launch-session evidence retained'
  launch_log_event "$log" "event=recovery-recorded session=$session_id version=$ACTIVE_LFS_VERSION snapshot=$candidate_hash"
  rm -f "$LAUNCH_SESSION" "$candidate_manifest"
  ACTIVE_RECOVERY_SNAPSHOT=''
  trap - EXIT
  note "Recovered LFS $ACTIVE_LFS_VERSION as the verified local launch baseline"
}

validate_installation() {
  require_wine
  [[ -f "$PREFIX/system.reg" ]] || die 'private prefix is missing; run lfs-linux install'
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || die 'prefix architecture drift; expected win64'
  [[ -f "$INSTALL_MARKER" ]] || die 'installation marker is missing; run lfs-linux install'
  load_active_game_baseline || die 'installed LFS baseline metadata is missing or changed; run lfs-linux install'
  if local_game_update_requires_upgrade; then
    die "verified local LFS $ACTIVE_LFS_VERSION requires audited $LFS_VERSION catch-up; run lfs-linux install"
  fi
  active_game_marker_is_valid || die 'installation marker LFS baseline drift'
  grep -Fqx "DXVK_VERSION='$DXVK_VERSION'" "$INSTALL_MARKER" || die 'installed DXVK release differs from wrapper manifest'
  grep -Fqx "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'" "$INSTALL_MARKER" || die 'installation marker DXVK d3d11 checksum drift'
  grep -Fqx "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'" "$INSTALL_MARKER" || die 'installation marker DXVK dxgi checksum drift'
  grep -Fqx "PREFIX_ARCH='win64'" "$INSTALL_MARKER" || die 'installation marker architecture drift'
  grep -Fqx "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'" "$INSTALL_MARKER" || die 'installed Wine runtime differs from wrapper manifest'
  grep -Fqx "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'" "$INSTALL_MARKER" || die 'installation marker Wine payload drift'
  grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER" || die 'Wine changed; run lfs-linux install to update the private prefix'
  verify_active_game_tree 'installed LFS'
  verify_file 'private DXVK d3d11 DLL' "$DXVK_D3D11" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'private DXVK dxgi DLL' "$DXVK_DXGI" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  verify_file 'prefix DXVK d3d11 DLL' "$PREFIX/drive_c/windows/syswow64/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'prefix DXVK dxgi DLL' "$PREFIX/drive_c/windows/syswow64/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
}

ready_fast() {
  detect_wine || return 1
  wine_runtime_layout_is_complete || return 1
  [[ -f "$STATE_SENTINEL" && -f "$PREFIX/system.reg" && -f "$INSTALL_MARKER" ]] || return 1
  load_active_game_baseline || return 1
  local_game_update_requires_upgrade && return 1
  active_game_tree_layout_is_complete || return 1
  active_game_marker_is_valid || return 1
  [[ -f "$DXVK_D3D11" && -f "$DXVK_DXGI" ]] || return 1
  [[ -f "$PREFIX/drive_c/windows/syswow64/d3d11.dll" && -f "$PREFIX/drive_c/windows/syswow64/dxgi.dll" ]] || return 1
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || return 1
  grep -Fqx "DXVK_VERSION='$DXVK_VERSION'" "$INSTALL_MARKER" || return 1
  grep -Fqx "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER" || return 1
}

setup_interactive() {
  local answer lfs_mib wine_mib dxvk_mib setup_heading lfs_step
  require_unprivileged
  require_command awk
  require_command find
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  validate_existing_game_source
  lfs_mib=$(( (LFS_INSTALLER_SIZE + 1048575) / 1048576 ))
  wine_mib=$(( (WINE_PACKAGE_SIZE + 1048575) / 1048576 ))
  dxvk_mib=$(( (DXVK_ARCHIVE_SIZE + 1048575) / 1048576 ))
  setup_heading='first-run setup'
  lfs_step="Download the official LFS $LFS_VERSION public-test installer from lfs.net ($lfs_mib MiB)."
  if [[ -e "$GAME_DIR" ]]; then
    setup_heading='verified setup / repair'
  fi
  if [[ "$ACTIVE_BASELINE_KIND" == 'game-update' ]]; then
    if local_game_update_requires_upgrade && [[ ! -e "$GAME_DIR" && -d "$GAME_BACKUP" ]]; then
      lfs_step="Recover the verified local LFS $ACTIVE_LFS_VERSION backup, then upgrade it to audited $LFS_VERSION while preserving complete player-owned paths and metadata."
    elif local_game_update_requires_upgrade && active_game_tree_is_complete; then
      lfs_step="Upgrade the verified local LFS $ACTIVE_LFS_VERSION baseline to audited $LFS_VERSION. Download the official $lfs_mib MiB installer, then preserve complete player-owned paths and metadata."
    elif local_game_update_requires_upgrade && game_tree_matches_audited_target_overlay; then
      lfs_step="Adopt the exact audited $LFS_VERSION files already produced over the verified $ACTIVE_LFS_VERSION baseline; no game installer download is needed."
    else
      lfs_step="Keep the verified local LFS $ACTIVE_LFS_VERSION in-game update; no older game payload replaces it."
    fi
  elif file_matches "$GAME_EXE" "$LFS_EXE_SIZE" "$LFS_EXE_SHA256" 2>/dev/null; then
    lfs_step="Verify existing official LFS $LFS_VERSION; download its $lfs_mib MiB installer only if repair is needed."
  fi
  cat <<EOF
Live for Speed Linux $setup_heading

This separate community launcher targets official LFS $LFS_VERSION:
$LFS_CHANNEL_LABEL. It is not the stable $LFS_FALLBACK_VERSION branch. Immutable
wrapper $LFS_FALLBACK_WRAPPER remains the old-graphics fallback.

It will:
  1. $lfs_step
  2. Provision audited Arch Wine $WINE_RUNTIME_VERSION from archive.archlinux.org ($wine_mib MiB)
     when that exact system runtime is unavailable.
  3. Download official DXVK $DXVK_VERSION from GitHub ($dxvk_mib MiB).
  4. Verify pinned archives, Wine files, and the active game baseline.
  5. Extract any needed untouched official game payload into:
     $PREFIX
  6. Install private DXVK D3D11/DXGI and preserve player-owned data during repairs.
  7. Record versioned in-game updates after a trusted LFS session exits, so later launches accept them.

An upgrade can temporarily use 12 GiB including both game trees, nested staging, and download cache. Live for Speed remains
proprietary and is governed by https://www.lfs.net/agreement. This wrapper is
unofficial and does not redistribute or patch the game.

EOF
  printf 'Continue with verified setup? [y/N] '
  read -r answer || return 3
  [[ "${answer,,}" == 'y' || "${answer,,}" == 'yes' ]] || { note 'Setup cancelled'; return 3; }
  install_all
}

install_all() {
  require_unprivileged
  require_host_arch
  require_command 7z
  require_command awk
  require_command bsdtar
  require_command curl
  require_command du
  require_command find
  require_command flock
  require_command gpgv
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  open_launch_lock
  flock -n 9 || die 'LFS is already launching, installing, or recovering'
  detect_wine 2>/dev/null || true
  if prefix_is_running; then
    die 'private Wine processes are running; run lfs-linux stop before install'
  fi
  recover_committed_predecessor_quarantine
  recover_interrupted_game_swap
  validate_existing_game_source
  ensure_wine_runtime
  require_wine
  init_prefix
  trap cleanup_install_transaction EXIT
  install_game
  install_dxvk
  write_marker
  if [[ "$ACTIVE_PREDECESSOR_QUARANTINE" == 'prepared' ]]; then
    ACTIVE_PREDECESSOR_QUARANTINE='committed'
    if [[ "${LFS_LINUX_TEST_FAIL_AFTER_OVERLAY_MARKER:-0}" == '1' ]]; then
      die 'test fault after package marker committed with predecessor quarantine'
    fi
    finalize_predecessor_quarantine
  fi
  if [[ "$ACTIVE_BASELINE_KIND" == 'game-update' ]]; then
    remove_local_game_manifests_except "$ACTIVE_LFS_STOCK_MANIFEST" ||
      warn 'kept an obsolete local game-update manifest after marker commit'
  else
    remove_local_game_manifests_except ||
      warn 'kept an obsolete local game-update manifest after package marker commit'
  fi
  rm -f "$LAUNCH_SESSION"
  trap - EXIT
  note 'Installation complete. Run: lfs-linux launch'
}

launch_game() {
  local log game_status wait_status record_status=0 final_status before_marker after_marker marker_for_log started_at session_id
  require_unprivileged
  require_host_arch
  require_command awk
  require_command cmp
  require_command find
  require_command flock
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  open_launch_lock
  if ! flock -n 9; then
    if command -v wmctrl >/dev/null 2>&1; then
      wmctrl -a 'Live for Speed' 2>/dev/null || true
    fi
    note 'LFS is already launching or running'
    return
  fi
  if game_is_running; then
    if command -v wmctrl >/dev/null 2>&1; then
      wmctrl -a 'Live for Speed' 2>/dev/null || true
    fi
    note 'LFS is already running'
    return
  fi
  if prefix_is_running; then
    die 'private Wine services remain; run lfs-linux stop before launch'
  fi
  validate_installation
  if prefix_is_running; then
    die 'private Wine services started during launch validation; run lfs-linux stop before launch'
  fi
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || die 'no graphical session is available'
  mkdir -p "$LOG_DIR" "$CACHE_DIR/dxvk-shaders"
  log="$LOG_DIR/launch-$(date +%Y%m%d-%H%M%S)-$$.log"
  ln -sfn "$(basename "$log")" "$LOG_DIR/latest.log"
  note "Starting verified LFS $ACTIVE_LFS_VERSION [$LFS_CHANNEL_LABEL] with $WINE_VERSION and private DXVK $DXVK_VERSION"
  before_marker="$(game_version_marker)"
  marker_for_log="${before_marker:-none}"
  started_at="$(date +%s)"
  session_id="$started_at-$$"
  write_launch_session "$log" "$before_marker" "$started_at" "$session_id"
  launch_log_event "$log" "event=start session=$session_id started_at=$started_at baseline=$ACTIVE_LFS_VERSION baseline_kind=$ACTIVE_BASELINE_KIND before_marker=$marker_for_log wine=$WINE_VERSION dxvk=$DXVK_VERSION"
  cd "$GAME_DIR"
  set +e
  env \
    WINEPREFIX="$PREFIX" \
    WINEDEBUG="${WINEDEBUG:--all}" \
    WINEDLLPATH="$WINE_LIB_DIR" \
    WINEDLLOVERRIDES="$WINE_DLL_OVERRIDES" \
    DXVK_LOG_PATH="$LOG_DIR" \
    DXVK_SHADER_CACHE_PATH="$CACHE_DIR/dxvk-shaders" \
    "$WINE_BIN" "$GAME_EXE" /windowed=yes 9>&- >>"$log" 2>&1
  game_status=$?
  set -e
  launch_log_event "$log" "event=wine-parent-exit status=$game_status"
  if wait_private_wineserver "$log" launch; then
    :
  else
    wait_status=$?
    launch_log_event "$log" "event=finish status=$wait_status reason=wine-wait-failed"
    warn 'Wine wait failed or private services remain; run lfs-linux stop before recovery'
    return "$wait_status"
  fi
  after_marker="$(game_version_marker)"
  record_game_update "$before_marker" || record_status=$?
  if (( record_status == 0 )); then
    if version_marker_advanced "$before_marker" "$after_marker"; then
      launch_log_event "$log" "event=update-recorded version=$ACTIVE_LFS_VERSION"
    else
      launch_log_event "$log" "event=update-none marker=${after_marker:-none}"
    fi
    rm -f "$LAUNCH_SESSION"
  else
    launch_log_event "$log" "event=update-record-failed status=$record_status marker=${after_marker:-none}"
  fi
  if (( game_status != 0 )); then
    warn "LFS exited with status $game_status; any completed versioned update was still checked"
  fi
  final_status="$game_status"
  (( record_status == 0 )) || final_status="$record_status"
  launch_log_event "$log" "event=finish status=$final_status"
  return "$final_status"
}

stop_game() {
  local window
  local -a pid_list=()
  require_unprivileged
  require_command timeout
  require_wine
  prefix_is_running || { note 'LFS is already stopped'; return; }
  window=''
  if game_is_running && [[ -n "${DISPLAY:-}" ]] && command -v xdotool >/dev/null 2>&1; then
    window="$(xdotool search --onlyvisible --name '^Live for Speed$' 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -n "$window" ]]; then
    xdotool windowactivate --sync "$window" 2>/dev/null || true
    xdotool key --clearmodifiers alt+F4
    if wait_for_exit 5 && wait_for_prefix_exit 5; then
      note 'LFS stopped cleanly via window close'
      return
    fi
    window="$(xdotool search --onlyvisible --name '^Live for Speed$' 2>/dev/null | head -n 1 || true)"
    if game_is_running && [[ -n "$window" ]]; then
      xdotool windowactivate --sync "$window" 2>/dev/null || true
      xdotool key --clearmodifiers t
      xdotool type --clearmodifiers --delay 20 '/exit'
      xdotool key --clearmodifiers Return
      if wait_for_exit 10 && wait_for_prefix_exit 5; then
        note 'LFS stopped cleanly'
        return
      fi
    fi
  fi
  warn 'clean in-game exit was unavailable; stopping only the private Wine prefix'
  kill_private_wineserver
  if wait_for_prefix_exit 5; then
    note 'Private Wine prefix stopped'
    return
  fi
  mapfile -t pid_list < <(prefix_processes)
  (( ${#pid_list[@]} == 0 )) || kill -TERM "${pid_list[@]}" 2>/dev/null || true
  wait_for_prefix_exit 3 || die 'private prefix processes did not stop'
  note 'Private Wine prefix stopped'
}

run_doctor() {
  local failures=0 version_output loader_summary wine_available=0 file_tools_available=1 game_baseline_available=0
  pass() { printf '[PASS] %s\n' "$*"; }
  fail_check() { printf '[FAIL] %s\n' "$*"; failures=$((failures + 1)); }
  info() { printf '[INFO] %s\n' "$*"; }
  check_file() {
    local label="$1" path="$2" expected_size="$3" expected_hash="$4" actual_size actual_hash
    if [[ ! -f "$path" ]]; then fail_check "$label missing"; return; fi
    actual_size="$(stat -c %s "$path")"
    if [[ "$actual_size" != "$expected_size" ]]; then fail_check "$label size drift"; return; fi
    if ! actual_hash="$(sha256_of "$path")"; then fail_check "$label hashing failed or timed out"; return; fi
    if [[ "$actual_hash" == "$expected_hash" ]]; then pass "$label size and checksum"; else fail_check "$label checksum drift"; fi
  }
  check_marker() {
    local label="$1" expected_line="$2"
    if grep -Fqx "$expected_line" "$INSTALL_MARKER"; then pass "$label"; else fail_check "$label drift"; fi
  }
  check_payload() {
    local label="$1" root="$2" manifest="$3" manifest_size="$4" manifest_hash="$5" entries="$6" issue
    if issue="$(payload_manifest_check "$root" "$manifest" "$manifest_size" "$manifest_hash" "$entries")"; then
      pass "$label: all $entries protected entries"
    else
      fail_check "$label drift: $issue"
    fi
  }
  check_game_tree_metrics() {
    local file_count tree_bytes
    if [[ ! -d "$GAME_DIR" ]]; then fail_check 'stock LFS tree missing'; return; fi
    file_count="$(find "$GAME_DIR" -type f -printf . | wc -c)"
    tree_bytes="$(du -sb "$GAME_DIR" | awk '{print $1}')"
    if (( file_count >= LFS_TREE_MIN_FILE_COUNT )); then pass "stock LFS tree file count: $file_count"; else fail_check "stock LFS tree incomplete: $file_count files"; fi
    if (( tree_bytes >= LFS_TREE_MIN_BYTES )); then pass "stock LFS tree bytes: $tree_bytes"; else fail_check "stock LFS tree incomplete: $tree_bytes bytes"; fi
  }

  if [[ "$(uname -m)" == 'x86_64' ]]; then
    pass 'host architecture: x86_64'
  else
    fail_check "unsupported host architecture: $(uname -m)"
  fi
  if detect_wine 2>/dev/null; then
    wine_available=1
    pass "exact Wine runtime: $WINE_RUNTIME_VERSION ($WINE_VERSION)"
  else
    fail_check "exact audited Wine $WINE_RUNTIME_VERSION is unavailable"
  fi
  if command -v 7z >/dev/null 2>&1; then pass '7z available'; else fail_check '7z missing'; fi
  if command -v bsdtar >/dev/null 2>&1; then pass 'bsdtar available'; else fail_check 'bsdtar missing'; fi
  if command -v curl >/dev/null 2>&1; then pass 'curl available'; else fail_check 'curl missing'; fi
  if command -v gpgv >/dev/null 2>&1; then pass 'gpgv available'; else fail_check 'gpgv missing'; fi
  if command -v flock >/dev/null 2>&1; then pass 'flock available'; else fail_check 'flock missing'; fi
  if ! command -v awk >/dev/null 2>&1 || ! command -v du >/dev/null 2>&1 || \
     ! command -v find >/dev/null 2>&1 || ! command -v mktemp >/dev/null 2>&1 || \
     ! command -v readlink >/dev/null 2>&1 || ! command -v stat >/dev/null 2>&1 || \
     ! command -v sha256sum >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
    fail_check 'file verification tools missing'
    file_tools_available=0
  fi
  if (( file_tools_available )); then
    check_file 'Arch Wine signing key' "$WINE_SIGNING_KEY" "$WINE_SIGNING_KEY_SIZE" "$WINE_SIGNING_KEY_SHA256"
  fi
  if (( wine_available && file_tools_available )); then
    check_payload "Wine $WINE_RUNTIME_VERSION payload" "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
      "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  fi
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then pass 'graphical session available'; else info 'no graphical session in current shell'; fi
  if command -v vulkaninfo >/dev/null 2>&1; then
    loader_summary="$(vulkaninfo --summary 2>/dev/null || true)"
    if grep -Fq 'deviceName' <<<"$loader_summary"; then pass 'Vulkan device available'; else fail_check 'Vulkan exposes no device'; fi
  else
    info 'vulkaninfo unavailable; runtime launch remains the behavioral Vulkan check'
  fi
  if [[ -d "$STATE_ROOT" ]]; then
    pass "user state: $STATE_ROOT"
    if [[ -f "$STATE_SENTINEL" ]]; then pass 'managed-state sentinel'; else fail_check 'managed-state sentinel missing'; fi
    if [[ -f "$PREFIX/system.reg" ]] && grep -Fq '#arch=win64' "$PREFIX/system.reg"; then
      pass 'prefix architecture: win64'
    else
      fail_check 'prefix architecture missing or drifted'
    fi
    if [[ -f "$INSTALL_MARKER" ]]; then
      pass 'installation marker present'
      if load_active_game_baseline; then
        game_baseline_available=1
        pass "game baseline metadata: $ACTIVE_LFS_VERSION ($ACTIVE_BASELINE_KIND)"
        if active_game_marker_is_valid; then pass 'marker active LFS baseline'; else fail_check 'marker active LFS baseline drift'; fi
      else
        fail_check 'game baseline metadata missing or changed'
      fi
      check_marker 'marker LFS channel' "LFS_CHANNEL='$LFS_CHANNEL'"
      check_marker 'marker DXVK release' "DXVK_VERSION='$DXVK_VERSION'"
      check_marker 'marker DXVK d3d11 checksum' "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'"
      check_marker 'marker DXVK dxgi checksum' "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'"
      check_marker 'marker prefix architecture' "PREFIX_ARCH='win64'"
      check_marker 'marker Wine runtime' "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'"
      check_marker 'marker Wine payload' "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'"
      if (( wine_available )); then check_marker 'marker Wine output' "WINE_VERSION='$WINE_VERSION'"; fi
    else
      fail_check 'installation marker missing'
    fi
    if (( file_tools_available )); then
      if (( game_baseline_available )); then
        check_payload "$ACTIVE_BASELINE_KIND LFS payload" "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST" \
          "$ACTIVE_LFS_STOCK_MANIFEST_SIZE" "$ACTIVE_LFS_STOCK_MANIFEST_SHA256" "$ACTIVE_LFS_STOCK_MANIFEST_ENTRIES"
        check_file "$ACTIVE_BASELINE_KIND LFS.exe" "$GAME_EXE" "$ACTIVE_LFS_EXE_SIZE" "$ACTIVE_LFS_EXE_SHA256"
        if [[ "$ACTIVE_BASELINE_KIND" == 'package' ]]; then
          check_file 'stock default helmet' "$GAME_DIR/$LFS_REQUIRED_HELMET_PATH" "$LFS_REQUIRED_HELMET_SIZE" "$LFS_REQUIRED_HELMET_SHA256"
          check_file 'stock Blackwood track' "$GAME_DIR/$LFS_REQUIRED_TRACK_PATH" "$LFS_REQUIRED_TRACK_SIZE" "$LFS_REQUIRED_TRACK_SHA256"
          check_file 'stock demo vehicle' "$GAME_DIR/$LFS_REQUIRED_VEHICLE_PATH" "$LFS_REQUIRED_VEHICLE_SIZE" "$LFS_REQUIRED_VEHICLE_SHA256"
          check_game_tree_metrics
        elif game_inventory_matches_manifest "$GAME_DIR" "$ACTIVE_LFS_STOCK_MANIFEST"; then
          pass 'recorded in-game update inventory'
        else
          fail_check 'recorded in-game update inventory drift'
        fi
      fi
      check_file 'private DXVK d3d11' "$DXVK_D3D11" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
      check_file 'private DXVK dxgi' "$DXVK_DXGI" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
      check_file 'prefix DXVK d3d11' "$PREFIX/drive_c/windows/syswow64/d3d11.dll" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
      check_file 'prefix DXVK dxgi' "$PREFIX/drive_c/windows/syswow64/dxgi.dll" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
    fi
  else
    info 'not installed yet'
  fi
  if game_is_running; then
    info 'LFS is running in the private prefix'
  elif prefix_is_running; then
    info 'private Wine services remain; run lfs-linux stop before recovery'
  else
    info 'private prefix is stopped'
  fi
  version_output="wrapper $LFS_LINUX_VERSION; LFS $ACTIVE_LFS_VERSION ($ACTIVE_BASELINE_KIND, $LFS_CHANNEL_LABEL); Wine $WINE_RUNTIME_VERSION; DXVK $DXVK_VERSION"
  info "$version_output"
  printf '\nDoctor summary: %d failure(s)\n' "$failures"
  (( failures == 0 ))
}

show_status() {
  detect_wine 2>/dev/null || true
  load_active_game_baseline 2>/dev/null || use_packaged_game_baseline
  printf 'Wrapper:    %s\n' "$LFS_LINUX_VERSION"
  printf 'LFS pin:    %s\n' "$LFS_VERSION"
  printf 'Installed:  %s (%s baseline)\n' "$ACTIVE_LFS_VERSION" "$ACTIVE_BASELINE_KIND"
  printf 'Channel:    %s\n' "$LFS_CHANNEL_LABEL"
  printf 'Fallback:   %s (LFS %s old graphics)\n' "$LFS_FALLBACK_WRAPPER" "$LFS_FALLBACK_VERSION"
  printf 'DXVK pin:   %s\n' "$DXVK_VERSION"
  printf 'Wine pin:   %s\n' "$WINE_RUNTIME_VERSION"
  printf 'Wine:       %s\n' "${WINE_VERSION:-missing}"
  printf 'State:      %s\n' "$STATE_ROOT"
  printf 'Game:       %s\n' "$GAME_EXE"
  printf 'Logs:       %s\n' "$LOG_DIR"
  [[ ! -f "$LAUNCH_SESSION" ]] || printf 'Recovery:   interrupted launch evidence present\n'
  if game_is_running; then
    printf 'Process:    LFS running\n'
  elif prefix_is_running; then
    printf 'Process:    Wine services remain (run lfs-linux stop)\n'
  else
    printf 'Process:    stopped\n'
  fi
}

update_check() {
  local page latest_stable public_family public_installer public_build expected_line
  if [[ -n "${LFS_LINUX_DOWNLOADS_PAGE_FILE:-}" ]]; then
    [[ -r "$LFS_LINUX_DOWNLOADS_PAGE_FILE" ]] || die "downloads-page fixture is unreadable: $LFS_LINUX_DOWNLOADS_PAGE_FILE"
    page="$(<"$LFS_LINUX_DOWNLOADS_PAGE_FILE")"
  else
    require_command curl
    page="$(curl --fail --location --silent --show-error --max-time 30 https://www.lfs.net/downloads)" || die 'could not fetch official LFS downloads page'
  fi
  latest_stable="$(grep -Eo 'title="Latest Version : [^"]+' <<<"$page" | head -n 1 | sed 's/.*: //' || true)"
  public_family="$(grep -Eo 'Live for Speed [0-9][^< ]* \(PUBLIC TEST\)' <<<"$page" | head -n 1 | sed -E 's/^Live for Speed ([^ ]+).*/\1/' || true)"
  public_installer=''
  public_build=''
  if [[ -n "$public_family" ]]; then
    public_installer="$(
      { grep -Eo 'LFS_S3_[0-9][A-Z][0-9]*_setup\.exe' <<<"$page" || true; } |
        while IFS= read -r candidate; do
          candidate="0.${candidate#LFS_S3_}"
          candidate="${candidate%_setup.exe}"
          if [[ "$candidate" == "$public_family"* ]]; then
            printf 'LFS_S3_%s_setup.exe\n' "${candidate#0.}"
            break
          fi
        done
    )"
    if [[ -n "$public_installer" ]]; then
      public_build="${public_installer#LFS_S3_}"
      public_build="0.${public_build%_setup.exe}"
    fi
  fi
  expected_line="$LFS_INSTALLER_NAME"
  printf 'Audited target: %s (%s, %s)\n' "$LFS_VERSION" "$LFS_CHANNEL" "$expected_line"
  printf 'Website stable: %s (old graphics)\n' "${latest_stable:-unknown}"
  if [[ -n "$public_family" ]]; then
    printf 'Website test:   %s (new graphics public test; %s)\n' "${public_build:-$public_family}" "${public_installer:-installer unknown}"
  fi

  if [[ "$LFS_CHANNEL" == 'public-test' ]]; then
    if [[ "$public_build" == "$LFS_VERSION" && "$public_family" == "$LFS_PUBLIC_TEST_FAMILY" && "$page" == *"$expected_line"* ]]; then
      printf 'Status:         current public-test pin\n'
      return
    fi
    printf 'Status:         public-test update or drift detected; review bootstrap pins (recorded in-game updates remain launchable)\n'
    return 2
  fi

  if [[ "$latest_stable" == "$LFS_VERSION" && "$page" == *"$expected_line"* && -z "$public_build" ]]; then
    printf 'Status:         current stable pin\n'
    return
  fi
  if [[ "$latest_stable" == "$LFS_VERSION" && "$page" == *"$expected_line"* && -n "$public_build" ]]; then
    printf 'Status:         new-graphics public test available (%s); wrapper made no game-file changes\n' "$public_build"
    return 2
  fi
  printf 'Status:         stable-channel update or drift detected; wrapper made no game-file changes\n'
  return 2
}

verify_sources() {
  local unpack
  require_unprivileged
  require_command 7z
  require_command bsdtar
  require_command curl
  require_command du
  require_command find
  require_command gpgv
  require_command sha256sum
  require_command stat
  require_command timeout
  download_verified "official LFS $LFS_VERSION installer" "$LFS_INSTALLER_URL" "$INSTALLER" \
    "$LFS_INSTALLER_SIZE" "$LFS_INSTALLER_SHA256"
  download_verified "audited Arch Wine $WINE_RUNTIME_VERSION package" "$WINE_PACKAGE_URL" "$WINE_PACKAGE" \
    "$WINE_PACKAGE_SIZE" "$WINE_PACKAGE_SHA256"
  download_verified "Arch Wine $WINE_RUNTIME_VERSION package signature" "$WINE_PACKAGE_SIGNATURE_URL" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  verify_wine_package_signature
  download_verified 'DXVK archive' "$DXVK_ARCHIVE_URL" "$DXVK_ARCHIVE" \
    "$DXVK_ARCHIVE_SIZE" "$DXVK_ARCHIVE_SHA256"
  unpack="$(mktemp -d "$CACHE_DIR/.verify-payloads.XXXXXX")"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  mkdir -p "$unpack/lfs"
  extract_lfs_payload "$INSTALLER" "$unpack/lfs" "$unpack/lfs-extract.log"
  verify_extracted_game_tree "$unpack/lfs" 'verified-source LFS'
  rm -rf --one-file-system "$unpack/lfs"
  mkdir -p "$unpack/wine"
  extract_bsdtar_archive "$WINE_PACKAGE" "$unpack/wine" "Arch Wine $WINE_RUNTIME_VERSION package"
  verify_payload_manifest "verified-source Wine $WINE_RUNTIME_VERSION runtime" "$unpack/wine" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  rm -rf --one-file-system "$unpack/wine"
  extract_bsdtar_archive "$DXVK_ARCHIVE" "$unpack" 'DXVK archive'
  verify_file 'DXVK d3d11 x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'DXVK dxgi x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  rm -rf --one-file-system "$unpack"
  ACTIVE_UNPACK=''
  trap - EXIT
  note 'All pinned upstream archive bytes, signatures, complete official seed files, and extracted runtime manifests are verified'
}

purge_cache() {
  require_unprivileged
  rm -f "$INSTALLER" "$INSTALLER.part" "$WINE_PACKAGE" "$WINE_PACKAGE.part" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE.part" "$DXVK_ARCHIVE" "$DXVK_ARCHIVE.part"
  rm -rf "$CACHE_DIR/dxvk-shaders" "$CACHE_DIR"/.dxvk-unpack.* "$CACHE_DIR"/.verify-payloads.*
  note "Removed wrapper-managed cache: $CACHE_DIR"
}

remove_state() {
  local answer
  require_unprivileged
  require_command flock
  require_command stat
  [[ -d "$STATE_ROOT" ]] || { note 'No user installation exists'; return; }
  [[ -f "$STATE_SENTINEL" ]] || die 'state directory is not marked as managed; refusing removal'
  open_launch_lock
  flock -n 9 || die 'LFS is already launching, installing, or recovering'
  detect_wine 2>/dev/null || true
  if prefix_is_running; then
    die 'private Wine processes are running; run lfs-linux stop first'
  fi
  if [[ "${LFS_LINUX_CONFIRM_REMOVE:-0}" != '1' ]]; then
    [[ -t 0 ]] || die 'removal needs a terminal or LFS_LINUX_CONFIRM_REMOVE=1'
    printf 'Remove the complete Live for Speed Linux prefix and game-owned player data at %s? [y/N] ' "$STATE_ROOT"
    read -r answer
    [[ "$answer" == 'y' || "$answer" == 'Y' ]] || { note 'Removal cancelled'; return; }
  fi
  rm -rf --one-file-system "$PREFIX" "$RUNTIME_DIR"
  remove_local_game_manifests_except
  rm -f -- "$INSTALL_MARKER" "$LAUNCH_SESSION" "$STATE_SENTINEL"
  rmdir -- "$STATE_ROOT" 2>/dev/null || warn 'kept unrecognized files in the state directory'
  note 'Removed user installation. Wrapper package remains installed.'
}

validate_paths

case "${1:-launch}" in
  setup) setup_interactive ;;
  install) install_all ;;
  launch) launch_game ;;
  recover-update) recover_game_update ;;
  stop) stop_game ;;
  doctor) run_doctor ;;
  status) show_status ;;
  update-check) update_check ;;
  verify-sources) verify_sources ;;
  ready) ready_fast ;;
  remove) remove_state ;;
  purge-cache) purge_cache ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
