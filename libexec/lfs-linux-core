#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly PROGRAM_NAME='lfs-linux'
CORE_EXECUTABLE="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly CORE_EXECUTABLE
(( EUID != 0 )) || { printf '%s: error: do not run per-user LFS commands as root\n' "$PROGRAM_NAME" >&2; exit 1; }
readonly DATA_DIR="${LFS_LINUX_DATA_DIR:-/usr/share/lfs-linux}"
readonly RELEASE_FILE="$DATA_DIR/release.env"
[[ -r "$RELEASE_FILE" ]] || { printf '%s: release manifest not found: %s\n' "$PROGRAM_NAME" "$RELEASE_FILE" >&2; exit 1; }
# shellcheck source=/dev/null
source "$RELEASE_FILE"

readonly STATE_ROOT="${LFS_LINUX_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/lfs-linux}"
readonly PREFIX="$STATE_ROOT/prefix"
readonly GAME_DIR="$PREFIX/drive_c/LFS"
readonly GAME_EXE="$GAME_DIR/LFS.exe"
readonly LFS_STOCK_MANIFEST="$DATA_DIR/$LFS_STOCK_MANIFEST_NAME"
readonly LFS_STOCK_SEED_MANIFEST="$DATA_DIR/$LFS_STOCK_SEED_MANIFEST_NAME"
readonly LFS_NESTED_MANIFEST="$DATA_DIR/$LFS_NESTED_MANIFEST_NAME"
readonly RUNTIME_DIR="$STATE_ROOT/runtime"
readonly PRIVATE_WINE_ROOT="$RUNTIME_DIR/wine-$WINE_RUNTIME_VERSION"
readonly PRIVATE_WINE_BIN="$PRIVATE_WINE_ROOT/usr/bin/wine"
readonly WINE_RUNTIME_MANIFEST="$DATA_DIR/$WINE_RUNTIME_MANIFEST_NAME"
readonly DXVK_DIR="$RUNTIME_DIR/dxvk-$DXVK_VERSION"
readonly DXVK_D3D11="$DXVK_DIR/x32/d3d11.dll"
readonly DXVK_DXGI="$DXVK_DIR/x32/dxgi.dll"
readonly CACHE_DIR="${LFS_LINUX_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/lfs-linux}"
readonly LOG_DIR="${LFS_LINUX_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lfs-linux}"
readonly LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/lfs-linux-${UID}"
readonly INSTALLER="$CACHE_DIR/$LFS_INSTALLER_NAME"
readonly WINE_PACKAGE="$CACHE_DIR/$WINE_PACKAGE_NAME"
readonly WINE_PACKAGE_SIGNATURE="$CACHE_DIR/$WINE_PACKAGE_SIGNATURE_NAME"
readonly WINE_SIGNING_KEY="$DATA_DIR/$WINE_SIGNING_KEY_NAME"
readonly DXVK_ARCHIVE="$CACHE_DIR/$DXVK_ARCHIVE_NAME"
readonly INSTALL_MARKER="$STATE_ROOT/install.env"
readonly LEGACY_LOCAL_GAME_MANIFEST="$STATE_ROOT/game-update.manifest"
readonly LAUNCH_SESSION="$STATE_ROOT/launch-session.env"
readonly STATE_SENTINEL="$STATE_ROOT/.managed-by-lfs-linux"
readonly GAME_BACKUP="$STATE_ROOT/.lfs-game-backup"
readonly DXVK_OVERRIDE='native,builtin'
readonly WINE_DLL_OVERRIDES="mscoree,mshtml=;d3d11=$DXVK_OVERRIDE;dxgi=$DXVK_OVERRIDE"

WINE_BIN=''
WINE_SERVER=''
WINE_VERSION=''
WINE_ROOT=''
WINE_LIB_DIR=''
ACTIVE_UNPACK=''
GUI_ERROR_KIND='failed'
INSTALL_ACTIVE=0

cleanup_active_unpack() {
  [[ -z "$ACTIVE_UNPACK" ]] || rm -rf --one-file-system "$ACTIVE_UNPACK"
}

usage() {
  cat <<'EOF'
Usage: lfs-linux <command>

Commands:
  setup         Explain downloads, ask once, install or repair, then return
  install       Install or repair directly after an explicit CLI command
  launch        Validate the installation and start Live for Speed
  recover-update  Explain that updates no longer need wrapper recovery
  stop          Request a clean exit, then stop only this private Wine prefix
  doctor        Check host, manifest, prefix, DXVK, game, and graphics prerequisites
  status        Show paths, versions, and process state
  update-check  Report official LFS download-page changes without modifying state
  verify-sources  Download and verify pinned LFS and DXVK release inputs
  ready         Check whether desktop first-run setup is complete
  remove        Remove runtime/prefix state after explicit confirmation
  purge-cache   Remove downloaded installer and DXVK archives
  help          Show this help

Environment:
  LFS_LINUX_STATE_DIR   Override per-user installation directory
  LFS_LINUX_CACHE_DIR   Override download cache
  LFS_LINUX_LOG_DIR     Override runtime log directory
  LFS_LINUX_WINE        Select the exact audited Wine executable
  LFS_LINUX_CONFIRM_REMOVE=1  Confirm non-interactive removal
EOF
}

note() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
ui_event() {
  [[ "${LFS_LINUX_GUI_EVENTS:-0}" == '1' ]] || return 0
  (trap '' PIPE; printf '%s\t%s\n' "$1" "${2:-}" >&3) 2>/dev/null || true
}

die() { ui_event error "$GUI_ERROR_KIND"; printf 'error: %s\n' "$*" >&2; exit 1; }

cancel_install() {
  trap '' INT TERM
  if (( INSTALL_ACTIVE )); then kill_private_wineserver; fi
  cleanup_active_unpack
  exit 130
}

launch_log_event() {
  local log="$1"
  shift
  [[ -n "$log" ]] || return 0
  printf '%s lfs-linux %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}

owner_private_regular_file() {
  local path="$1" mode
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c %u "$path")" == "$UID" ]] || return 1
  mode="$(stat -c %a "$path")"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  (( (8#$mode & 077) == 0 ))
}

open_launch_lock() {
  local lock_file="$LOCK_DIR/launch.lock" mode
  if [[ -e "$LOCK_DIR" || -L "$LOCK_DIR" ]]; then
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || die "unsafe launch lock directory: $LOCK_DIR"
  elif ! mkdir -m 0700 -- "$LOCK_DIR" 2>/dev/null; then
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || die "could not create safe launch lock directory: $LOCK_DIR"
  fi
  [[ "$(stat -c %u "$LOCK_DIR")" == "$UID" ]] || die "launch lock directory is not owned by the current user: $LOCK_DIR"
  mode="$(stat -c %a "$LOCK_DIR")"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "launch lock directory mode is invalid: $LOCK_DIR"
  (( (8#$mode & 077) == 0 )) || die "launch lock directory is accessible by other users: $LOCK_DIR"
  chmod 0700 -- "$LOCK_DIR"

  if [[ -e "$lock_file" || -L "$lock_file" ]]; then
    owner_private_regular_file "$lock_file" || die "unsafe launch lock file: $lock_file"
  elif ! (set -o noclobber; : >"$lock_file") 2>/dev/null; then
    owner_private_regular_file "$lock_file" || die "could not create safe launch lock file: $lock_file"
  fi
  chmod 0600 -- "$lock_file"
  exec 9<>"$lock_file" || die "could not open launch lock file: $lock_file"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_host_arch() {
  [[ "$(uname -m)" == 'x86_64' ]] || die "unsupported host architecture: $(uname -m); x86_64 is required"
}

require_unprivileged() {
  (( EUID != 0 )) || die 'do not run per-user LFS commands as root'
}

validate_paths() {
  local path
  for path in "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"; do
    [[ "$path" == /* ]] || die "XDG and override paths must be absolute: $path"
    [[ "$path" != '/' && "$path" != "$HOME" ]] || die "unsafe managed path: $path"
  done
}

sha256_of() {
  local output
  output="$(timeout --foreground --kill-after=10s 1800 sha256sum -- "$1")" || return 1
  awk '{print $1}' <<<"$output"
}

verify_file() {
  local label="$1" path="$2" size="$3" checksum="$4" actual_size actual_checksum
  [[ -f "$path" ]] || die "$label is missing: $path"
  actual_size="$(stat -c %s "$path")"
  [[ "$actual_size" == "$size" ]] || die "$label size drift: expected $size, found $actual_size"
  actual_checksum="$(sha256_of "$path")" || die "$label hashing failed or exceeded 1800 seconds"
  [[ "$actual_checksum" == "$checksum" ]] || die "$label checksum drift: expected $checksum, found $actual_checksum"
}

file_matches() {
  local path="$1" expected_size="$2" expected_hash="$3"
  [[ -f "$path" ]] || return 1
  [[ "$(stat -c %s "$path")" == "$expected_size" ]] || return 1
  [[ "$(sha256_of "$path")" == "$expected_hash" ]]
}

payload_manifest_check() {
  local root="$1" manifest="$2" manifest_size="$3" manifest_hash="$4" expected_entries="$5" mode="${6:-full}"
  local type expected expected_size relative actual entry_count checks output
  file_matches "$manifest" "$manifest_size" "$manifest_hash" || { printf 'manifest missing or changed: %s\n' "$manifest"; return 1; }
  [[ -d "$root" ]] || { printf 'payload root missing: %s\n' "$root"; return 1; }
  entry_count="$(awk -F '\t' '$1 == "f" || $1 == "l" { count++ } END { print count + 0 }' "$manifest")"
  [[ "$entry_count" == "$expected_entries" ]] || { printf 'manifest entry-count drift: expected %s, found %s\n' "$expected_entries" "$entry_count"; return 1; }
  awk -F '\t' '($1 == "f" || $1 == "l") && ($4 == "" || $4 ~ /^\// || $4 ~ /(^|\/)\.\.(\/|$)/) { exit 1 }' "$manifest" || {
    printf 'unsafe path in payload manifest\n'
    return 1
  }
  while IFS=$'\t' read -r type expected expected_size relative; do
    case "$type" in
      f)
        [[ -f "$root/$relative" && ! -L "$root/$relative" ]] || { printf 'required stock file missing: %s\n' "$relative"; return 1; }
        ;;
      l)
        [[ -L "$root/$relative" ]] || { printf 'required runtime link missing: %s\n' "$relative"; return 1; }
        actual="$(readlink -- "$root/$relative")"
        [[ "$actual" == "$expected" ]] || { printf 'runtime link drift: %s\n' "$relative"; return 1; }
        ;;
    esac
  done <"$manifest"
  [[ "$mode" == 'layout' ]] && return
  checks="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-checks.XXXXXX")"
  awk -F '\t' '$1 == "f" { print $2 "  " $4 }' "$manifest" >"$checks"
  if ! output="$(cd "$root" && timeout --foreground --kill-after=10s 1800 sha256sum --check --quiet "$checks" 2>&1)"; then
    rm -f "$checks"
    printf '%s\n' "${output:-payload checksum drift}"
    return 1
  fi
  rm -f "$checks"
}

verify_payload_manifest() {
  local label="$1" root="$2" manifest="$3" manifest_size="$4" manifest_hash="$5" entries="$6" issue
  if ! issue="$(payload_manifest_check "$root" "$manifest" "$manifest_size" "$manifest_hash" "$entries")"; then
    die "$label drift: $issue"
  fi
}

archive_member_listing_is_safe() {
  local listing="$1" normalized duplicate
  normalized="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-archive-paths.XXXXXX")"
  if ! LC_ALL=C awk '
    function reject(reason, path) {
      printf "%s: %s\n", reason, path > "/dev/stderr"
      bad = 1
    }
    {
      path = $0
      sub(/\r$/, "", path)
      if (path == "." || path == "./") next
      if (path == "" || path ~ /[[:cntrl:]]/) {
        reject("empty or control-character archive member", path)
        next
      }
      gsub(/\\/, "/", path)
      if (path ~ /^\// || path ~ /^[[:alpha:]]:/) {
        reject("absolute archive member", path)
        next
      }
      count = split(path, part, "/")
      output = ""
      unsafe = 0
      for (i = 1; i <= count; i++) {
        if (part[i] == "" || part[i] == ".") continue
        if (part[i] == "..") {
          reject("parent traversal archive member", path)
          unsafe = 1
          break
        }
        output = output (output == "" ? "" : "/") part[i]
      }
      if (!unsafe && output != "") print output
    }
    END { if (bad) exit 1 }
  ' "$listing" >"$normalized"; then
    rm -f "$normalized"
    return 1
  fi
  if [[ ! -s "$normalized" ]]; then
    printf 'archive contains no file paths\n' >&2
    rm -f "$normalized"
    return 1
  fi
  duplicate="$(awk 'seen[$0]++ { print; exit }' "$normalized")"
  rm -f "$normalized"
  if [[ -n "$duplicate" ]]; then
    printf 'duplicate archive member: %s\n' "$duplicate" >&2
    return 1
  fi
}

bsdtar_entry_types_are_safe() {
  local verbose_listing="$1"
  LC_ALL=C awk '
    function contained_link(path, target, base, combined, count, i, depth, part) {
      if (target == "" || target ~ /[[:cntrl:]]/) return 0
      gsub(/\\/, "/", target)
      if (target ~ /^\// || target ~ /^[[:alpha:]]:/) return 0
      base = path
      if (base ~ /\//) sub(/\/[^/]*$/, "", base); else base = ""
      combined = (base == "" ? target : base "/" target)
      count = split(combined, part, "/")
      depth = 0
      for (i = 1; i <= count; i++) {
        if (part[i] == "" || part[i] == ".") continue
        if (part[i] == "..") {
          if (depth == 0) return 0
          depth--
        } else {
          depth++
        }
      }
      return 1
    }
    {
      type = substr($0, 1, 1)
      if (type != "-" && type != "d" && type != "l") {
        printf "unsupported archive entry type: %s\n", $0 > "/dev/stderr"
        bad = 1
        next
      }
      if (type != "l") next
      rest = $0
      malformed = 0
      for (field = 1; field <= 8; field++) {
        if (rest !~ /^[^[:space:]]+[[:space:]]+/) {
          printf "malformed symbolic-link listing: %s\n", $0 > "/dev/stderr"
          bad = 1
          malformed = 1
          break
        }
        sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
      }
      if (malformed) next
      pieces = split(rest, link, / -> /)
      if (pieces != 2 || !contained_link(link[1], link[2])) {
        printf "unsafe symbolic link in archive: %s\n", rest > "/dev/stderr"
        bad = 1
      }
    }
    END { if (bad) exit 1 }
  ' "$verbose_listing"
}

preflight_bsdtar_archive() {
  local archive="$1" label="$2" listing verbose_listing
  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-list.XXXXXX")"
  verbose_listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-verbose.XXXXXX")"
  if ! LC_ALL=C bsdtar -tf "$archive" >"$listing" 2>/dev/null ||
     ! archive_member_listing_is_safe "$listing" ||
     ! LC_ALL=C bsdtar -tvf "$archive" >"$verbose_listing" 2>/dev/null ||
     ! bsdtar_entry_types_are_safe "$verbose_listing"; then
    rm -f "$listing" "$verbose_listing"
    die "$label has unsafe or unreadable archive members"
  fi
  rm -f "$listing" "$verbose_listing"
}

preflight_7z_archive() {
  local archive="$1" label="$2" details listing
  details="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-details.XXXXXX")"
  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-list.XXXXXX")"
  if ! LC_ALL=C 7z l -slt -- "$archive" >"$details" 2>/dev/null; then
    rm -f "$details" "$listing"
    die "$label archive listing failed"
  fi
  # Newer 7-Zip releases expose POSIX links and special files only through
  # the ten-character mode token in Attributes; permit regular files and directories only.
  if grep -Eq '^(Symbolic Link|Hard Link) = |^Attributes = .* [^-d][^[:space:]]{9}$' "$details" ||
     ! awk '
       /^----------$/ { entries = 1; next }
       !entries { next }
       /^$/ { next }
       /^Path = / { print substr($0, 8); paths++; next }
       /^[^=]+ = / { next }
       /^(Warnings|Errors): [0-9]+$/ { next }
       { malformed = 1 }
       END { if (!paths || malformed) exit 1 }
     ' "$details" >"$listing" ||
     ! archive_member_listing_is_safe "$listing"; then
    rm -f "$details" "$listing"
    die "$label has unsafe, duplicate, linked, or unreadable archive members"
  fi
  rm -f "$details" "$listing"
}

extract_7z_archive() {
  local archive="$1" destination="$2" label="$3" overwrite_policy="$4"
  local max_seconds="$5" extract_log="$6" overwrite_option
  case "$overwrite_policy" in
    keep-existing) overwrite_option='-aos' ;;
    replace-existing) overwrite_option='-aoa' ;;
    *) die "$label has an invalid extraction overwrite policy" ;;
  esac
  [[ "$max_seconds" =~ ^[1-9][0-9]*$ ]] || die "$label has an invalid extraction timeout"
  [[ -d "$destination" && ! -L "$destination" ]] || die "$label extraction destination is unsafe or missing"
  preflight_7z_archive "$archive" "$label"
  if ! timeout --foreground --kill-after=10s "$max_seconds" \
      7z x -y "$overwrite_option" "-o$destination" -- "$archive" >>"$extract_log"; then
    die "$label extraction failed; see $extract_log"
  fi
}

extract_bsdtar_archive() {
  local archive="$1" destination="$2" label="$3" existing
  preflight_bsdtar_archive "$archive" "$label"
  [[ -d "$destination" ]] || die "$label extraction destination is missing"
  if ! existing="$(find "$destination" -mindepth 1 -print -quit)"; then
    die "$label extraction destination inspection failed"
  fi
  [[ -z "$existing" ]] || die "$label extraction destination is not empty"
  bsdtar -xkf "$archive" -C "$destination" || die "$label extraction failed"
}

download_verified() {
  local label="$1" url="$2" path="$3" size="$4" checksum="$5" component
  case "$path" in
    "$INSTALLER") component='Live for Speed' ;;
    "$WINE_PACKAGE") component='compatibility components' ;;
    "$WINE_PACKAGE_SIGNATURE") component='download signature' ;;
    "$DXVK_ARCHIVE") component='graphics components' ;;
    *) component="$label" ;;
  esac
  ui_event stage "Checking $component downloads…"
  mkdir -p "$CACHE_DIR"
  chmod 0700 "$CACHE_DIR"
  if [[ -f "$path" ]]; then
    if [[ "$(stat -c %s "$path")" == "$size" && "$(sha256_of "$path")" == "$checksum" ]]; then
      note "Using verified cached $label"
      return
    fi
    rm -f "$path"
  fi
  if [[ -f "$path.part" ]]; then
    if file_matches "$path.part" "$size" "$checksum"; then
      mv "$path.part" "$path"
      note "Recovered completed verified $label download"
      return
    fi
    if (( $(stat -c %s "$path.part") >= size )); then
      rm -f "$path.part"
    fi
  fi
  note "Downloading $label (safe to resume after interruption)"
  ui_event stage "Downloading $component. Interrupted downloads can be resumed."
  ui_event download-start "${path##*/}.part"$'\t'"$size"$'\t'"$component"
  if ! curl --fail --location --retry 5 --retry-all-errors --connect-timeout 20 \
    --max-time 3600 --speed-limit 10240 --speed-time 60 --progress-bar \
    --continue-at - --output "$path.part" "$url"; then
    ui_event download-end
    GUI_ERROR_KIND='download'
    die "$label download interrupted; partial file kept for the next retry"
  fi
  ui_event download-end
  ui_event stage "Checking $component download integrity…"
  if ! file_matches "$path.part" "$size" "$checksum"; then
    rm -f "$path.part"
    die "$label completed with unexpected size or checksum"
  fi
  mv "$path.part" "$path"
}

clear_wine_detection() {
  WINE_BIN=''
  WINE_SERVER=''
  WINE_VERSION=''
  WINE_ROOT=''
  WINE_LIB_DIR=''
}

detect_wine() {
  local candidate candidate_dir version usr_dir
  clear_wine_detection
  if [[ -n "${LFS_LINUX_WINE:-}" ]]; then
    candidate="$LFS_LINUX_WINE"
  elif [[ -x "$PRIVATE_WINE_BIN" ]]; then
    candidate="$PRIVATE_WINE_BIN"
  else
    candidate="$(command -v wine 2>/dev/null || true)"
  fi
  [[ -n "$candidate" ]] || return 1
  if [[ "$candidate" != */* ]]; then
    candidate="$(command -v -- "$candidate" 2>/dev/null || true)"
  fi
  [[ -n "$candidate" && -x "$candidate" && "${candidate##*/}" == 'wine' ]] || return 1
  candidate_dir="$(cd -- "$(dirname "$candidate")" 2>/dev/null && pwd -P)" || return 1
  usr_dir="$(cd -- "$candidate_dir/.." 2>/dev/null && pwd -P)" || return 1
  candidate="$usr_dir/bin/wine"
  [[ "$candidate_dir" == "$usr_dir/bin" && -x "$candidate" && -d "$usr_dir/lib/wine" && -x "$usr_dir/bin/wineserver" ]] || return 1
  WINE_BIN="$candidate"
  WINE_SERVER="$usr_dir/bin/wineserver"
  WINE_ROOT="$(dirname "$usr_dir")"
  WINE_LIB_DIR="$usr_dir/lib/wine"
  if ! wine_runtime_is_complete; then
    clear_wine_detection
    return 1
  fi
  version="$("$WINE_BIN" --version 2>/dev/null | head -n 1)"
  if [[ "$version" != "$WINE_VERSION_OUTPUT" ]]; then
    clear_wine_detection
    return 1
  fi
  WINE_VERSION="$version"
}

wine_runtime_is_complete() {
  [[ -n "$WINE_ROOT" ]] || return 1
  payload_manifest_check "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES" >/dev/null
}

wine_runtime_layout_is_complete() {
  [[ -n "$WINE_ROOT" ]] || return 1
  payload_manifest_check "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES" layout >/dev/null
}

require_wine() {
  detect_wine || die "exact audited Wine $WINE_RUNTIME_VERSION is required; run lfs-linux install"
  verify_payload_manifest "Wine $WINE_RUNTIME_VERSION runtime" "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
}

verify_wine_package_signature() {
  local status
  verify_file 'Arch Wine signing key' "$WINE_SIGNING_KEY" "$WINE_SIGNING_KEY_SIZE" "$WINE_SIGNING_KEY_SHA256"
  verify_file 'Arch Wine detached signature' "$WINE_PACKAGE_SIGNATURE" \
    "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  if ! status="$(gpgv --status-fd 1 --keyring "$WINE_SIGNING_KEY" \
      "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE" 2>/dev/null)"; then
    die "Arch Wine $WINE_RUNTIME_VERSION package signature is invalid"
  fi
  awk -v fingerprint="$WINE_SIGNING_KEY_FINGERPRINT" '
    $1 == "[GNUPG:]" && $2 == "VALIDSIG" && ($3 == fingerprint || $NF == fingerprint) { valid = 1 }
    END { exit(valid ? 0 : 1) }
  ' <<<"$status" || die "Arch Wine $WINE_RUNTIME_VERSION package signature has an unexpected signer"
}

ensure_wine_runtime() {
  local unpack="$STATE_ROOT/.wine-unpack.$$"
  ui_event phase $'runtime\tChecking compatibility components…'
  if detect_wine; then
    return
  fi
  mkdir -p "$STATE_ROOT" "$RUNTIME_DIR" "$CACHE_DIR" "$LOG_DIR"
  download_verified "audited Arch Wine $WINE_RUNTIME_VERSION package" "$WINE_PACKAGE_URL" "$WINE_PACKAGE" \
    "$WINE_PACKAGE_SIZE" "$WINE_PACKAGE_SHA256"
  download_verified "Arch Wine $WINE_RUNTIME_VERSION package signature" "$WINE_PACKAGE_SIGNATURE_URL" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  verify_wine_package_signature
  rm -rf --one-file-system "$unpack"
  mkdir -p "$unpack"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  note "Provisioning private Wine $WINE_RUNTIME_VERSION runtime"
  extract_bsdtar_archive "$WINE_PACKAGE" "$unpack" "Arch Wine $WINE_RUNTIME_VERSION package"
  verify_payload_manifest "extracted Wine $WINE_RUNTIME_VERSION runtime" "$unpack" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  rm -rf --one-file-system "$PRIVATE_WINE_ROOT"
  mv "$unpack" "$PRIVATE_WINE_ROOT"
  ACTIVE_UNPACK=''
  trap - EXIT
  detect_wine || die "provisioned Wine $WINE_RUNTIME_VERSION failed payload validation or version verification"
}

wine_env() {
  env \
    WINEPREFIX="$PREFIX" \
    WINEDEBUG="${WINEDEBUG:--all}" \
    WINEDLLPATH="$WINE_LIB_DIR" \
    WINEDLLOVERRIDES="$WINE_DLL_OVERRIDES" \
    DXVK_LOG_PATH="$LOG_DIR" \
    DXVK_SHADER_CACHE_PATH="$CACHE_DIR/dxvk-shaders" \
    "$@"
}

kill_private_wineserver() {
  [[ -n "$WINE_SERVER" && -x "$WINE_SERVER" ]] || return 0
  wine_env timeout --foreground --kill-after=5s 15 "$WINE_SERVER" -k 2>/dev/null || true
}

wait_private_wineserver() {
  local log="${1:-}" mode="${2:-strict}" active_timeouts=0 wait_status
  while true; do
    if wine_env timeout --foreground --kill-after=5s 60 "$WINE_SERVER" --wait 9>&-; then
      launch_log_event "$log" "event=wine-settled active_timeouts=$active_timeouts"
      return 0
    else
      wait_status=$?
    fi
    if [[ "$wait_status" != '124' && "$wait_status" != '137' ]]; then
      launch_log_event "$log" "event=wine-wait-error phase=primary status=$wait_status"
      [[ "$mode" == 'launch' ]] && return "$wait_status"
      die "private Wine wait failed with status $wait_status"
    fi
    if [[ "$mode" == 'launch' ]] && game_is_running; then
      active_timeouts=$((active_timeouts + 1))
      if (( active_timeouts == 1 )); then
        note 'Updater restarted LFS; waiting for the active game to exit'
      fi
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=yes action=continue"
      continue
    fi
    if [[ "$mode" == 'launch' ]]; then
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=no action=grace"
      if wine_env timeout --foreground --kill-after=2s 5 "$WINE_SERVER" --wait 9>&-; then
        launch_log_event "$log" "event=wine-settled active_timeouts=$active_timeouts grace=yes"
        return 0
      else
        wait_status=$?
      fi
      if [[ "$wait_status" != '124' && "$wait_status" != '137' ]]; then
        launch_log_event "$log" "event=wine-wait-error phase=grace status=$wait_status"
        return "$wait_status"
      fi
      if game_is_running; then
        active_timeouts=$((active_timeouts + 1))
        if (( active_timeouts == 1 )); then
          note 'Updater restarted LFS; waiting for the active game to exit'
        fi
        launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=yes action=continue-after-grace"
        continue
      fi
      launch_log_event "$log" "event=wine-settle-timeout status=$wait_status game_active=no action=leave-running"
      warn 'private Wine services did not settle after LFS exited; they were left running. Close the previous session from the launcher before playing again.'
      return 1
    fi
    kill_private_wineserver
    die 'private Wine processes did not settle within 60 seconds'
  done
}

prefix_processes() {
  local pid prefix command_name command_zero executable
  for pid in /proc/[0-9]*; do
    prefix="$(sed -z -n 's/^WINEPREFIX=//p' "$pid/environ" 2>/dev/null | tr -d '\0' || true)"
    [[ "$prefix" == "$PREFIX" ]] || continue
    command_name="$(cat "$pid/comm" 2>/dev/null || true)"
    command_zero="$(tr '\0' '\n' <"$pid/cmdline" 2>/dev/null | head -n 1 || true)"
    executable="$(readlink -f "$pid/exe" 2>/dev/null || true)"
    case "${command_name,,}" in
      wine*|*.exe) printf '%s\n' "${pid##*/}"; continue ;;
    esac
    command_zero="${command_zero##*/}"
    case "${command_zero,,}" in
      wine*|*.exe) printf '%s\n' "${pid##*/}"; continue ;;
    esac
    if [[ -n "$WINE_LIB_DIR" && "$executable" == "$WINE_LIB_DIR/"* ]] ||
       [[ -n "$WINE_BIN" && "$executable" == "$WINE_BIN" ]] ||
       [[ -n "$WINE_SERVER" && "$executable" == "$WINE_SERVER" ]]; then
      printf '%s\n' "${pid##*/}"
    fi
  done
}

game_processes() {
  local pid command_line command_name
  while IFS= read -r pid; do
    command_name="$(cat "/proc/$pid/comm" 2>/dev/null || true)"
    command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    if [[ "${command_name,,}" == 'lfs.exe' || "${command_line,,}" == *'lfs.exe'* ]]; then
      printf '%s\n' "$pid"
    fi
  done < <(prefix_processes)
}

game_is_running() {
  [[ -n "$(game_processes)" ]]
}

prefix_is_running() {
  [[ -n "$(prefix_processes)" ]]
}

wait_for_exit() {
  local seconds="$1" i
  for ((i = 0; i < seconds; i++)); do
    game_is_running || return 0
    sleep 1
  done
  return 1
}

wait_for_prefix_exit() {
  local seconds="$1" i
  for ((i = 0; i < seconds; i++)); do
    prefix_is_running || return 0
    sleep 1
  done
  return 1
}

init_prefix() {
  local prefix_existed=0
  [[ ! -e "$PREFIX" && ! -L "$PREFIX" ]] || prefix_existed=1
  ui_event phase $'runtime\tPreparing your game installation…'
  mkdir -p "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"
  chmod 0700 "$STATE_ROOT" "$CACHE_DIR" "$LOG_DIR" "$LOCK_DIR"
  printf '%s\n' 'lfs-linux managed state; unknown files are preserved on removal' >"$STATE_SENTINEL"
  chmod 0600 "$STATE_SENTINEL"
  if [[ ! -f "$PREFIX/system.reg" ]]; then
    note "Creating private Wine prefix with $WINE_VERSION"
    if ! wine_env timeout --foreground --kill-after=10s 180 "$WINE_BIN" wineboot --init; then
      kill_private_wineserver
      if (( prefix_existed == 0 )); then
        rm -rf --one-file-system "$PREFIX"
      fi
      die 'Wine prefix initialization failed or timed out; existing player data was preserved'
    fi
    wait_private_wineserver
  elif [[ ! -f "$INSTALL_MARKER" ]] || ! grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER"; then
    note "Updating the private prefix for $WINE_VERSION"
    if ! wine_env timeout --foreground --kill-after=10s 180 "$WINE_BIN" wineboot --update; then
      kill_private_wineserver
      die 'Wine prefix update failed or timed out; existing data was preserved'
    fi
    wait_private_wineserver
  fi
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || die 'prefix architecture drift; expected win64'
}

install_dxvk() {
  local unpack="$CACHE_DIR/.dxvk-unpack.$$"
  ui_event phase $'graphics\tPreparing graphics…'
  download_verified 'DXVK archive' "$DXVK_ARCHIVE_URL" "$DXVK_ARCHIVE" \
    "$DXVK_ARCHIVE_SIZE" "$DXVK_ARCHIVE_SHA256"
  rm -rf "$unpack"
  mkdir -p "$unpack"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  extract_bsdtar_archive "$DXVK_ARCHIVE" "$unpack" 'DXVK archive'
  verify_file 'DXVK d3d11 x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'DXVK dxgi x32 DLL' "$unpack/dxvk-$DXVK_VERSION/x32/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  rm -rf "$DXVK_DIR"
  mkdir -p "$DXVK_DIR/x32"
  install -m0644 "$unpack/dxvk-$DXVK_VERSION/x32/d3d11.dll" "$DXVK_D3D11"
  install -m0644 "$unpack/dxvk-$DXVK_VERSION/x32/dxgi.dll" "$DXVK_DXGI"
  rm -rf "$unpack"
  ACTIVE_UNPACK=''
  trap - EXIT
  rm -f "$PREFIX/drive_c/windows/syswow64/d3d9.dll"
  install -m0644 "$DXVK_D3D11" "$PREFIX/drive_c/windows/syswow64/d3d11.dll"
  install -m0644 "$DXVK_DXGI" "$PREFIX/drive_c/windows/syswow64/dxgi.dll"
  wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg delete \
    'HKCU\Software\Wine\DllOverrides' /v d3d9 /f >/dev/null 2>&1 || true
  if ! wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg add \
    'HKCU\Software\Wine\DllOverrides' /v d3d11 /d "$DXVK_OVERRIDE" /f >/dev/null || \
    ! wine_env timeout --foreground --kill-after=5s 60 "$WINE_BIN" reg add \
    'HKCU\Software\Wine\DllOverrides' /v dxgi /d "$DXVK_OVERRIDE" /f >/dev/null; then
    kill_private_wineserver
    die 'DXVK registry overrides failed or timed out'
  fi
  wait_private_wineserver
}

extract_lfs_payload() {
  local installer="$1" unpack="$2" extract_log="$3" archive
  local -a all_archives dds_archives wld_archives
  : >"$extract_log"
  extract_7z_archive "$installer" "$unpack" 'official LFS installer' keep-existing 900 "$extract_log"
  rm -rf --one-file-system "$unpack/\$PLUGINSDIR"
  rm -f "$unpack/UninstallLFS.exe"
  (( LFS_NESTED_ARCHIVE_COUNT > 0 )) || return 0

  [[ -d "$unpack/inst_tmp" ]] || die 'official LFS nested payload directory is missing'
  mapfile -t all_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name '*.7z' -print | sort)
  mapfile -t dds_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name 'dds_[0-9][0-9].7z' -print | sort)
  mapfile -t wld_archives < <(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 -type f -name 'wld_[A-Z][A-Z].7z' -print | sort)
  [[ "${#all_archives[@]}" == "$LFS_NESTED_ARCHIVE_COUNT" ]] || die 'official LFS nested archive-count drift'
  [[ "${#dds_archives[@]}" == "$LFS_NESTED_DDS_ARCHIVE_COUNT" ]] || die 'official LFS DDS archive-count drift'
  [[ "${#wld_archives[@]}" == "$LFS_NESTED_WLD_ARCHIVE_COUNT" ]] || die 'official LFS world archive-count drift'
  [[ -f "$unpack/inst_tmp/knw_1.7z" && -f "$unpack/inst_tmp/training_1.7z" ]] || die 'official LFS nested knowledge or training archive is missing'
  [[ -z "$(find "$unpack/inst_tmp" -mindepth 1 -maxdepth 1 ! -type f -print -quit)" ]] || die 'unexpected entry in official LFS nested payload directory'
  verify_payload_manifest 'official LFS nested archive payload' "$unpack" "$LFS_NESTED_MANIFEST" \
    "$LFS_NESTED_MANIFEST_SIZE" "$LFS_NESTED_MANIFEST_SHA256" "$LFS_NESTED_MANIFEST_ENTRIES"

  mkdir -p "$unpack/data/dds" "$unpack/data/wld" "$unpack/data/knw" "$unpack/data/training"
  # Exact nested hashes and sorted archive order are audited. Later archives intentionally
  # replace earlier seed entries inside this disposable staging tree.
  for archive in "${dds_archives[@]}"; do
    extract_7z_archive "$archive" "$unpack/data/dds" \
      "official LFS nested DDS archive $(basename "$archive")" replace-existing 300 "$extract_log"
  done
  for archive in "${wld_archives[@]}"; do
    extract_7z_archive "$archive" "$unpack/data/wld" \
      "official LFS nested world archive $(basename "$archive")" replace-existing 300 "$extract_log"
  done
  extract_7z_archive "$unpack/inst_tmp/knw_1.7z" "$unpack/data/knw" \
    'official LFS nested knowledge archive' replace-existing 300 "$extract_log"
  extract_7z_archive "$unpack/inst_tmp/training_1.7z" "$unpack/data/training" \
    'official LFS nested training archive' replace-existing 300 "$extract_log"
  rm -rf --one-file-system "$unpack/inst_tmp"
}

validate_existing_game_source() {
  # Installed game content belongs to LFS and the user, not the bootstrap manifest.
  [[ -e "$GAME_DIR" || -L "$GAME_DIR" ]] || return 0
  game_is_installed || die 'existing game folder has no readable, nonempty regular LFS.exe; no files changed. Open Help from the application menu to restore the game without losing player data.'
}

verify_game_tree() {
  local root="$1" label="$2" file_count tree_bytes
  verify_payload_manifest "$label immutable stock payload" "$root" "$LFS_STOCK_MANIFEST" \
    "$LFS_STOCK_MANIFEST_SIZE" "$LFS_STOCK_MANIFEST_SHA256" "$LFS_STOCK_MANIFEST_ENTRIES"
  verify_file "$label LFS.exe" "$root/LFS.exe" "$LFS_EXE_SIZE" "$LFS_EXE_SHA256"
  verify_file "$label default helmet" "$root/$LFS_REQUIRED_HELMET_PATH" \
    "$LFS_REQUIRED_HELMET_SIZE" "$LFS_REQUIRED_HELMET_SHA256"
  verify_file "$label Blackwood track" "$root/$LFS_REQUIRED_TRACK_PATH" \
    "$LFS_REQUIRED_TRACK_SIZE" "$LFS_REQUIRED_TRACK_SHA256"
  verify_file "$label demo vehicle" "$root/$LFS_REQUIRED_VEHICLE_PATH" \
    "$LFS_REQUIRED_VEHICLE_SIZE" "$LFS_REQUIRED_VEHICLE_SHA256"
  file_count="$(find "$root" -type f -printf . | wc -c)"
  tree_bytes="$(du -sb "$root" | awk '{print $1}')"
  (( file_count >= LFS_TREE_MIN_FILE_COUNT )) || die "$label file-count drift: expected at least $LFS_TREE_MIN_FILE_COUNT, found $file_count"
  (( tree_bytes >= LFS_TREE_MIN_BYTES )) || die "$label size drift: expected at least $LFS_TREE_MIN_BYTES bytes, found $tree_bytes"
}

verify_extracted_game_tree() {
  local root="$1" label="$2"
  verify_payload_manifest "$label complete official seed payload" "$root" "$LFS_STOCK_SEED_MANIFEST" \
    "$LFS_STOCK_SEED_MANIFEST_SIZE" "$LFS_STOCK_SEED_MANIFEST_SHA256" "$LFS_STOCK_SEED_MANIFEST_ENTRIES"
  verify_game_tree "$root" "$label"
}

recover_interrupted_game_swap() {
  [[ -d "$GAME_BACKUP" && ! -L "$GAME_BACKUP" ]] || return 0
  # Legacy wrappers swapped whole trees. Never discard either surviving tree.
  if [[ ! -e "$GAME_DIR" && ! -L "$GAME_DIR" ]]; then
    mkdir -p "$(dirname "$GAME_DIR")"
    mv -Tn -- "$GAME_BACKUP" "$GAME_DIR"
    [[ ! -e "$GAME_BACKUP" ]] || die 'game folder appeared during recovery; both trees were kept'
    note 'Recovered player data after an interrupted game-tree swap'
  fi
}

install_game() {
  local unpack extract_log="$LOG_DIR/lfs-extract.log"
  validate_existing_game_source
  ui_event phase $'game\tPreparing Live for Speed…'
  if game_is_installed; then
    note 'Keeping existing Live for Speed and all player files; LFS manages game updates'
    return
  fi
  download_verified "official LFS $LFS_VERSION installer" "$LFS_INSTALLER_URL" "$INSTALLER" \
    "$LFS_INSTALLER_SIZE" "$LFS_INSTALLER_SHA256"
  unpack="$(mktemp -d "$STATE_ROOT/.lfs-unpack.XXXXXX")"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  note 'Extracting untouched official LFS files into private staging'
  ui_event stage 'Unpacking and checking game files. This may take several minutes.'
  extract_lfs_payload "$INSTALLER" "$unpack" "$extract_log"
  verify_extracted_game_tree "$unpack" 'extracted LFS'
  mkdir -p "$(dirname "$GAME_DIR")"
  # Do not overwrite files created by another program while extraction ran.
  if ! mv -Tn -- "$unpack" "$GAME_DIR" || [[ -e "$unpack" ]]; then
    die 'game folder appeared during setup; existing files were kept. Retry from the launcher.'
  fi
  ACTIVE_UNPACK=''
  trap - EXIT
}

write_marker() {
  local tmp
  tmp="$(mktemp "$STATE_ROOT/.install.env.XXXXXX")"
  umask 077
  if ! cat >"$tmp" <<EOF
LFS_PACKAGE_VERSION='$LFS_VERSION'
DXVK_VERSION='$DXVK_VERSION'
DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'
DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'
WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'
WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'
WINE_VERSION='$WINE_VERSION'
PREFIX_ARCH='win64'
EOF
  then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$INSTALL_MARKER"; then
    rm -f "$tmp"
    return 1
  fi
}

game_is_installed() {
  [[ -d "$GAME_DIR" && ! -L "$GAME_DIR" && -f "$GAME_EXE" && ! -L "$GAME_EXE" && -r "$GAME_EXE" && -s "$GAME_EXE" ]]
}

validate_installation() {
  ui_event phase $'launch\tChecking game components before starting…'
  require_wine
  [[ -f "$PREFIX/system.reg" ]] || die 'private prefix is missing; run lfs-linux install'
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || die 'prefix architecture drift; expected win64'
  [[ -f "$INSTALL_MARKER" ]] || die 'installation marker is missing; run lfs-linux install'
  grep -Fqx "DXVK_VERSION='$DXVK_VERSION'" "$INSTALL_MARKER" || die 'installed DXVK release differs from wrapper manifest'
  grep -Fqx "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'" "$INSTALL_MARKER" || die 'installation marker DXVK d3d11 checksum drift'
  grep -Fqx "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'" "$INSTALL_MARKER" || die 'installation marker DXVK dxgi checksum drift'
  grep -Fqx "PREFIX_ARCH='win64'" "$INSTALL_MARKER" || die 'installation marker architecture drift'
  grep -Fqx "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'" "$INSTALL_MARKER" || die 'installed Wine runtime differs from wrapper manifest'
  grep -Fqx "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'" "$INSTALL_MARKER" || die 'installation marker Wine payload drift'
  grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER" || die 'Wine changed; run lfs-linux install to update the private prefix'
  game_is_installed || die 'LFS.exe is missing, empty, linked or unreadable; existing game files were kept. Open Help from the application menu.'
  verify_file 'private DXVK d3d11 DLL' "$DXVK_D3D11" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'private DXVK dxgi DLL' "$DXVK_DXGI" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  verify_file 'prefix DXVK d3d11 DLL' "$PREFIX/drive_c/windows/syswow64/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'prefix DXVK dxgi DLL' "$PREFIX/drive_c/windows/syswow64/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
}

ready_fast() {
  detect_wine || return 1
  wine_runtime_layout_is_complete || return 1
  [[ -f "$STATE_SENTINEL" && -f "$PREFIX/system.reg" && -f "$INSTALL_MARKER" ]] || return 1
  game_is_installed || return 1
  file_matches "$DXVK_D3D11" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256" || return 1
  file_matches "$DXVK_DXGI" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256" || return 1
  file_matches "$PREFIX/drive_c/windows/syswow64/d3d11.dll" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256" || return 1
  file_matches "$PREFIX/drive_c/windows/syswow64/dxgi.dll" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256" || return 1
  grep -Fqx "PREFIX_ARCH='win64'" "$INSTALL_MARKER" || return 1
  grep -Fq '#arch=win64' "$PREFIX/system.reg" || return 1
  grep -Fqx "DXVK_VERSION='$DXVK_VERSION'" "$INSTALL_MARKER" || return 1
  grep -Fqx "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'" "$INSTALL_MARKER" || return 1
  grep -Fqx "WINE_VERSION='$WINE_VERSION'" "$INSTALL_MARKER" || return 1
}

setup_interactive() {
  local answer lfs_mib wine_mib dxvk_mib setup_heading lfs_step
  require_unprivileged
  require_command awk
  require_command find
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  validate_existing_game_source
  lfs_mib=$(( (LFS_INSTALLER_SIZE + 1048575) / 1048576 ))
  wine_mib=$(( (WINE_PACKAGE_SIZE + 1048575) / 1048576 ))
  dxvk_mib=$(( (DXVK_ARCHIVE_SIZE + 1048575) / 1048576 ))
  setup_heading='first-run setup'
  lfs_step="Download the official LFS $LFS_VERSION public-test installer from lfs.net ($lfs_mib MiB)."
  if [[ -e "$GAME_DIR" ]]; then
    setup_heading='verified setup / repair'
  fi
  if game_is_installed; then
    lfs_step='Keep your existing game and all player files. No game download or downgrade.'
  fi
  cat <<EOF
Live for Speed Linux $setup_heading

This separate community launcher targets official LFS $LFS_VERSION:
$LFS_CHANNEL_LABEL. It is not the stable $LFS_FALLBACK_VERSION branch. Immutable
wrapper $LFS_FALLBACK_WRAPPER remains the old-graphics fallback.

It will:
  1. $lfs_step
  2. Provision audited Arch Wine $WINE_RUNTIME_VERSION from archive.archlinux.org ($wine_mib MiB)
     when that exact system runtime is unavailable.
  3. Download official DXVK $DXVK_VERSION from GitHub ($dxvk_mib MiB).
  4. Verify downloaded archives and compatibility runtime files.
  5. Extract the verified official game only when no game is installed:
     $PREFIX
  6. Install private DXVK D3D11/DXGI without replacing an existing game.
  7. Let LFS manage its updates. Reopen normally after updating.

Setup checks free space for downloads and extraction before starting. Live for Speed remains
proprietary and is governed by https://www.lfs.net/agreement. This wrapper is
unofficial and does not redistribute or patch the game.

EOF
  printf 'Continue with verified setup? [y/N] '
  read -r answer || return 3
  [[ "${answer,,}" == 'y' || "${answer,,}" == 'yes' ]] || { note 'Setup cancelled'; return 3; }
  install_all
}

check_install_space() {
  local state_bytes=0 cache_bytes=134217728 path required cached available parent device
  local -A needed=() locations=()
  # Reserve the final tree plus nested archives that coexist during extraction.
  if ! game_is_installed; then
    state_bytes=$(( LFS_TREE_MIN_BYTES + LFS_INSTALLER_SIZE + 268435456 ))
  fi
  if [[ -z "$WINE_BIN" ]]; then state_bytes=$((state_bytes + 805306368)); fi
  for path in "$INSTALLER" "$WINE_PACKAGE" "$DXVK_ARCHIVE"; do
    case "$path" in
      "$INSTALLER") game_is_installed && continue; required="$LFS_INSTALLER_SIZE" ;;
      "$WINE_PACKAGE") [[ -z "$WINE_BIN" ]] || continue; required="$WINE_PACKAGE_SIZE" ;;
      *) required="$DXVK_ARCHIVE_SIZE" ;;
    esac
    if [[ -f "$path" ]]; then cached="$(stat -c %s "$path")"
    elif [[ -f "$path.part" ]]; then cached="$(stat -c %s "$path.part")"
    else cached=0; fi
    (( cached <= required )) || cached=0
    cache_bytes=$((cache_bytes + required - cached))
  done
  for path in "$STATE_ROOT" "$CACHE_DIR"; do
    parent="$path"
    while [[ ! -d "$parent" ]]; do parent="$(dirname "$parent")"; done
    [[ -w "$parent" ]] || { GUI_ERROR_KIND='permissions'; die "installation location is not writable: $parent"; }
    device="$(stat -c %d "$parent")"
    [[ "$path" != "$STATE_ROOT" ]] || needed[$device]=$(( ${needed[$device]:-0} + state_bytes ))
    [[ "$path" != "$CACHE_DIR" ]] || needed[$device]=$(( ${needed[$device]:-0} + cache_bytes ))
    locations[$device]="$parent"
  done
  for device in "${!needed[@]}"; do
    available="$(df -PB1 -- "${locations[$device]}" | awk 'END {print $4}')"
    [[ "$available" =~ ^[0-9]+$ ]] || die 'could not check available disk space'
    if (( available < needed[$device] )); then
      GUI_ERROR_KIND='space'
      die "not enough free space: need $(( (needed[$device] + 1048575) / 1048576 )) MiB on ${locations[$device]}"
    fi
  done
}

desktop_state() {
  ui_event phase $'host\tChecking this computer and the installed game…'
  [[ "$(uname -m)" == x86_64 ]] || { printf 'unsupported\n'; return; }
  open_launch_lock
  if ! flock -n 9; then printf 'busy\n'; return; fi
  if game_is_running; then printf 'running\n'; return; fi
  if prefix_is_running; then printf 'services\n'; return; fi
  if [[ ! -e "$GAME_DIR" && ! -e "$INSTALL_MARKER" && ! -e "$GAME_BACKUP" ]]; then
    if [[ -f "$INSTALLER.part" || -f "$WINE_PACKAGE.part" || -f "$DXVK_ARCHIVE.part" ]]; then
      printf 'resume\n'
    else printf 'fresh\n'; fi
    return
  fi
  if ready_fast; then printf 'ready\n'; return; fi
  if [[ -d "$GAME_BACKUP" && ! -e "$GAME_DIR" ]] || (validate_existing_game_source) >/dev/null 2>&1; then
    printf 'repair\n'
  else printf 'blocked\n'; fi
}

support_report() {
  printf 'Live for Speed Linux diagnostic summary\n\nWrapper: %s\nGame bootstrap: %s\nCompatibility runtime: %s\nGraphics component: %s\n' \
    "$LFS_LINUX_VERSION" "$LFS_VERSION" "$WINE_RUNTIME_VERSION" "$DXVK_VERSION"
  printf 'Architecture: %s\n' "$(uname -m)"
  if [[ -r /etc/os-release ]]; then
    awk -F= '/^(ID|VERSION_ID)=/ {gsub(/[^a-zA-Z0-9._-]/,"",$2); print $1 ": " $2}' /etc/os-release
  fi
  case "${XDG_SESSION_TYPE:-}" in x11|wayland) printf 'Display session: %s\n' "$XDG_SESSION_TYPE" ;; esac
  printf '\nThis summary excludes account data, registry contents, logs, and personal paths.\n'
}

install_all() {
  require_unprivileged
  require_host_arch
  require_command 7z
  require_command awk
  require_command bsdtar
  require_command curl
  require_command du
  require_command df
  require_command find
  require_command flock
  require_command gpgv
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  open_launch_lock
  flock -n 9 || die 'LFS is already launching, installing, or recovering'
  detect_wine 2>/dev/null || true
  if prefix_is_running; then
    die 'private Wine processes are running; run lfs-linux stop before install'
  fi
  recover_interrupted_game_swap
  validate_existing_game_source
  check_install_space
  INSTALL_ACTIVE=1
  trap cancel_install INT TERM
  ensure_wine_runtime
  require_wine
  init_prefix
  install_game
  install_dxvk
  write_marker
  INSTALL_ACTIVE=0
  trap - INT TERM
  ui_event phase $'ready\tGame components are ready. Preparing to play…'
  note 'Installation complete. Run: lfs-linux launch'
}

launch_game() {
  local log game_status wait_status
  require_unprivileged
  require_host_arch
  require_command awk
  require_command cmp
  require_command find
  require_command flock
  require_command mktemp
  require_command readlink
  require_command sha256sum
  require_command sort
  require_command stat
  require_command timeout
  open_launch_lock
  if ! flock -n 9; then
    if command -v wmctrl >/dev/null 2>&1; then
      wmctrl -a 'Live for Speed' 2>/dev/null || true
    fi
    note 'LFS is already launching or running'
    return
  fi
  if game_is_running; then
    if command -v wmctrl >/dev/null 2>&1; then
      wmctrl -a 'Live for Speed' 2>/dev/null || true
    fi
    note 'LFS is already running'
    return
  fi
  if prefix_is_running; then
    die 'private Wine services remain; run lfs-linux stop before launch'
  fi
  validate_installation
  if prefix_is_running; then
    die 'private Wine services started during launch validation; run lfs-linux stop before launch'
  fi
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || die 'no graphical session is available'
  mkdir -p "$LOG_DIR" "$CACHE_DIR/dxvk-shaders"
  log="$LOG_DIR/launch-$(date +%Y%m%d-%H%M%S)-$$.log"
  ln -sfn "$(basename "$log")" "$LOG_DIR/latest.log"
  note "Starting Live for Speed with $WINE_VERSION and private DXVK $DXVK_VERSION"
  launch_log_event "$log" "event=start wine=$WINE_VERSION dxvk=$DXVK_VERSION"
  ui_event launched
  LFS_LINUX_GUI_EVENTS=0
  cd "$GAME_DIR"
  set +e
  env \
    WINEPREFIX="$PREFIX" \
    WINEDEBUG="${WINEDEBUG:--all}" \
    WINEDLLPATH="$WINE_LIB_DIR" \
    WINEDLLOVERRIDES="$WINE_DLL_OVERRIDES" \
    DXVK_LOG_PATH="$LOG_DIR" \
    DXVK_SHADER_CACHE_PATH="$CACHE_DIR/dxvk-shaders" \
    "$WINE_BIN" "$GAME_EXE" /windowed=yes 3>&- 9>&- >>"$log" 2>&1
  game_status=$?
  set -e
  launch_log_event "$log" "event=wine-parent-exit status=$game_status"
  if wait_private_wineserver "$log" launch; then
    :
  else
    wait_status=$?
    launch_log_event "$log" "event=finish status=$wait_status reason=wine-wait-failed"
    warn 'Wine wait failed or private services remain; game files were left unchanged. Close the previous session from the launcher before playing again.'
    return "$wait_status"
  fi
  if (( game_status != 0 )); then
    warn "LFS exited with status $game_status; see the launch log for details"
  fi
  launch_log_event "$log" "event=finish status=$game_status"
  return "$game_status"
}

stop_game() {
  local window
  local -a pid_list=()
  require_unprivileged
  require_command timeout
  require_wine
  prefix_is_running || { note 'LFS is already stopped'; return; }
  window=''
  if game_is_running && [[ -n "${DISPLAY:-}" ]] && command -v xdotool >/dev/null 2>&1; then
    window="$(xdotool search --onlyvisible --name '^Live for Speed$' 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -n "$window" ]]; then
    xdotool windowactivate --sync "$window" 2>/dev/null || true
    xdotool key --clearmodifiers alt+F4
    if wait_for_exit 5 && wait_for_prefix_exit 5; then
      note 'LFS stopped cleanly via window close'
      return
    fi
    window="$(xdotool search --onlyvisible --name '^Live for Speed$' 2>/dev/null | head -n 1 || true)"
    if game_is_running && [[ -n "$window" ]]; then
      xdotool windowactivate --sync "$window" 2>/dev/null || true
      xdotool key --clearmodifiers t
      xdotool type --clearmodifiers --delay 20 '/exit'
      xdotool key --clearmodifiers Return
      if wait_for_exit 10 && wait_for_prefix_exit 5; then
        note 'LFS stopped cleanly'
        return
      fi
    fi
  fi
  warn 'clean in-game exit was unavailable; stopping only the private Wine prefix'
  kill_private_wineserver
  if wait_for_prefix_exit 5; then
    note 'Private Wine prefix stopped'
    return
  fi
  mapfile -t pid_list < <(prefix_processes)
  (( ${#pid_list[@]} == 0 )) || kill -TERM "${pid_list[@]}" 2>/dev/null || true
  wait_for_prefix_exit 3 || die 'private prefix processes did not stop'
  note 'Private Wine prefix stopped'
}

run_doctor() {
  local failures=0 version_output loader_summary wine_available=0 file_tools_available=1
  pass() { printf '[PASS] %s\n' "$*"; }
  fail_check() { printf '[FAIL] %s\n' "$*"; failures=$((failures + 1)); }
  info() { printf '[INFO] %s\n' "$*"; }
  check_file() {
    local label="$1" path="$2" expected_size="$3" expected_hash="$4" actual_size actual_hash
    if [[ ! -f "$path" ]]; then fail_check "$label missing"; return; fi
    actual_size="$(stat -c %s "$path")"
    if [[ "$actual_size" != "$expected_size" ]]; then fail_check "$label size drift"; return; fi
    if ! actual_hash="$(sha256_of "$path")"; then fail_check "$label hashing failed or timed out"; return; fi
    if [[ "$actual_hash" == "$expected_hash" ]]; then pass "$label size and checksum"; else fail_check "$label checksum drift"; fi
  }
  check_marker() {
    local label="$1" expected_line="$2"
    if grep -Fqx "$expected_line" "$INSTALL_MARKER"; then pass "$label"; else fail_check "$label drift"; fi
  }
  check_payload() {
    local label="$1" root="$2" manifest="$3" manifest_size="$4" manifest_hash="$5" entries="$6" issue
    if issue="$(payload_manifest_check "$root" "$manifest" "$manifest_size" "$manifest_hash" "$entries")"; then
      pass "$label: all $entries protected entries"
    else
      fail_check "$label drift: $issue"
    fi
  }

  if [[ "$(uname -m)" == 'x86_64' ]]; then
    pass 'host architecture: x86_64'
  else
    fail_check "unsupported host architecture: $(uname -m)"
  fi
  if detect_wine 2>/dev/null; then
    wine_available=1
    pass "exact Wine runtime: $WINE_RUNTIME_VERSION ($WINE_VERSION)"
  else
    fail_check "exact audited Wine $WINE_RUNTIME_VERSION is unavailable"
  fi
  if command -v 7z >/dev/null 2>&1; then pass '7z available'; else fail_check '7z missing'; fi
  if command -v bsdtar >/dev/null 2>&1; then pass 'bsdtar available'; else fail_check 'bsdtar missing'; fi
  if command -v curl >/dev/null 2>&1; then pass 'curl available'; else fail_check 'curl missing'; fi
  if command -v gpgv >/dev/null 2>&1; then pass 'gpgv available'; else fail_check 'gpgv missing'; fi
  if command -v flock >/dev/null 2>&1; then pass 'flock available'; else fail_check 'flock missing'; fi
  if ! command -v awk >/dev/null 2>&1 || ! command -v du >/dev/null 2>&1 || \
     ! command -v find >/dev/null 2>&1 || ! command -v mktemp >/dev/null 2>&1 || \
     ! command -v readlink >/dev/null 2>&1 || ! command -v stat >/dev/null 2>&1 || \
     ! command -v sha256sum >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
    fail_check 'file verification tools missing'
    file_tools_available=0
  fi
  if (( file_tools_available )); then
    check_file 'Arch Wine signing key' "$WINE_SIGNING_KEY" "$WINE_SIGNING_KEY_SIZE" "$WINE_SIGNING_KEY_SHA256"
  fi
  if (( wine_available && file_tools_available )); then
    check_payload "Wine $WINE_RUNTIME_VERSION payload" "$WINE_ROOT" "$WINE_RUNTIME_MANIFEST" \
      "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  fi
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then pass 'graphical session available'; else info 'no graphical session in current shell'; fi
  if command -v vulkaninfo >/dev/null 2>&1; then
    loader_summary="$(vulkaninfo --summary 2>/dev/null || true)"
    if grep -Fq 'deviceName' <<<"$loader_summary"; then pass 'Vulkan device available'; else fail_check 'Vulkan exposes no device'; fi
  else
    info 'vulkaninfo unavailable; runtime launch remains the behavioral Vulkan check'
  fi
  if [[ -d "$STATE_ROOT" ]]; then
    pass "user state: $STATE_ROOT"
    if [[ -f "$STATE_SENTINEL" ]]; then pass 'managed-state sentinel'; else fail_check 'managed-state sentinel missing'; fi
    if [[ -f "$PREFIX/system.reg" ]] && grep -Fq '#arch=win64' "$PREFIX/system.reg"; then
      pass 'prefix architecture: win64'
    else
      fail_check 'prefix architecture missing or drifted'
    fi
    if [[ -f "$INSTALL_MARKER" ]]; then
      pass 'installation marker present'
      check_marker 'marker DXVK release' "DXVK_VERSION='$DXVK_VERSION'"
      check_marker 'marker DXVK d3d11 checksum' "DXVK_D3D11_X32_SHA256='$DXVK_D3D11_X32_SHA256'"
      check_marker 'marker DXVK dxgi checksum' "DXVK_DXGI_X32_SHA256='$DXVK_DXGI_X32_SHA256'"
      check_marker 'marker prefix architecture' "PREFIX_ARCH='win64'"
      check_marker 'marker Wine runtime' "WINE_RUNTIME_VERSION='$WINE_RUNTIME_VERSION'"
      check_marker 'marker Wine payload' "WINE_RUNTIME_MANIFEST_SHA256='$WINE_RUNTIME_MANIFEST_SHA256'"
      if (( wine_available )); then check_marker 'marker Wine output' "WINE_VERSION='$WINE_VERSION'"; fi
    else
      fail_check 'installation marker missing'
    fi
    if game_is_installed; then
      pass 'game executable present; game files and updates are managed by LFS'
      info 'installed game contents are not authenticated; check the version and gameplay in LFS'
    else
      fail_check 'LFS.exe missing, empty, linked or unreadable; existing game files were kept'
    fi
    if (( file_tools_available )); then
      check_file 'private DXVK d3d11' "$DXVK_D3D11" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
      check_file 'private DXVK dxgi' "$DXVK_DXGI" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
      check_file 'prefix DXVK d3d11' "$PREFIX/drive_c/windows/syswow64/d3d11.dll" "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
      check_file 'prefix DXVK dxgi' "$PREFIX/drive_c/windows/syswow64/dxgi.dll" "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
    fi
  else
    info 'not installed yet'
  fi
  if game_is_running; then
    info 'LFS is running in the private prefix'
  elif prefix_is_running; then
    info 'private Wine services remain; close the previous session from the launcher'
  else
    info 'private prefix is stopped'
  fi
  version_output="wrapper $LFS_LINUX_VERSION; LFS bootstrap $LFS_VERSION ($LFS_CHANNEL_LABEL); Wine $WINE_RUNTIME_VERSION; DXVK $DXVK_VERSION"
  info "$version_output"
  printf '\nDoctor summary: %d failure(s)\n' "$failures"
  (( failures == 0 ))
}

show_status() {
  detect_wine 2>/dev/null || true
  printf 'Wrapper:    %s\n' "$LFS_LINUX_VERSION"
  printf 'LFS pin:    %s (first-install bootstrap)\n' "$LFS_VERSION"
  if game_is_installed; then printf 'Installed:  present (version shown in LFS)\n'
  else printf 'Installed:  missing or incomplete\n'; fi
  printf 'Channel:    %s\n' "$LFS_CHANNEL_LABEL"
  printf 'Fallback:   %s (LFS %s old graphics)\n' "$LFS_FALLBACK_WRAPPER" "$LFS_FALLBACK_VERSION"
  printf 'DXVK pin:   %s\n' "$DXVK_VERSION"
  printf 'Wine pin:   %s\n' "$WINE_RUNTIME_VERSION"
  printf 'Wine:       %s\n' "${WINE_VERSION:-missing}"
  printf 'State:      %s\n' "$STATE_ROOT"
  printf 'Game:       %s\n' "$GAME_EXE"
  printf 'Logs:       %s\n' "$LOG_DIR"
  if game_is_running; then
    printf 'Process:    LFS running\n'
  elif prefix_is_running; then
    printf 'Process:    Wine services remain (run lfs-linux stop)\n'
  else
    printf 'Process:    stopped\n'
  fi
}

update_check() {
  local page latest_stable public_family public_installer public_build expected_line
  if [[ -n "${LFS_LINUX_DOWNLOADS_PAGE_FILE:-}" ]]; then
    [[ -r "$LFS_LINUX_DOWNLOADS_PAGE_FILE" ]] || die "downloads-page fixture is unreadable: $LFS_LINUX_DOWNLOADS_PAGE_FILE"
    page="$(<"$LFS_LINUX_DOWNLOADS_PAGE_FILE")"
  else
    require_command curl
    page="$(curl --fail --location --silent --show-error --max-time 30 https://www.lfs.net/downloads)" || die 'could not fetch official LFS downloads page'
  fi
  latest_stable="$(grep -Eo 'title="Latest Version : [^"]+' <<<"$page" | head -n 1 | sed 's/.*: //' || true)"
  public_family="$(grep -Eo 'Live for Speed [0-9][^< ]* \(PUBLIC TEST\)' <<<"$page" | head -n 1 | sed -E 's/^Live for Speed ([^ ]+).*/\1/' || true)"
  [[ -n "$latest_stable" || -n "$public_family" ]] || die 'official downloads page could not be recognized; retry the check later'
  public_installer=''
  public_build=''
  if [[ -n "$public_family" ]]; then
    public_installer="$(
      { grep -Eo 'LFS_S3_[0-9][A-Z][0-9]*_setup\.exe' <<<"$page" || true; } |
        while IFS= read -r candidate; do
          candidate="0.${candidate#LFS_S3_}"
          candidate="${candidate%_setup.exe}"
          if [[ "$candidate" == "$public_family"* ]]; then
            printf 'LFS_S3_%s_setup.exe\n' "${candidate#0.}"
            break
          fi
        done
    )"
    if [[ -n "$public_installer" ]]; then
      public_build="${public_installer#LFS_S3_}"
      public_build="0.${public_build%_setup.exe}"
    fi
  fi
  expected_line="$LFS_INSTALLER_NAME"
  printf 'Audited target: %s (%s, %s)\n' "$LFS_VERSION" "$LFS_CHANNEL" "$expected_line"
  printf 'Website stable: %s (old graphics)\n' "${latest_stable:-unknown}"
  if [[ -n "$public_family" ]]; then
    printf 'Website test:   %s (new graphics public test; %s)\n' "${public_build:-$public_family}" "${public_installer:-installer unknown}"
  fi

  if [[ "$LFS_CHANNEL" == 'public-test' ]]; then
    if [[ "$public_build" == "$LFS_VERSION" && "$public_family" == "$LFS_PUBLIC_TEST_FAMILY" && "$page" == *"$expected_line"* ]]; then
      printf 'Status:         current public-test pin\n'
      return
    fi
    printf 'Status:         public-test update or drift detected; review bootstrap pins (recorded in-game updates remain launchable)\n'
    return 2
  fi

  if [[ "$latest_stable" == "$LFS_VERSION" && "$page" == *"$expected_line"* && -z "$public_build" ]]; then
    printf 'Status:         current stable pin\n'
    return
  fi
  if [[ "$latest_stable" == "$LFS_VERSION" && "$page" == *"$expected_line"* && -n "$public_build" ]]; then
    printf 'Status:         new-graphics public test available (%s); wrapper made no game-file changes\n' "$public_build"
    return 2
  fi
  printf 'Status:         stable-channel update or drift detected; wrapper made no game-file changes\n'
  return 2
}

verify_sources() {
  local unpack
  require_unprivileged
  require_command 7z
  require_command bsdtar
  require_command curl
  require_command du
  require_command find
  require_command gpgv
  require_command sha256sum
  require_command stat
  require_command timeout
  download_verified "official LFS $LFS_VERSION installer" "$LFS_INSTALLER_URL" "$INSTALLER" \
    "$LFS_INSTALLER_SIZE" "$LFS_INSTALLER_SHA256"
  download_verified "audited Arch Wine $WINE_RUNTIME_VERSION package" "$WINE_PACKAGE_URL" "$WINE_PACKAGE" \
    "$WINE_PACKAGE_SIZE" "$WINE_PACKAGE_SHA256"
  download_verified "Arch Wine $WINE_RUNTIME_VERSION package signature" "$WINE_PACKAGE_SIGNATURE_URL" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE_SIZE" "$WINE_PACKAGE_SIGNATURE_SHA256"
  verify_wine_package_signature
  download_verified 'DXVK archive' "$DXVK_ARCHIVE_URL" "$DXVK_ARCHIVE" \
    "$DXVK_ARCHIVE_SIZE" "$DXVK_ARCHIVE_SHA256"
  unpack="$(mktemp -d "$CACHE_DIR/.verify-payloads.XXXXXX")"
  ACTIVE_UNPACK="$unpack"
  trap cleanup_active_unpack EXIT
  mkdir -p "$unpack/lfs"
  extract_lfs_payload "$INSTALLER" "$unpack/lfs" "$unpack/lfs-extract.log"
  verify_extracted_game_tree "$unpack/lfs" 'verified-source LFS'
  rm -rf --one-file-system "$unpack/lfs"
  mkdir -p "$unpack/wine"
  extract_bsdtar_archive "$WINE_PACKAGE" "$unpack/wine" "Arch Wine $WINE_RUNTIME_VERSION package"
  verify_payload_manifest "verified-source Wine $WINE_RUNTIME_VERSION runtime" "$unpack/wine" "$WINE_RUNTIME_MANIFEST" \
    "$WINE_RUNTIME_MANIFEST_SIZE" "$WINE_RUNTIME_MANIFEST_SHA256" "$WINE_RUNTIME_MANIFEST_ENTRIES"
  rm -rf --one-file-system "$unpack/wine"
  mkdir -p "$unpack/dxvk"
  extract_bsdtar_archive "$DXVK_ARCHIVE" "$unpack/dxvk" 'DXVK archive'
  verify_file 'DXVK d3d11 x32 DLL' "$unpack/dxvk/dxvk-$DXVK_VERSION/x32/d3d11.dll" \
    "$DXVK_D3D11_X32_SIZE" "$DXVK_D3D11_X32_SHA256"
  verify_file 'DXVK dxgi x32 DLL' "$unpack/dxvk/dxvk-$DXVK_VERSION/x32/dxgi.dll" \
    "$DXVK_DXGI_X32_SIZE" "$DXVK_DXGI_X32_SHA256"
  rm -rf --one-file-system "$unpack"
  ACTIVE_UNPACK=''
  trap - EXIT
  note 'All pinned upstream archive bytes, signatures, complete official seed files, and extracted runtime manifests are verified'
}

purge_cache() {
  require_unprivileged
  rm -f "$INSTALLER" "$INSTALLER.part" "$WINE_PACKAGE" "$WINE_PACKAGE.part" \
    "$WINE_PACKAGE_SIGNATURE" "$WINE_PACKAGE_SIGNATURE.part" "$DXVK_ARCHIVE" "$DXVK_ARCHIVE.part"
  rm -rf "$CACHE_DIR/dxvk-shaders" "$CACHE_DIR"/.dxvk-unpack.* "$CACHE_DIR"/.verify-payloads.*
  note "Removed wrapper-managed cache: $CACHE_DIR"
}

remove_state() {
  local answer path name
  require_unprivileged
  require_command flock
  require_command stat
  [[ -d "$STATE_ROOT" ]] || { note 'No user installation exists'; return; }
  [[ -f "$STATE_SENTINEL" ]] || die 'state directory is not marked as managed; refusing removal'
  open_launch_lock
  flock -n 9 || die 'LFS is already launching, installing, or recovering'
  detect_wine 2>/dev/null || true
  if prefix_is_running; then
    die 'private Wine processes are running; run lfs-linux stop first'
  fi
  if [[ "${LFS_LINUX_CONFIRM_REMOVE:-0}" != '1' ]]; then
    [[ -t 0 ]] || die 'removal needs a terminal or LFS_LINUX_CONFIRM_REMOVE=1'
    printf 'Remove the complete Live for Speed Linux prefix and game-owned player data at %s? [y/N] ' "$STATE_ROOT"
    read -r answer
    [[ "$answer" == 'y' || "$answer" == 'Y' ]] || { note 'Removal cancelled'; return; }
  fi
  rm -rf --one-file-system "$PREFIX" "$RUNTIME_DIR"
  for path in "$STATE_ROOT"/game-update-*.manifest; do
    [[ -f "$path" || -L "$path" ]] || continue
    name="${path##*/}"
    [[ "$name" =~ ^game-update-[0-9a-f]{64}\.manifest$ ]] || continue
    rm -f -- "$path"
  done
  rm -f -- "$LEGACY_LOCAL_GAME_MANIFEST" "$INSTALL_MARKER" "$LAUNCH_SESSION" "$STATE_SENTINEL"
  rmdir -- "$STATE_ROOT" 2>/dev/null || warn 'kept unrecognized files in the state directory'
  note 'Removed user installation. Wrapper package remains installed.'
}

validate_paths

case "${1:-launch}" in
  desktop)
    # shellcheck source=libexec/lfs-linux-ui
    source "$(dirname "$CORE_EXECUTABLE")/lfs-linux-ui"
    ui_main "${2:-launch}"
    ;;
  desktop-state) desktop_state ;;
  support-report) support_report ;;
  setup) setup_interactive ;;
  install) install_all ;;
  launch) launch_game ;;
  recover-update) note 'LFS manages game updates. No wrapper recovery or rebaseline is needed. Open Live for Speed normally, or run lfs-linux launch.' ;;
  stop) stop_game ;;
  doctor) run_doctor ;;
  status) show_status ;;
  update-check) update_check ;;
  verify-sources) verify_sources ;;
  ready) ready_fast ;;
  remove) remove_state ;;
  purge-cache) purge_cache ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
