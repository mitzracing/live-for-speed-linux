#!/usr/bin/env bash
set -Eeuo pipefail

(( EUID != 0 )) || { printf 'Live for Speed Linux: do not launch as root\n' >&2; exit 1; }
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SELF_DIR
readonly LFS_COMMAND="${LFS_LINUX_COMMAND:-$SELF_DIR/lfs-linux}"
[[ -x "$LFS_COMMAND" ]] || { printf 'Live for Speed Linux: launcher is missing\n' >&2; exit 1; }
exec "$LFS_COMMAND" desktop "${1:-launch}"
