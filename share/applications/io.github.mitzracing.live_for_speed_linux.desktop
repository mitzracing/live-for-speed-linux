[Desktop Entry]
Type=Application
Name=Live for Speed Linux
GenericName=Racing Simulator Launcher
Comment=Install and play Live for Speed on Linux
Exec=lfs-linux-desktop launch
TryExec=lfs-linux-desktop
Icon=io.github.mitzracing.live_for_speed_linux
Terminal=false
StartupNotify=true
StartupWMClass=lfs.exe
Categories=Game;Simulation;SportsGame;
Keywords=game;games;racing;simulator;motorsport;driving;wine;LFS;
PrefersNonDefaultGPU=true
Actions=Install;Doctor;Help;

[Desktop Action Install]
Name=Install or Repair LFS
Exec=lfs-linux-desktop setup

[Desktop Action Doctor]
Name=Check Live for Speed Linux
Exec=lfs-linux-desktop doctor

[Desktop Action Help]
Name=Help and Diagnostic Report
Exec=lfs-linux-desktop help
