pkgname=live-for-speed-linux
pkgver=0.3.3
pkgrel=1
pkgdesc='Unofficial launcher for Live for Speed, a racing simulator game'
arch=('x86_64')
url='https://github.com/mitzracing/live-for-speed-linux'
license=('MIT' 'GPL-3.0-or-later')
provides=('lfs-linux' 'live-for-speed-launcher')
conflicts=('lfs-linux' 'live-for-speed-launcher')
replaces=('lfs-linux' 'live-for-speed-launcher')
depends=(
  '7zip'
  'bash'
  'coreutils'
  'curl'
  'desktop-file-utils'
  'findutils'
  'gawk'
  'grep'
  'gnupg'
  'libarchive'
  'libpulse'
  'sed'
  'tar'
  'util-linux'
  'vulkan-icd-loader'
  'vulkan-driver'
  'wine=11.15-1'
  'xdotool'
  'xterm'
)
optdepends=(
  'libnotify: desktop launch error notifications'
  'vulkan-tools: detailed Vulkan diagnostics'
  'wmctrl: focus an existing LFS window'
)
install=live-for-speed-linux.install
_source_name='live-for-speed-linux'
source=("$_source_name-$pkgver.tar.gz::$url/releases/download/v$pkgver/$_source_name-$pkgver.tar.gz")
sha256sums=('6cc0651bcbd97f510f16f03f6954fe4c1768e88556d60c6a858cdcc70938a833')

package() {
  cd "$srcdir/$_source_name-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
