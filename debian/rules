#!/usr/bin/make -f

export LC_ALL = C.UTF-8

%:
	dh $@

override_dh_auto_build:
	@:

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	LFS_LINUX_SOURCE_ARCHIVE=1 ./tests/test-public-static.sh
	shellcheck debian/tools/test-runtime-trust.sh debian/tests/installed-smoke debian/tests/root-rejection
	./tests/test-public-core.sh
	./debian/tools/test-runtime-trust.sh
	./tests/test-upgrade.sh
	python3 tests/test-support-static.py
	python3 tests/test-triage-feedback.py
	python3 tests/test-upstream-drift.py
	python3 debian/tools/test-audit-wine-runtime.py
	python3 -c 'import ast, pathlib; [ast.parse(path.read_text()) for path in pathlib.Path("debian/tools").glob("*.py")]'
else
	@echo 'Skipping tests because DEB_BUILD_OPTIONS contains nocheck'
endif

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr
	rm -rf debian/live-for-speed-linux/usr/share/licenses

override_dh_builddeb:
	python3 debian/tools/check-built-package.py debian/live-for-speed-linux
	dh_builddeb

override_dh_auto_clean:
	rm -rf artifacts/pkgroot
	find scripts tests debian/tools -type d -name __pycache__ -prune -exec rm -rf '{}' +
	find scripts tests debian/tools -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
