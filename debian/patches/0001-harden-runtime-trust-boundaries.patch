+archive_member_listing_is_safe() {
+  local listing="$1" normalized duplicate
+  normalized="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-archive-paths.XXXXXX")"
+  if ! LC_ALL=C awk '
+    function reject(reason, path) {
+      printf "%s: %s\n", reason, path > "/dev/stderr"
+      bad = 1
+    }
+    {
+      path = $0
+      sub(/\r$/, "", path)
+      if (path == "." || path == "./") next
+      if (path == "" || path ~ /[[:cntrl:]]/) {
+        reject("empty or control-character archive member", path)
+        next
+      }
+      gsub(/\\/, "/", path)
+      if (path ~ /^\// || path ~ /^[[:alpha:]]:/) {
+        reject("absolute archive member", path)
+        next
+      }
+      count = split(path, part, "/")
+      output = ""
+      unsafe = 0
+      for (i = 1; i <= count; i++) {
+        if (part[i] == "" || part[i] == ".") continue
+        if (part[i] == "..") {
+          reject("parent traversal archive member", path)
+          unsafe = 1
+          break
+        }
+        output = output (output == "" ? "" : "/") part[i]
+      }
+      if (!unsafe && output != "") print output
+    }
+    END { if (bad) exit 1 }
+  ' "$listing" >"$normalized"; then
+    rm -f "$normalized"
+    return 1
+  fi
+  if [[ ! -s "$normalized" ]]; then
+    printf 'archive contains no file paths\n' >&2
+    rm -f "$normalized"
+    return 1
+  fi
+  duplicate="$(awk 'seen[$0]++ { print; exit }' "$normalized")"
+  rm -f "$normalized"
+  if [[ -n "$duplicate" ]]; then
+    printf 'duplicate archive member: %s\n' "$duplicate" >&2
+    return 1
+  fi
+}
+
+bsdtar_entry_types_are_safe() {
+  local verbose_listing="$1"
+  LC_ALL=C awk '
+    function contained_link(path, target, base, combined, count, i, depth, part) {
+      if (target == "" || target ~ /[[:cntrl:]]/) return 0
+      gsub(/\\/, "/", target)
+      if (target ~ /^\// || target ~ /^[[:alpha:]]:/) return 0
+      base = path
+      if (base ~ /\//) sub(/\/[^/]*$/, "", base); else base = ""
+      combined = (base == "" ? target : base "/" target)
+      count = split(combined, part, "/")
+      depth = 0
+      for (i = 1; i <= count; i++) {
+        if (part[i] == "" || part[i] == ".") continue
+        if (part[i] == "..") {
+          if (depth == 0) return 0
+          depth--
+        } else {
+          depth++
+        }
+      }
+      return 1
+    }
+    {
+      type = substr($0, 1, 1)
+      if (type != "-" && type != "d" && type != "l") {
+        printf "unsupported archive entry type: %s\n", $0 > "/dev/stderr"
+        bad = 1
+        next
+      }
+      if (type != "l") next
+      rest = $0
+      malformed = 0
+      for (field = 1; field <= 8; field++) {
+        if (rest !~ /^[^[:space:]]+[[:space:]]+/) {
+          printf "malformed symbolic-link listing: %s\n", $0 > "/dev/stderr"
+          bad = 1
+          malformed = 1
+          break
+        }
+        sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
+      }
+      if (malformed) next
+      pieces = split(rest, link, / -> /)
+      if (pieces != 2 || !contained_link(link[1], link[2])) {
+        printf "unsafe symbolic link in archive: %s\n", rest > "/dev/stderr"
+        bad = 1
+      }
+    }
+    END { if (bad) exit 1 }
+  ' "$verbose_listing"
+}
+
+preflight_bsdtar_archive() {
+  local archive="$1" label="$2" listing verbose_listing
+  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-list.XXXXXX")"
+  verbose_listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-bsdtar-verbose.XXXXXX")"
+  if ! LC_ALL=C bsdtar -tf "$archive" >"$listing" 2>/dev/null ||
+     ! archive_member_listing_is_safe "$listing" ||
+     ! LC_ALL=C bsdtar -tvf "$archive" >"$verbose_listing" 2>/dev/null ||
+     ! bsdtar_entry_types_are_safe "$verbose_listing"; then
+    rm -f "$listing" "$verbose_listing"
+    die "$label has unsafe or unreadable archive members"
+  fi
+  rm -f "$listing" "$verbose_listing"
+}
+
+preflight_7z_archive() {
+  local archive="$1" label="$2" details listing
+  details="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-details.XXXXXX")"
+  listing="$(mktemp "${TMPDIR:-/tmp}/lfs-linux-7z-list.XXXXXX")"
+  if ! LC_ALL=C 7z l -slt -- "$archive" >"$details" 2>/dev/null; then
+    rm -f "$details" "$listing"
+    die "$label archive listing failed"
+  fi
+  if grep -Eq '^(Symbolic Link|Hard Link) = ' "$details" ||
+     ! awk '
+       /^----------$/ { entries = 1; next }
+       !entries { next }
+       /^$/ { next }
+       /^Path = / { print substr($0, 8); paths++; next }
+       /^[^=]+ = / { next }
+       /^(Warnings|Errors): [0-9]+$/ { next }
+       { malformed = 1 }
+       END { if (!paths || malformed) exit 1 }
+     ' "$details" >"$listing" ||
+     ! archive_member_listing_is_safe "$listing"; then
+    rm -f "$details" "$listing"
+    die "$label has unsafe, duplicate, linked, or unreadable archive members"
+  fi
+  rm -f "$details" "$listing"
+}
+
+extract_bsdtar_archive() {
+  local archive="$1" destination="$2" label="$3" existing
+  preflight_bsdtar_archive "$archive" "$label"
+  [[ -d "$destination" ]] || die "$label extraction destination is missing"
+  if ! existing="$(find "$destination" -mindepth 1 -print -quit)"; then
+    die "$label extraction destination inspection failed"
+  fi
+  [[ -z "$existing" ]] || die "$label extraction destination is not empty"
+  bsdtar -xkf "$archive" -C "$destination" || die "$label extraction failed"
+}
